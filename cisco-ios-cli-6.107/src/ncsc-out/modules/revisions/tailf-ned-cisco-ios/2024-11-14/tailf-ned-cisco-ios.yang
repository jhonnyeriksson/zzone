                      tailf:info
                        "VPN Routing/Forwarding Instance";
                      tailf:cli-diff-set-after "/ios:ip/vrf" {
                        tailf:xpath-root 3;
                        tailf:cli-when-target-set;
                      }
                      tailf:cli-diff-delete-before "/ios:ip/vrf" {
                        tailf:xpath-root 3;
                        tailf:cli-when-target-delete;
                      }
                      tailf:cli-diff-set-after "/ios:vrf/definition" {
                        tailf:xpath-root 3;
                        tailf:cli-when-target-set;
                      }
                      tailf:cli-diff-delete-before "/ios:vrf/definition" {
                        tailf:xpath-root 3;
                        tailf:cli-when-target-delete;
                      }
                      type string {
                        tailf:info
                          "WORD;;VPN Routing/Forwarding Instance (VRF) name";
                      }
                    }
                    uses router-bgp-redistribute-ospf-grouping;
                  }
                  container rip {
                    tailf:info
                      "Routing Information Protocol (RIP)";
                    tailf:cli-compact-syntax;
                    tailf:cli-delete-when-empty;
                    presence "true";
                    uses router-bgp-redistribute-grouping;
                    list rip-list {
                      tailf:cli-drop-node-name;
                      tailf:cli-suppress-mode;
                      tailf:cli-delete-when-empty;
                      tailf:cli-incomplete-command;
                      key "id";
                      leaf id {
                        tailf:cli-suppress-range;
                        tailf:cli-disallow-value "metric|subnets|route-map|include-connected";
                        type string {
                          tailf:info
                            "WORD;;User selected string identifying this process";
                        }
                      }
                      uses router-bgp-redistribute-grouping;
                    }
                  }
                  container lisp {
                    tailf:info
                      "Locator ID Separation Protocol (LISP)";
                    tailf:cli-compact-syntax;
                    tailf:cli-delete-when-empty;
                    presence "true";
                    uses router-bgp-redistribute-grouping;
                  }
                }
                container snmp {
                  tailf:info
                    "Modify snmp parameters";
                  list context {
                    tailf:info
                      "Configure a SNMP context";
                    tailf:cli-suppress-mode;
                    tailf:cli-delete-when-empty;
                    max-elements 1;
                    key "name";
                    leaf name {
                      type string {
                        tailf:info
                          "WORD;;Context Name";
                      }
                    }
                  }
                }
                container neighbor-tag {
                  tailf:cli-drop-node-name;
                  list neighbor {
                    tailf:info
                      "Specify a neighbor router";
                    tailf:cli-suppress-mode;
                    tailf:cli-delete-when-empty;
                    tailf:cli-incomplete-command;
                    key "id";
                    leaf id {
                      cli:parse-disallow-type "inet:ip-address";
                      cli:parse-disallow-type "ios:ios-ipv6-address";
                      type string {
                        tailf:info
                          "WORD;;Neighbor tag";
                      }
                    }
                    leaf peer-group {
                      tailf:info
                        "Configure peer-group";
                      tailf:cli-delete-container-on-delete;
                      tailf:cli-full-command;
                      type empty;
                    }
                    uses router-bgp-neighbor-grouping;
                  }
                }
                list neighbor {
                  tailf:info
                    "Specify a neighbor router";
                  tailf:cli-suppress-mode;
                  tailf:cli-delete-when-empty;
                  tailf:cli-incomplete-command;
                  key "id";
                  leaf id {
                    tailf:cli-diff-set-after "../../neighbor-tag/neighbor" {
                      tailf:xpath-root 3;
                      tailf:cli-when-target-set;
                    }
                    tailf:cli-diff-delete-before "../../neighbor-tag/neighbor" {
                      tailf:xpath-root 3;
                      tailf:cli-when-target-delete;
                    }
                    type union {
                      type inet:ipv4-address {
                        tailf:info
                          "A.B.C.D;;Neighbor address";
                      }
                      type inet:ipv6-address {
                        tailf:info
                          "X:X:X:X::X;;Neighbor IPv6 address";
                      }
                      type ios-ipv6-address;
                    }
                  }
                  leaf peer-group {
                    tailf:info
                      "Member of the peer-group";
                    tailf:cli-delete-container-on-delete;
                    tailf:cli-full-command;
                    tailf:cli-diff-set-after "../remote-as" {
                      tailf:xpath-root 3;
                    }
                    tailf:cli-suppress-leafref-in-diff;
                    tailf:non-strict-leafref {
                      path "/ncs:devices/ncs:device/ncs:config/ios:router/bgp/neighbor-tag/neighbor/id" {
                        tailf:xpath-root 3;
                      }
                    }
                    type string {
                      tailf:info
                        "WORD;;peer-group name";
                    }
                  }
                  uses router-bgp-neighbor-grouping;
                  tailf:cli-diff-set-after "../../../../../../../ip/vrf/rd" {
                    tailf:xpath-root 3;
                    tailf:cli-when-target-set;
                  }
                  tailf:cli-diff-delete-before "../../../../../../../ip/vrf/rd" {
                    tailf:xpath-root 3;
                    tailf:cli-when-target-delete;
                  }
                  tailf:cli-remove-before-change;
                }
                container maximum-paths {
                  tailf:info
                    "Forward packets over multiple paths";
                  uses router-bgp-max-path-grouping;
                  container eibgp {
                    tailf:info
                      "Both eBGP and iBGP paths as multipath";
                    uses router-bgp-max-path-grouping;
                  }
                  container ibgp {
                    tailf:info
                      "iBGP-multipath";
                    choice ibgp-choice {
                      default "b";
                      case a {
                        container unequal-cost {
                          tailf:info
                            "Perform Un-Equal cost multipath selection";
                          uses router-bgp-max-path-grouping;
                        }
                      }
                      case b {
                        uses router-bgp-max-path-grouping;
                      }
                    }
                  }
                  leaf import {
                    tailf:info
                      "Maximum import paths";
                    type uint16 {
                      tailf:info
                        "<1-32>;;Number of import paths";
                      range "1..32";
                    }
                  }
                }
                container maximum-secondary-paths {
                  tailf:info
                    "Maximum secondary paths";
                  leaf paths {
                    tailf:cli-drop-node-name;
                    tailf:cli-full-command;
                    tailf:cli-diff-set-after "../eibgp" {
                      tailf:xpath-root 3;
                      tailf:cli-when-target-delete;
                    }
                    type uint8 {
                      tailf:info
                        "<0-32>;;Number of secondary paths";
                      range "0..32";
                    }
                  }
                  leaf eibgp {
                    tailf:info
                      "Both eBGP and iBGP paths as secondary multipath";
                    type uint8 {
                      tailf:info
                        "<0-32>;;Number of secondary paths";
                      range "0..32";
                    }
                  }
                  leaf ibgp {
                    tailf:info
                      "iBGP-secondary-multipath";
                    type uint8 {
                      tailf:info
                        "<0-32>;;Number of secondary paths";
                      range "0..32";
                    }
                  }
                }
                container import {
                  tailf:info
                    "Configure path import";
                  container l2vpn {
                    tailf:info
                      "Import from l2vpn Address family";
                    container evpn {
                      tailf:info
                        "Import from l2vpn evpn Address family";
                      tailf:cli-compact-syntax;
                      tailf:cli-sequence-commands {
                        tailf:cli-reset-siblings;
                      }
                      tailf:cli-delete-when-empty;
                      presence "true";
                      leaf re-originate {
                        tailf:info
                          "imported path with RT re-originate";
                        type empty;
                      }
                      leaf stitching-rt {
                        tailf:info
                          "imported path with RT re-originate with import stitching route-target";
                        type empty;
                      }
                    }
                  }
                  container vpnv4 {
                    tailf:info
                      "Import from vpnv4 Address family";
                    container unicast {
                      tailf:info
                        "Import prefixes from vpn unicast table";
                      tailf:cli-reset-container;
                      tailf:cli-delete-when-empty;
                      presence "true";
                      leaf re-originate {
                        tailf:info
                          "imported path with RT re-originate";
                        type empty;
                      }
                    }
                  }
                  container path {
                    tailf:info
                      "Path selection and path limit";
                    container selection {
                      tailf:info
                        "Path selection policy";
                      choice selection-choice {
                        leaf all {
                          tailf:info
                            "Import all available paths";
                          type empty;
                        }
                        container bestpath {
                          tailf:info
                            "Import the best available path.";
                          tailf:cli-delete-when-empty;
                          presence "true";
                          leaf strict {
                            tailf:info
                              "Do not fallback to best available path";
                            type empty;
                          }
                        }
                        container multipaths {
                          tailf:info
                            "Import all multipaths.";
                          tailf:cli-delete-when-empty;
                          presence "true";
                          leaf strict {
                            tailf:info
                              "Do not fallback to best available path";
                            type empty;
                          }
                        }
                      }
                    }
                    leaf limit {
                      tailf:info
                        "Per net imported path limit";
                      type uint8 {
                        tailf:info
                          "<2-255>;;Maximum number of paths that can be imported into a net";
                        range "2..255";
                      }
                    }
                  }
                }
                container default-information {
                  tailf:info
                    "Control distribution of default information";
                  leaf originate {
                    tailf:info
                      "Distribute a default route";
                    type empty;
                  }
                }
                leaf default-metric {
                  tailf:info
                    "Set metric of redistributed routes";
                  tailf:cli-full-command;
                  type uint32 {
                    tailf:info
                      "<1-4294967295>;;Default metric";
                    range "1..4294967295";
                  }
                }
                // NCS expand uses statement
                list distribute-list {
                  tailf:info
                    "Filter networks in routing updates";
                  tailf:cli-suppress-mode;
                  tailf:cli-delete-when-empty;
                  tailf:cli-compact-syntax;
                  tailf:cli-sequence-commands;
                  tailf:cli-remove-before-change;
                  key "direction";
                  leaf direction {
                    tailf:cli-diff-set-after "../../distribute-list-interface/distribute-list" {
                      tailf:xpath-root 3;
                      tailf:cli-when-target-delete;
                    }
                    tailf:cli-full-command;
                    type enumeration {
                      enum "in" {
                        tailf:info
                          "Filter incoming routing updates";
                      }
                      enum "out" {
                        tailf:info
                          "Filter outgoing routing updates";
                      }
                    }
                  }
                  uses distribute-list-content-grouping;
                }
                container distribute-list-interface {
                  tailf:cli-drop-node-name;
                  list distribute-list {
                    tailf:info
                      "Filter networks in routing updates";
                    tailf:cli-suppress-mode;
                    tailf:cli-delete-when-empty;
                    tailf:cli-compact-syntax;
                    tailf:cli-sequence-commands;
                    tailf:cli-remove-before-change;
                    key "direction interface";
                    leaf direction {
                      type enumeration {
                        enum "in" {
                          tailf:info
                            "Filter incoming routing updates";
                        }
                        enum "out" {
                          tailf:info
                            "Filter outgoing routing updates";
                        }
                      }
                    }
                    leaf interface {
                      tailf:cli-diff-set-after "/ios:interface" {
                        tailf:xpath-root 3;
                        tailf:cli-when-target-set;
                      }
                      tailf:cli-diff-delete-before "/ios:interface" {
                        tailf:xpath-root 3;
                        tailf:cli-when-target-delete;
                      }
                      type string {
                        tailf:info
                          "WORD;;Interface name";
                      }
                    }
                    uses distribute-list-content-grouping;
                  }
                }
                container distance {
                  tailf:info
                    "Define an administrative distance";
                  container bgp {
                    tailf:info
                      "BGP distance";
                    tailf:cli-compact-syntax;
                    tailf:cli-sequence-commands;
                    leaf extern-as {
                      tailf:cli-drop-node-name;
                      tailf:cli-incomplete-command;
                      type uint16 {
                        tailf:info
                          "<1-255>;;Distance for routes external to the AS";
                        range "1..255";
                      }
                    }
                    leaf internal-as {
                      tailf:cli-drop-node-name;
                      tailf:cli-incomplete-command;
                      type uint16 {
                        tailf:info
                          "<1-255>;;Distance for routes internal to the AS";
                        range "1..255";
                      }
                    }
                    leaf local {
                      tailf:cli-drop-node-name;
                      type uint16 {
                        tailf:info
                          "<1-255>;;Distance for local routes";
                        range "1..255";
                      }
                    }
                  }
                  list adm-distance {
                    tailf:cli-drop-node-name;
                    tailf:cli-suppress-mode;
                    tailf:cli-delete-when-empty;
                    key "srcip wildbits";
                    leaf distance {
                      tailf:cli-drop-node-name;
                      tailf:cli-prefix-key;
                      type uint16 {
                        tailf:info
                          "<1-255>;;Administrative distance";
                        range "1..255";
                      }
                    }
                    leaf srcip {
                      type inet:ipv4-address {
                        tailf:info
                          "A.B.C.D;;IP Source address";
                      }
                    }
                    leaf wildbits {
                      type inet:ipv4-address {
                        tailf:info
                          "A.B.C.D;;Wildcard bits";
                      }
                    }
                    leaf access-list {
                      tailf:cli-drop-node-name;
                      type std-ip-acl-type;
                    }
                  }
                }
                leaf auto-summary {
                  tailf:info
                    "Enable automatic network number summarization";
                  tailf:cli-boolean-no;
                  tailf:cli-full-command;
                  type boolean;
                }
                uses router-bgp-af-ipvx-vrf-advertise-l2vpn-grouping;
              }
            }
          }
          container ipv6-with-vrf {
            tailf:cli-drop-node-name;
            list ipv6 {
              tailf:info
                "Address family";
              tailf:cli-suppress-mode;
              tailf:cli-delete-when-empty;
              tailf:cli-incomplete-command;
              tailf:cli-incomplete-no;
              key "af";
              leaf af {
                type enumeration {
                  enum "unicast" {
                    tailf:info
                      "Address Family modifier";
                  }
                  enum "multicast" {
                    tailf:info
                      "Address Family modifier";
                  }
                  enum "flowspec" {
                    tailf:info
                      "Address Family modifier";
                  }
                }
                tailf:key-default "unicast";
              }
              list vrf {
                tailf:cli-mode-name "config-router-af";
                tailf:cli-delete-when-empty;
                tailf:cli-full-command;
                tailf:cli-exit-command "exit-address-family" {
                  tailf:info
                    "Exit from Address Family configuration mode";
                }
                key "name";
                leaf name {
                  tailf:cli-diff-set-after "../../../../../../../vrf/definition" {
                    tailf:xpath-root 3;
                    tailf:cli-when-target-set;
                  }
                  tailf:cli-diff-delete-before "../../../../../../../vrf/definition" {
                    tailf:xpath-root 3;
                    tailf:cli-when-target-delete;
                  }
                  tailf:cli-diff-set-after "../../../../../../../vrf/definition/address-family/ipv6" {
                    tailf:xpath-root 3;
                    tailf:cli-when-target-set;
                  }
                  tailf:cli-diff-delete-before "../../../../../../../vrf/definition/address-family/ipv6" {
                    tailf:xpath-root 3;
                    tailf:cli-when-target-delete;
                  }
                  tailf:cli-diff-set-after "../../../../../../../ip/vrf" {
                    tailf:xpath-root 3;
                    tailf:cli-when-target-set;
                  }
                  tailf:cli-diff-delete-before "../../../../../../../ip/vrf" {
                    tailf:xpath-root 3;
                    tailf:cli-when-target-delete;
                  }
                  type string {
                    tailf:info
                      "WORD;;VPN Routing/Forwarding instance name";
                  }
                }
                uses router-bgp-bgp-grouping;
                // NCS expand uses statement
                container segment-routing-srv6 {
                  tailf:cli-drop-node-name;
                  container segment-routing {
                    tailf:info
                      "BGP Segment Routing Config";
                    container srv6 {
                      tailf:info
                        "BGP Segment Routing SRv6 Config";
                      tailf:cli-add-mode;
                      tailf:cli-mode-name "config-router-srv6";
                      tailf:cli-exit-command "exit-srv6" {
                        tailf:info
                          "Exit SRv6 Mode";
                      }
                      presence "true";
                      leaf locator {
                        tailf:info
                          "SRv6 Locator";
                        tailf:non-strict-leafref {
                          path "/ncs:devices/ncs:device/ncs:config/ios:segment-routing/srv6/locators/locator/name" {
                            tailf:xpath-root 3;
                          }
                        }
                        type string {
                          tailf:info
                            "WORD;;srv6 locator";
                        }
                      }
                      container alloc-mode {
                        tailf:info
                          "SRv6 SID Alloc Mode";
                        leaf per-vrf {
                          tailf:info
                            "Per Vrf SRv6 SID Alloc Mode";
                          type empty;
                        }
                      }
                    }
                  }
                }
                leaf synchronization {
                  tailf:info
                    "Perform IGP synchronization";
                  tailf:cli-full-command;
                  type empty;
                }
                choice table-map-choice {
                  leaf table-map {
                    tailf:info
                      "Map external entry attributes into routing table";
                    tailf:cli-full-command;
                    type string {
                      tailf:info
                        "WORD;;route-map name";
                    }
                  }
                  container table-map-filter {
                    tailf:cli-drop-node-name;
                    tailf:cli-compact-syntax;
                    tailf:cli-sequence-commands;
                    leaf table-map {
                      tailf:info
                        "Map external entry attributes into routing table";
                      tailf:cli-incomplete-command;
                      type string {
                        tailf:info
                          "WORD;;route-map name";
                      }
                    }
                    leaf filter {
                      tailf:info
                        "Selective route download";
                      type empty;
                    }
                  }
                }
                container bgp-af {
                  tailf:cli-drop-node-name;
                  container bgp {
                    tailf:info
                      "BGP specific commands";
                    leaf redistribute-internal {
                      tailf:info
                        "Allow redistribution of iBGP into IGPs (dangerous)";
                      tailf:cli-full-command;
                      type empty;
                    }
                    container dampening {
                      tailf:info
                        "Enable route-flap dampening";
                      presence "true";
                      choice dampening-choice {
                        leaf route-map {
                          tailf:info
                            "Route-map to specify criteria for dampening";
                          type string {
                            tailf:info
                              "WORD;;route-map name";
                          }
                        }
                        container dampen {
                          tailf:cli-drop-node-name;
                          tailf:cli-compact-syntax;
                          tailf:cli-sequence-commands;
                          leaf half-life-time {
                            tailf:cli-drop-node-name;
                            type uint8 {
                              tailf:info
                                "<1-45>;;Half-life time for the penalty";
                              range "1..45";
                            }
                          }
                          leaf reuse-time {
                            tailf:cli-drop-node-name;
                            tailf:cli-incomplete-command;
                            type uint16 {
                              tailf:info
                                "<1-20000>;;Value to start reusing a route";
                              range "1..20000";
                            }
                          }
                          leaf suppress-time {
                            tailf:cli-drop-node-name;
                            tailf:cli-incomplete-command;
                            type uint16 {
                              tailf:info
                                "<1-20000>;;Value to start suppressing a route";
                              range "1..20000";
                            }
                          }
                          leaf max-suppress-time {
                            tailf:cli-drop-node-name;
                            type uint8 {
                              tailf:info
                                "<1-255>;;Maximum duration to suppress a stable route";
                              range "1..255";
                            }
                          }
                        }
                      }
                    }
                    container additional-paths {
                      tailf:info
                        "Additional paths in the BGP table";
                      container select {
                        tailf:info
                          "Selection criteria to pick the paths";
