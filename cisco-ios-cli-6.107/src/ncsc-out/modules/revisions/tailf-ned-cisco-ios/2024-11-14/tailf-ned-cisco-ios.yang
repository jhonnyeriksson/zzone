                  type union {
                    type inet:host {
                      tailf:info
                        "A.B.C.D/X:X:X:X::X;;Local IPv6/IP address";
                    }
                    type enumeration {
                      enum "any" {
                        tailf:info
                          "Local address any";
                      }
                    }
                  }
                }
                leaf local-ip-af {
                  when "../local-ip = 'any'" {
