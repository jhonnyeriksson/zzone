          container dns {
            tailf:info
              "Configure DNS server";
            leaf view-group {
              tailf:info
                "Configure a DNS view-list for use on this interface";
              tailf:non-strict-leafref {
                path "/ncs:devices/ncs:device/ncs:config/ios:ip/dns/view-list/name" {
                  tailf:xpath-root 3;
                }
              }
              type string {
                tailf:info
                  "WORD;;View-list name";
              }
            }
          }
          container ddns {
            tailf:info
              "Configure dynamic DNS";
            container update {
              tailf:info
                "Configure dynamic DNS update";
              leaf hostname {
                tailf:info
                  "Dynamic DNS update hostname";
                type string {
                  tailf:info
                    "WORD;;Host name";
                }
              }
              list list {
                tailf:cli-drop-node-name;
                tailf:cli-suppress-mode;
                tailf:cli-delete-when-empty;
                key "name";
                leaf name {
                  tailf:non-strict-leafref {
                    path "/ncs:devices/ncs:device/ncs:config/ios:ip/ddns/update/method/name" {
                      tailf:xpath-root 3;
                    }
                  }
                  tailf:cli-disallow-value "hostname";
                  type string {
                    tailf:info
                      "WORD;;Method name";
                  }
                }
                leaf host-group {
                  tailf:info
                    "Dynamic DNS update destination host list";
                  tailf:non-strict-leafref {
                    path "/ncs:devices/ncs:device/ncs:config/ios:ip/host-list/name" {
                      tailf:xpath-root 3;
                    }
                  }
                  type string {
                    tailf:info
                      "WORD;;Host list name";
                  }
                }
              }
            }
          }
          container dhcp {
            tailf:info
              "Configure DHCP parameters for this interface";
            container client {
              tailf:info
                "DHCP client configuration";
              container update {
                tailf:info
                  "Dynamically update information";
                container dns {
                  tailf:info
                    "Dynamic DNS update configuration";
                  presence "true";
                  tailf:cli-delete-when-empty;
                  tailf:cli-reset-container;
                  leaf server {
                    tailf:info
                      "Dynamic DNS updates requested of server";
                    type enumeration {
                      enum "both" {
                        tailf:info
                          "Server updates both (A and PTR) records";
                      }
                      enum "none" {
                        tailf:info
                          "Ask server to perform no updates";
                      }
                    }
                  }
                }
              }
              container request {
                tailf:info
                  "Specify options (not) to request";
                leaf domain-name {
                  tailf:info
                    "Domain name (15)";
                  tailf:cli-boolean-no;
                  type boolean;
                  default "true";
                }
              }
              container client-id {
                tailf:info
                  "Specify Client-ID to use";
                choice client-id-choice {
                  leaf ascii {
                    tailf:info
                      "Ascii Client-ID string";
                    type string {
                      tailf:info
                        "WORD;;Client-ID string";
                    }
                  }
                  case interface {
                    uses interface-name-grouping;
                  }
                }
              }
              leaf hostname {
                tailf:info
                  "Specify hostname to use";
                type string {
                  tailf:info
                    "WORD;;Hostname string";
                }
              }
              container lease {
                tailf:info
                  "Requested address lease time";
                tailf:cli-compact-syntax;
                tailf:cli-sequence-commands {
                  tailf:cli-reset-siblings;
                }
                leaf days {
                  tailf:cli-drop-node-name;
                  type uint16 {
                    tailf:info
                      "<0-365>;;Days";
                    range "0..365";
                  }
