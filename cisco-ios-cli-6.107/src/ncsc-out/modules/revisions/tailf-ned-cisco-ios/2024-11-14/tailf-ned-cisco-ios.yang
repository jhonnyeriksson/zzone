            tailf:cli-when-target-delete;
          }
          list input {
            tailf:info
              "service policy input";
            tailf:cli-suppress-mode;
            tailf:cli-delete-when-empty;
            max-elements 1;
            key "name";
            leaf name {
              // NCS drop tailf-common:non-strict-leafref statement
              type string {
                tailf:info
                  "WORD;;input Policy-map name";
              }
            }
          }
          list output {
            tailf:info
              "service policy output";
            tailf:cli-suppress-mode;
            tailf:cli-delete-when-empty;
            max-elements 1;
            key "name";
            leaf name {
              // NCS drop tailf-common:non-strict-leafref statement
              type string {
                tailf:info
                  "WORD;;output Policy-map name";
              }
            }
          }
        }
        container xconnect {
          tailf:cli-add-mode;
          tailf:cli-mode-name "cfg-if-ether-vc-xconn";
          tailf:cli-compact-syntax;
          tailf:cli-sequence-commands;
          tailf:cli-delete-when-empty;
          tailf:cli-incomplete-command;
          tailf:cli-diff-set-after "../encapsulation" {
            tailf:xpath-root 3;
            tailf:cli-when-target-set;
          }
          tailf:cli-diff-delete-before "../encapsulation" {
            tailf:xpath-root 3;
            tailf:cli-when-target-delete;
          }
          tailf:cli-diff-delete-before "../bridge-domain" {
            tailf:xpath-root 3;
          }
          tailf:cli-diff-delete-before "/ios:l2/vfi/neighbor-vfi/neighbor" {
            tailf:xpath-root 3;
          }
          ios:trim-bad-nso-delete;
          presence "true";
          leaf address {
            tailf:cli-drop-node-name;
            tailf:cli-incomplete-command;
            tailf:cli-hide-in-submode;
            type inet:ipv4-address {
              tailf:info
                "A.B.C.D;;IP address of peer";
            }
          }
          leaf vcid {
            tailf:cli-drop-node-name;
            tailf:cli-incomplete-command;
            tailf:cli-hide-in-submode;
            type uint32 {
              tailf:info
                "<1-4294967295>;;Enter VC ID value";
