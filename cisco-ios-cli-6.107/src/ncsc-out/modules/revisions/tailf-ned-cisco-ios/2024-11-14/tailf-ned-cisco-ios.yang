  grouping ncs_template_router-lisp-af-grouping {
    leaf map-resolver {
      type empty;
    }
    container map-resolver-conf {
      tailf:cli-drop-node-name;
      container map-resolver {
        container map-request {
          container validate {
            container source {
              leaf registered {
                type empty;
              }
              container list {
                choice list-choice {
                  leaf ipv4 {
                    type string;
                  }
                  leaf ipv6 {
                    type string;
                  }
