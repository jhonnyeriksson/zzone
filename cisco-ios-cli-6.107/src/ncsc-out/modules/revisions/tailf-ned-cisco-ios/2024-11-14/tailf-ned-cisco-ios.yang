              tailf:info
                "Cisco IP Phone";
              type empty;
            }
          }
          choice trust-choice {
            container cos {
              tailf:info
                "Classify by packet COS";
              tailf:cli-reset-container;
              tailf:cli-delete-when-empty;
              tailf:cli-diff-set-after "../../vlan-based" {
                tailf:xpath-root 3;
                tailf:cli-when-target-delete;
              }
              presence "true";
              container pass-through {
                tailf:info
                  "cos pass-through mode";
                leaf dscp {
                  tailf:info
                    "transmit without dscp modification";
                  type empty;
                }
              }
            }
            container dscp {
              tailf:info
                "Classify by packet DSCP";
              tailf:cli-diff-set-after "../../vlan-based" {
                tailf:xpath-root 3;
                tailf:cli-when-target-delete;
              }
              presence "true";
              container pass-through {
                tailf:info
                  "dscp pass-through mode";
                leaf cos {
                  tailf:info
                    "transmit without cos modification";
                  type empty;
                }
              }
            }
            container ip-precedence {
              tailf:info
                "Classify by packet IP precedence";
              tailf:cli-diff-set-after "../../vlan-based" {
                tailf:xpath-root 3;
                tailf:cli-when-target-delete;
              }
              presence "true";
            }
          }
        }
        container monitor {
          tailf:info
