            }
            enum "2m" {
              tailf:info
                "2.048MHz Signal Mode";
            }
            enum "t1" {
              tailf:info
                "T1 Signal Mode";
            }
          }
        }
        leaf frame-mode {
          tailf:cli-drop-node-name;
          type enumeration {
            enum "d4" {
              tailf:info
                "D4 Super Frame Signal Mode";
            }
            enum "esf" {
              tailf:info
                "Extended Super Frame Signal Mode";
            }
            enum "sf" {
              tailf:info
                "Super Frame Signal Mode";
            }
          }
        }
        leaf linecode {
          tailf:info
            "Linecode option";
          type enumeration {
            enum "ami" {
              tailf:info
                "Linecode ami";
            }
            enum "b8zs" {
              tailf:info
                "Linecode b8zs";
            }
            enum "hdb3" {
              tailf:info
                "linecode hdb3";
            }
          }
        }
        leaf line-build-out {
          tailf:info
