              tailf:cli-when-target-set;
            }
            tailf:cli-diff-delete-before "/ios:vlan/vlan-list" {
              tailf:xpath-root 3;
              tailf:cli-when-target-delete;
            }
            tailf:cli-diff-set-after "/ios:bridge-domain/bridge-domain-list" {
