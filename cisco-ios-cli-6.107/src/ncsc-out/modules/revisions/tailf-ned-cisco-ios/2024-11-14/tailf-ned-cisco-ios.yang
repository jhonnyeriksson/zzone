                        leaf all {
                          tailf:info
                            "Select all available paths";
                          type empty;
                        }
                        leaf group-best {
                          tailf:info
                            "Select group-best path";
                          type empty;
                        }
                        leaf best {
                          tailf:info
                            "Select best N paths";
                          type uint8 {
                            tailf:info
                              "<2-3>;;Number of best paths in additional paths to be selected";
                            range "2..3";
                          }
