            tailf:cli-suppress-mode;
            tailf:cli-delete-when-empty;
            key "as-number";
            leaf as-number {
              type uint16 {
                tailf:info
                  "<1-65535>;;AS number";
                range "1..65535";
              }
            }
          }
        }
      }
