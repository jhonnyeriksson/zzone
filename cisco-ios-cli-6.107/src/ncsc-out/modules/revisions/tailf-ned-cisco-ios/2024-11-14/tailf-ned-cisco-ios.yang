            type uint16 {
              tailf:info
                "<1-3600>;;specify the periodicity (in secs)";
              range "1..3600";
            }
          }
          leaf retries {
            tailf:info
              "Heartbeat Retries";
            tailf:cli-prefix-key;
            type uint16 {
              tailf:info
                "<1-10>;;specify the retries for response from MAG|LMA";
              range "1..10";
            }
