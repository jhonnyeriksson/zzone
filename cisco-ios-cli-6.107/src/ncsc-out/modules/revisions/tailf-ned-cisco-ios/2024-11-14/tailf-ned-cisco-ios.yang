    }
    container bandwidth {
      leaf bits {
        tailf:cli-drop-node-name;
        ios:ned-diff-minimize-value "/../..";
        type string;
      }
      leaf percent {
        // NCS drop tailf-common:cli-diff-delete-before statement
        ios:ned-diff-minimize-value "/../..";
        type ncs_template_percentage-type;
