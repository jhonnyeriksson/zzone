            tailf:cli-flat-list-syntax;
            tailf:cli-replace-all;
            ordered-by user;
            type string {
              tailf:info
                "WORD;;Interface name";
            }
          }
        }
      }
      container rp {
        tailf:info
          "rp";
        leaf vtp-domain {
          tailf:info
            "vlan domain name on interface";
          type string {
            tailf:info
              "WORD;;vlan domain name";
          }
        }
        leaf ip {
          tailf:info
            "enable multilayer switching for ip";
          type empty;
        }
      }
