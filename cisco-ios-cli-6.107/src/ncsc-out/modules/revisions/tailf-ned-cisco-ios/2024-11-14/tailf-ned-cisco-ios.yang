    leaf group-range {
      tailf:info
        "Enable/disable multicasting for selected group ranges";
      tailf:cli-diff-set-after "/ios:ipv6/access-list" {
        tailf:xpath-root 3;
        tailf:cli-when-target-set;
      }
      tailf:cli-diff-delete-before "/ios:ipv6/access-list" {
        tailf:xpath-root 3;
        tailf:cli-when-target-delete;
      }
      type string {
        tailf:info
          "WORD;;Named access list specifying group ranges";
      }
    }
    container mpls {
      tailf:info
        "IP multicast mpls commands";
      container source {
        tailf:info
          "Configure source interface for multicast RPF";
        uses interface-name-grouping;
      }
      leaf mldp {
        tailf:info
          "MLDP commands";
        type empty;
      }
    }
  }

  grouping ipv6-mobile-pmipv6-mag-lma-grouping {
    container heartbeat {
      tailf:info
        "periodic verification of MAG|LMA reachability";
      container interval {
        tailf:info
          "Heartbeat Interval";
        container default {
          tailf:cli-drop-node-name;
          tailf:cli-compact-syntax;
          tailf:cli-sequence-commands {
            tailf:cli-reset-siblings;
          }
          leaf periodicity {
            tailf:cli-drop-node-name;
            tailf:cli-incomplete-command;
            type uint16 {
              tailf:info
                "<1-3600>;;specify the periodicity (in secs)";
              range "1..3600";
            }
          }
          leaf retries {
            tailf:info
              "Heartbeat Retries";
