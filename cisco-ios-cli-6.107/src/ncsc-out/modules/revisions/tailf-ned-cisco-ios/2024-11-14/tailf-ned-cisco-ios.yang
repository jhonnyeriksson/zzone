          type enumeration {
            enum "0-133ft" {
              tailf:info
                "0ft-133ft line build out";
            }
            enum "133-266ft" {
              tailf:info
                "133ft-266ft line build out";
            }
            enum "266-399ft" {
              tailf:info
                "266ft-399ft line build out";
            }
            enum "399-533ft" {
              tailf:info
                "399ft-533ft line build out";
            }
            enum "533-655ft" {
              tailf:info
                "533ft-655ft line build out";
            }
          }
        }
      }
      list input-source {
