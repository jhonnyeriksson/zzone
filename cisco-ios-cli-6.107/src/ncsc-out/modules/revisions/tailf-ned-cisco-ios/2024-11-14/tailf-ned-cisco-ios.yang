            tailf:cli-optional-in-sequence;
            type empty;
          }
          leaf timeout {
            tailf:info
              "timeout for heatrbeat response";
            type uint16 {
              tailf:info
                "<1-3600>;;specify the timeout for response from MAG|LMA";
              range "1..3600";
            }
          }
        }
        list label-list {
          tailf:cli-drop-node-name;
          tailf:cli-suppress-mode;
          tailf:cli-delete-when-empty;
          tailf:cli-compact-syntax;
          tailf:cli-sequence-commands {
            tailf:cli-reset-siblings;
          }
          key "label";
          leaf periodicity {
            tailf:cli-drop-node-name;
            tailf:cli-prefix-key;
            type uint16 {
              tailf:info
                "<1-3600>;;specify the periodicity (in secs)";
              range "1..3600";
            }
          }
          leaf retries {
            tailf:info
              "Heartbeat Retries";
            tailf:cli-prefix-key;
            type uint16 {
              tailf:info
                "<1-10>;;specify the retries for response from MAG|LMA";
              range "1..10";
            }
          }
          leaf label {
            tailf:info
              "path label";
            tailf:cli-expose-key-name;
            type string {
              tailf:info
                "WORD;;LABEL string";
            }
          }
          leaf natreboot {
            tailf:info
              "detect nat reboot";
            tailf:cli-optional-in-sequence;
            type empty;
          }
          leaf timeout {
            tailf:info
              "timeout for heatrbeat response";
            type uint16 {
              tailf:info
                "<1-3600>;;specify the timeout for response from MAG|LMA";
              range "1..3600";
            }
          }
        }
      }
    }
    container replay-protection {
      tailf:info
        "Configure replay proection mechanism within lma";
      container timestamp {
        tailf:info
          "timestamp option";
        leaf window {
          tailf:info
            "window value";
          type union {
            type uint8 {
              tailf:info
                "<3-255>;;specify the window value (secs)";
              range "3..255";
            }
            type enumeration {
              enum "ignore" {
                tailf:info
                  "ignore timestamp window";
              }
            }
          }
        }
      }
    }
  }

  grouping site-manager-policy-list-grouping {
