                      tailf:info
                        "<1-65535>;;Port Number (Recommended ports greater than 1023)";
                    }
                    type enumeration {
                      enum "any" {
                        tailf:info
                          "Any remote port";
                      }
                    }
                  }
                }
                leaf timeout {
                  tailf:info
