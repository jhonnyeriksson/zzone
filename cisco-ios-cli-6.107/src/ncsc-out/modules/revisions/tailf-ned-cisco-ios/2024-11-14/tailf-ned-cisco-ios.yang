        }
        type enumeration {
          enum "cisco" {
            tailf:info
              "Cisco implementation of three-way handshake (default)";
          }
          enum "ietf" {
            tailf:info
              "IETF implementation of three-way handshake";
          }
        }
        default "cisco";
      }
      choice priority-choice {
        leaf priority {
          tailf:info
