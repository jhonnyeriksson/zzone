              "TI-LFA protection";
            leaf level-1 {
              tailf:info
                "apply to level-1";
              type empty;
            }
            leaf level-2 {
              tailf:info
                "apply to level-2";
              type empty;
            }
          }
        }
      }
    }
    choice vrf-choice {
      container ip-vrf {
        tailf:cli-drop-node-name;
        container ip {
          container vrf {
            leaf forwarding {
              tailf:info
