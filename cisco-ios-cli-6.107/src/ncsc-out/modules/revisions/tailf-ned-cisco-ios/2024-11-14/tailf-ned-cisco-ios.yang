          key "id";
          leaf id {
            type enumeration {
              enum "exclude-any" {
                tailf:info
                  "Affinity attributes to exclude";
              }
              enum "include-all" {
                tailf:info
                  "Enter include-all mode";
              }
              enum "include-any" {
                tailf:info
                  "Affinity attributes to include";
              }
            }
          }
          list name {
            tailf:info
              "Affinity color name";
            tailf:cli-suppress-mode;
            tailf:cli-delete-when-empty;
            key "name";
            leaf name {
              type string {
                tailf:info
                  "WORD;;Affinity color name";
              }
            }
          }
        }
      }
    }
    leaf display-route-detail {
      tailf:info
        "Display detailed IP route information";
      type empty;
