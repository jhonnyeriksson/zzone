          key "name";
          leaf name {
            type string {
              tailf:info
                "WORD;;Listener profile name";
            }
          }
          container transport {
            tailf:info
              "The transport to use";
            choice transport-choice {
              container http {
                tailf:info
                  "Use http (plaintext) transport";
                presence "true";
              }
              container https {
                tailf:info
                  "Use https (encrypted) transport";
                presence "true";
              }
              container ssh {
                tailf:info
                  "Use SSH V2";
                presence "true";
              }
            }
          }
        }
        list initiator {
          tailf:cli-mode-name "config-wsma-init";
          key "name";
          leaf name {
            type string {
              tailf:info
                "WORD;;Initiator profile name";
            }
          }
          container transport {
            tailf:info
              "The transport to use";
            choice transport-choice {
              container http {
                tailf:info
                  "Use http (plaintext) transport";
                presence "true";
              }
              container https {
                tailf:info
                  "Use https (encrypted) transport";
                presence "true";
              }
              container ssh {
                tailf:info
                  "Use SSH V2";
                presence "true";
              }
            }
          }
        }
      }
