    container fast-reroute {
      tailf:info
        "Configure Fast-Reroute";
      container per-prefix {
        tailf:info
          "Enable Fast-Reroute Per-Prefix";
        container level-1 {
          tailf:info
            "Apply to level-1";
          choice level-choice {
            leaf route-map {
              tailf:info
