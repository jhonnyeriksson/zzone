        }
      }
      list authentication-key {
        tailf:info
          "Authentication key for trusted time sources";
        tailf:cli-suppress-mode;
        tailf:cli-delete-when-empty;
        tailf:cli-compact-syntax;
        tailf:cli-sequence-commands {
          tailf:cli-reset-siblings;
        }
        tailf:cli-incomplete-command;
        key "number";
        leaf number {
          type uint32 {
            tailf:info
              "<1-4294967295>;;Key number";
            range "1..4294967295";
          }
        }
        choice algorithm-choice {
          container md5 {
            tailf:info
              "MD5 authentication";
            tailf:cli-optional-in-sequence;
            tailf:cli-flatten-container;
            tailf:cli-compact-syntax;
            tailf:cli-sequence-commands;
            leaf secret {
              tailf:cli-drop-node-name;
              tailf:cli-reset-container;
              cli:secret " md5 <SECRET>";
              type string {
                tailf:info
                  "WORD;;Authentication key";
              }
            }
            leaf type {
              tailf:cli-drop-node-name;
              tailf:cli-full-command;
              type uint32 {
                tailf:info
                  "<0-4294967295>;;Authentication key encryption type";
              }
            }
          }
          case algorithm {
            leaf algorithm {
              tailf:cli-drop-node-name;
              tailf:cli-reset-container;
              tailf:cli-incomplete-command;
              type enumeration {
                enum "cmac-aes-128" {
                  tailf:info
                    "CMAC-AES-128 (digest length = 128 bits, key length = [16 or 32] bytes)";
                }
                enum "hmac-sha1" {
                  tailf:info
                    "HMAC-SHA1 (digest length = 160 bits, key length = [1-32] bytes)";
                }
                enum "hmac-sha2-256" {
                  tailf:info
                    "HMAC-SHA2-256 (digest length = 256 bits, key length = [1-32] bytes)";
                }
                enum "md5" {
                  tailf:info
                    "MD5 authentication";
                }
                enum "sha1" {
                  tailf:info
                    "SHA1 (digest length = 160 bits, key length = [1-32] bytes)";
                }
                enum "sha2" {
                  tailf:info
                    "SHA-256 (digest length = 256 bits, key length = [1-32] bytes)";
                }
              }
            }
            leaf secret {
              tailf:cli-drop-node-name;
              cli:secret " authentication-key \\d+ \\S+ (\\S+)";
              type string {
                tailf:info
                  "WORD;;Authentication key";
              }
            }
            leaf type {
              tailf:cli-drop-node-name;
              type uint32 {
                tailf:info
                  "<0-4294967295>;;Authentication key encryption type";
              }
            }
          }
        }
      }
      leaf authenticate {
        tailf:info
          "Authenticate time sources";
        tailf:cli-full-command;
        type empty;
