        container cfm {
          tailf:info
            "Ethernet CFM EFP subcommands";
          container mip {
            tailf:info
              "Maintenance Intermediate Point";
            leaf level {
              tailf:info
                "Maintenance Level";
              type uint8 {
                tailf:info
                  "<0-7>;;maintenance level number";
                range "0..7";
              }
            }
          }
          container mep {
            tailf:info
              "Maintenance End Point";
            tailf:cli-add-mode;
            tailf:cli-mode-name "config-if-srv-ecfm-mep";
            tailf:cli-compact-syntax;
            tailf:cli-sequence-commands;
            tailf:cli-delete-when-empty;
            tailf:cli-incomplete-command;
            presence "true";
            leaf domain {
              tailf:info
                "Configure a domain for this mep";
              tailf:cli-hide-in-submode;
              tailf:cli-incomplete-command;
              // NCS drop tailf-common:non-strict-leafref statement
              tailf:cli-diff-set-after "/ios:ethernet/cfm/domain/service" {
                tailf:xpath-root 3;
                tailf:cli-when-target-set;
              }
              tailf:cli-diff-delete-before "/ios:ethernet/cfm/domain/service" {
                tailf:xpath-root 3;
                tailf:cli-when-target-delete;
              }
              ios:config-lock
                "  cfm mep domain (\\S+) mpid \\d+ :: 
                 ethernet cfm domain $1 level <S>((?!
                 !).)*
                  no service <S> evc =EVC
                " {
                cli:arguments "=EVC :: service instance .+ ethernet (\\S+)";
              }
              type string {
                tailf:info
                  "WORD;;maintenance domain name";
              }
            }
            leaf mpid {
              tailf:info
                "Maintenance End Point Identifier";
              tailf:cli-hide-in-submode;
              type uint16 {
                tailf:info
                  "<1-8191>;;Maintenance End Point Identifier";
                range "1..8191";
              }
            }
            container continuity-check {
              tailf:info
                "Enable Continuity Check for this local MEP";
