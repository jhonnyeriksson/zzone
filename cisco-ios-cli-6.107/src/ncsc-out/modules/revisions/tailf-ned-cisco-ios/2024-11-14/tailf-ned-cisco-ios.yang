        container level-1 {
          tailf:info
            "Apply to level-1";
          container mpls-ldp {
            tailf:info
              "Use mpls-ldp tunnel type";
            tailf:cli-delete-when-empty;
            presence "true";
            leaf maximum-metric {
              tailf:info
                "maximum metric to reach release node";
              type uint32 {
                tailf:info
                  "<1-4294967295>;;metric value";
              }
            }
          }
        }
        container level-2 {
          tailf:info
            "Apply to level-2";
          container mpls-ldp {
            tailf:info
              "Use mpls-ldp tunnel type";
            tailf:cli-delete-when-empty;
            presence "true";
            leaf maximum-metric {
              tailf:info
                "maximum metric to reach release node";
              type uint32 {
                tailf:info
                  "<1-4294967295>;;metric value";
              }
            }
          }
        }
