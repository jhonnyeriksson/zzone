        container candidate {
          tailf:info
            "interface can be used for fast-reroute path";
          leaf level-1 {
            tailf:info
              "apply to level-1";
            type empty;
          }
          leaf level-2 {
            tailf:info
              "apply to level-2";
            type empty;
          }
        }
        container ti-lfa {
          tailf:info
            "TI-LFA interface configuration";
