              tailf:info
                "Inherit a peer-session template";
              tailf:cli-remove-before-change;
              tailf:cli-full-command;
              tailf:non-strict-leafref {
                path "/ncs:devices/ncs:device/ncs:config/ios:router/bgp/template/peer-session/name" {
                  tailf:xpath-root 3;
                }
              }
              type string {
                tailf:info
                  "WORD;;Template name";
              }
            }
            leaf peer-policy {
