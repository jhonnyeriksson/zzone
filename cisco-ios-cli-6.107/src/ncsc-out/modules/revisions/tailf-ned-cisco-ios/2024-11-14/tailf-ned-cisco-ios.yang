            range "400..60000";
          }
        }
        leaf process-time {
          tailf:cli-drop-node-name;
          type uint16 {
            tailf:info
              "<100-4000>;;Microseconds running processes";
            range "100..4000";
          }
        }
      }
      leaf interval {
        tailf:info
          "Maximum interval before running lowest priority process";
        type uint32 {
          tailf:info
            "<100-2147483647>;;Milliseconds";
          range "100..2147483647";
        }
      }
      leaf isr-watchdog {
        tailf:info
          "Detect ISR Hang";
        type empty;
      }
      container runtime {
        tailf:info
          "Process runtime controls";
        leaf netinput {
          tailf:info
            "Enable packet process-switching run time";
          type uint16 {
            tailf:info
              "<100-40000>;;Process-switching run time (in milliseconds)";
            range "100..40000";
