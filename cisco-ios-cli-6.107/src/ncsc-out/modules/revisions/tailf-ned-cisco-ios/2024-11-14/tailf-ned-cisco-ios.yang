                  type enumeration {
                    enum "drop" {
                      tailf:info
                        "Do not forward BOOTREQUEST message";
                    }
                    enum "encapsulate" {
                      tailf:info
                        "Encapsulate existing information";
                    }
                    enum "keep" {
                      tailf:info
                        "Leave existing information alone";
                    }
                    enum "replace" {
                      tailf:info
                        "Replace existing information";
                    }
                  }
                }
              }
              container source-interface {
                tailf:info
