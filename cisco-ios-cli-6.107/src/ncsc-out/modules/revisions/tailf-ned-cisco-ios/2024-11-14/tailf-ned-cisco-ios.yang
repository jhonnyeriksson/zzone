    list network-clock-select {
      tailf:ncs-device-type "cli-ned";
      tailf:display-when "not(../ncs:module) or ../ncs:module[ncs:name='tailf-ned-cisco-ios']";
      tailf:info
        "Choose system clocking priority";
      tailf:cli-suppress-mode;
      tailf:cli-delete-when-empty;
      tailf:cli-compact-syntax;
      tailf:cli-sequence-commands {
        tailf:cli-reset-siblings;
      }
      key "priority";
      leaf priority {
        type uint8 {
          tailf:info
            "<1-8>;;priority";
          range "1..8";
        }
      }
      leaf controller {
        tailf:cli-drop-node-name;
        type enumeration {
          enum "E1";
          enum "T1";
          enum "ATM";
          enum "BRI";
        }
      }
      leaf slot-port {
        tailf:cli-drop-node-name;
        type string;
      }
    }
    container network-clock {
      tailf:ncs-device-type "cli-ned";
      tailf:display-when "not(../../ncs:module) or ../../ncs:module[ncs:name='tailf-ned-cisco-ios']";
      tailf:info
        "Network clock config commands";
      leaf revertive {
        tailf:info
          "Reference clock reverts to the highest QL/priority after failure";
        tailf:cli-full-command;
        tailf:cli-diff-set-after "../synchronization" {
          tailf:xpath-root 3;
        }
        type empty;
      }
      container synchronization {
        tailf:info
          "Network clock synchronization selection process";
        leaf automatic {
          tailf:info
            "ITU-T G.781/Telcordia standard based synchronization selection process";
          type empty;
        }
        container ssm {
          tailf:info
            "Synchronization Status Message process";
          tailf:cli-compact-syntax;
          tailf:cli-sequence-commands {
            tailf:cli-reset-siblings;
          }
          leaf option {
            tailf:info
              "Synchronization networking Option";
            type enumeration {
              enum "1" {
                tailf:info
                  "Synchronization networking Option I";
              }
              enum "2" {
                tailf:info
                  "Synchronization networking Option II";
              }
            }
            default "1";
          }
          leaf generation {
            tailf:cli-drop-node-name;
            when "../option = '2'" {
              tailf:xpath-root 3;
              tailf:dependency "../option";
            }
            type enumeration {
              enum "GEN1" {
                tailf:info
                  "Option II Generation 1";
              }
              enum "GEN2" {
                tailf:info
                  "Option II Generation 2";
              }
            }
          }
        }
        container mode {
          tailf:info
            "synchronization networking mode";
          leaf QL-enabled {
            tailf:info
              "QL-enabled mode";
            type empty;
          }
        }
      }
      list quality-level {
        tailf:info
          "Quality Level";
        tailf:cli-suppress-mode;
        tailf:cli-delete-when-empty;
        tailf:cli-compact-syntax;
        tailf:cli-sequence-commands {
          tailf:cli-reset-siblings;
        }
        key "name";
        leaf direction {
          tailf:cli-drop-node-name;
          tailf:cli-prefix-key;
          type enumeration {
            enum "rx" {
              tailf:info
                "QL Receive";
            }
            enum "tx" {
              tailf:info
                "QL Transmit";
            }
          }
        }
        leaf value {
          tailf:cli-drop-node-name;
          tailf:cli-prefix-key;
          type enumeration {
            enum "QL-DUS" {
              tailf:info
                "QL-DUS";
            }
            enum "QL-PRS" {
              tailf:info
                "QL-PRS";
            }
            enum "QL-SMC" {
              tailf:info
                "QL-SMC";
            }
            enum "QL-ST2" {
              tailf:info
                "QL-ST2";
            }
            enum "QL-ST3" {
              tailf:info
                "QL-ST3";
            }
            enum "QL-ST3E" {
              tailf:info
                "QL-ST3E";
            }
            enum "QL-ST4" {
              tailf:info
                "QL-ST4";
            }
            enum "QL-STU" {
              tailf:info
                "QL-STU";
            }
            enum "QL-TNC" {
              tailf:info
                "QL-TNC";
            }
          }
        }
        leaf interface {
          tailf:cli-drop-node-name;
          tailf:cli-prefix-key;
          type enumeration {
            enum "External" {
              tailf:info
                "External Interface (BITS/SSU/GPS)";
            }
          }
        }
        leaf name {
