      type string;
    }
    container map-cache-persistent {
      presence "true";
      leaf interval {
        type string;
      }
    }
    container route-import {
      container map-cache {
        container maximum-prefix {
          leaf value {
            tailf:cli-drop-node-name;
            type string;
          }
          leaf warning-only {
            type empty;
          }
        }
        uses ncs_template_router-lisp-route-import-grouping;
      }
      container database {
        uses ncs_template_router-lisp-route-import-grouping;
