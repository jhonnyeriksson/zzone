                  range "1..8191";
                }
              }
              leaf domain {
                tailf:info
                  "Domain Name";
                tailf:cli-expose-key-name;
                type string {
                  tailf:info
                    "WORD;;Domain Name Value";
                }
              }
              choice vlan-or-port {
                leaf port {
                  tailf:info
                    "DOWN service direction with no vlan association";
