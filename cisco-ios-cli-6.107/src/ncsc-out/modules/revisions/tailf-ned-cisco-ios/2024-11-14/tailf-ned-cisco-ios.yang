        tailf:cli-drop-node-name;
        type enumeration {
          enum "level-1" {
            tailf:info
              "Summarize into level-1 area";
          }
          enum "level-1-2" {
            tailf:info
              "Summarize into both area and sub-domain";
          }
          enum "level-2" {
            tailf:info
              "Summarize into level-2 sub-domain";
          }
        }
      }
      leaf tag {
        tailf:info
          "Set tag";
        type uint32 {
          tailf:info
            "<1-4294967295>;;32-bit tag value";
          range "1..4294967295";
        }
