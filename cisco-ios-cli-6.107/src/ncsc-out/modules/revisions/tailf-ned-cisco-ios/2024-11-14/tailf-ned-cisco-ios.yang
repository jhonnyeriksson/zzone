              tailf:info
                "Control distribution of default information";
              leaf originate {
                tailf:info
                  "Distribute a default route";
                type empty;
              }
            }
            leaf default-metric {
              tailf:info
                "Set metric of redistributed routes";
              tailf:cli-full-command;
              type uint32 {
                tailf:info
                  "<1-4294967295>;;Default metric";
                range "1..4294967295";
              }
            }
