          tailf:info
            "DISABLE COPP ACL";
          type empty;
        }
        leaf disable_color_blind_policer {
          tailf:info
            "DISABLE COLOR BLIND POLICER";
          type empty;
        }
        leaf disable_tdm_to_ip_iw {
          tailf:info
            "DISABLE TDM TO IP IW";
          type empty;
        }
        leaf disable_l2pt_fwd_all {
          tailf:info
            "DISABLE L2PT FORWARD ALL";
          type empty;
        }
        leaf disable_multicast_stats {
          tailf:info
            "DISABLE MULTICAST STATS";
          type empty;
        }
        leaf disable_bdi_mtu {
          tailf:info
            "Disable BDI MTU";
          type empty;
        }
        leaf disable_portchannel_qos_multiple_active {
          tailf:info
            "Disable portchannel QoS multiple active";
          type empty;
        }
        leaf no_efp_feat_ext {
          tailf:info
            "NO EFP FEAT EXT";
          type empty;
        }
        choice egr_l3vpn_cm-choice {
          leaf disable_egr_l3vpn_cm {
            tailf:info
              "DISABLE EGRESS L3VPN CM";
            type empty;
          }
          leaf enable_egr_l3vpn_cm {
            tailf:info
              "ENABLE EGRESS L3VPN CM";
            type empty;
          }
        }
        leaf disable_l3vpn_cm {
          tailf:info
            "DISABLE L3VPN CM";
          type empty;
        }
        choice copp-choice {
          leaf disable_copp {
            tailf:info
              "DISABLE COPP";
            type empty;
          }
          leaf enable_copp {
            tailf:info
              "ENABLE COPP";
            type empty;
          }
        }
        leaf disable_match_inner_dscp {
          tailf:info
            "DISABLE MATCH INNER DSCP";
          type empty;
        }
        leaf sr_pfp_disable {
          tailf:info
            "Disable SR PFP";
          type empty;
        }
        leaf sr_5_label_push_disable {
          tailf:info
            "Disable SR 5 labels push";
          type empty;
        }
        leaf access {
          tailf:info
            "Access bias";
          type empty;
        }
        leaf default {
          tailf:info
            "default template";
          type empty;
        }
        leaf dual-ipv4-and-ipv6 {
          tailf:info
            "Support both IPv4 and IPv6";
          type enumeration {
            enum "default" {
              tailf:info
                "Default bias";
            }
            enum "routing" {
              tailf:info
                "Unicast bias";
            }
            enum "vlan" {
              tailf:info
                "VLAN bias";
            }
          }
        }
        leaf routing {
          tailf:info
            "Unicast bias";
          type empty;
        }
        leaf qos {
          type empty;
        }
        leaf ip {
          tailf:info
            "ip template";
          type empty;
        }
        leaf advanced {
          tailf:info
            "Advanced Template";
          type empty;
        }
        leaf vlan {
          tailf:info
            "VLAN bias";
          type empty;
        }
        leaf video {
          tailf:info
            "video template";
          type empty;
        }
        choice vpls_stats-choice {
          leaf vpls_stats_disable {
            tailf:info
              "Disable VPLS Pseudowire statistics";
            type empty;
          }
          leaf vpls_stats_enable {
            tailf:info
              "Enable VPLS Pseudowire statistics";
            type empty;
          }
        }
        leaf disable_vlan_translation {
          tailf:info
            "Disable VLAN Translation template";
          type empty;
        }
