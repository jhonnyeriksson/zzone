            tailf:info
              "Channel Center frequency";
            tailf:cli-incomplete-command;
            type uint32 {
              tailf:info
                "<55000000-1050000000>;;Center Frequency - Hz";
              range "55000000..1050000000";
            }
          }
          leaf connected-receive-module {
