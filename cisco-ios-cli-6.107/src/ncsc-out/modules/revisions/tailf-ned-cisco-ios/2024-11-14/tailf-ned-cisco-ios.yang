                tailf:info
                  "DSU mode 1";
              }
              enum "2" {
                tailf:info
                  "DSU mode 2";
              }
            }
          }
        }
        leaf framing {
          tailf:info
            "Framing interface subcommands";
          tailf:cli-full-command;
          type enumeration {
            enum "bypass";
            enum "g751" {
              tailf:info
                "G.751 framing";
            }
            enum "c-bit";
            enum "m13";
          }
        }
        leaf cablelength {
          tailf:cli-full-command;
          type union {
            type uint32;
            type enumeration {
              enum "short";
              enum "long";
            }
          }
        }
