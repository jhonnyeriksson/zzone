        container statistics {
          tailf:info
            "cpu statistics";
          container limit {
            tailf:info
              "cpu utilization history";
            tailf:cli-compact-syntax;
            tailf:cli-sequence-commands {
              tailf:cli-reset-siblings;
            }
            leaf entry-percentage {
