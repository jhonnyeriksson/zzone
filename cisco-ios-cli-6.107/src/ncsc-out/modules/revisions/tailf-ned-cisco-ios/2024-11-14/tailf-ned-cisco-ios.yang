        type string;
      }
    }
    container monitor {
      container metric {
        container rtp {
          list clock-rate {
            // NCS patched for predictable order
            ordered-by user;
            tailf:cli-suppress-mode;
            key "id";
            leaf id {
              type string;
            }
            leaf rate {
              tailf:cli-drop-node-name;
              type string;
            }
          }
        }
      }
    }
    list react {
      // NCS patched for predictable order
      ordered-by user;
      key "id";
      leaf id {
        type string;
      }
      leaf type {
        tailf:cli-drop-node-name;
        type string;
      }
      container threshold {
        container value {
          leaf ge {
            type string;
          }
        }
      }
      container action {
        leaf syslog {
          type empty;
        }
        leaf snmp {
          type empty;
        }
      }
    }
    leaf pass-through {
      type empty;
    }
    container policy {
      tailf:cli-drop-node-name;
      leaf action {
        tailf:cli-drop-node-name;
        type string;
      }
      leaf log {
        // NCS drop when statement
        type empty;
