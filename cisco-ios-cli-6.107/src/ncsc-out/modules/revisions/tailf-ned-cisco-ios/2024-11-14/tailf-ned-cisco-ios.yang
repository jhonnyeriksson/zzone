            }
            choice interval-choice {
              case seconds {
                leaf seconds {
                  tailf:cli-drop-node-name;
                  type uint16 {
                    tailf:info
                      "<4-65535>;;RA Interval (sec). Default 200";
                    range "4..65535";
                  }
                  default "200";
                }
                leaf seconds-interval {
                  tailf:cli-drop-node-name;
                  type uint16 {
                    tailf:info
                      "<3-49151>;;Minimum interval (seconds)";
                    range "3..49151";
                  }
                }
              }
              case msec {
                leaf msec {
                  tailf:info
                    "Interval in milliseconds";
                  type uint32 {
                    tailf:info
                      "<70-65535000>;;RA Interval (msec)";
                    range "70..65535000";
                  }
                }
                leaf msec-interval {
                  tailf:cli-drop-node-name;
                  type uint32 {
                    tailf:info
                      "<30-6201577>;;Minimum interval (milliseconds)";
                    range "30..6201577";
                  }
                }
              }
            }
          }
          leaf lifetime {
            tailf:info
              "Set IPv6 Router Advertisement Lifetime";
            type uint16 {
              tailf:info
                "<0-9000>;;RA Lifetime (seconds). Default 1800";
              range "0..9000";
            }
            default "1800";
          }
          container dns {
            tailf:info
              "DNS";
            list server {
              tailf:info
                "DNS Server";
              tailf:cli-suppress-mode;
              tailf:cli-delete-when-empty;
              key "address";
              leaf address {
                type inet:ipv6-address {
                  tailf:info
                    "X:X:X:X::X;;IPv6 address";
                }
              }
            }
          }
        }
        container raguard {
          tailf:info
            "apply the router advertisements (RA) guard feature";
          tailf:cli-reset-container;
          tailf:cli-delete-when-empty;
          presence "true";
          leaf attach-policy {
            tailf:info
              "Apply a policy for feature RA guard";
            // NCS drop tailf-common:non-strict-leafref statement
            type string {
              tailf:info
                "WORD;;policy name for feature RA guard";
            }
          }
        }
        container autoconfig {
          tailf:info
            "Automatic Configuration";
          leaf prefix {
            tailf:info
              "Prefix";
            tailf:cli-full-command;
            type empty;
          }
          leaf default-route {
            tailf:info
              "Default Route";
            tailf:cli-full-command;
            type empty;
          }
        }
        leaf router-preference {
          tailf:info
            "Set default router preference value";
          type enumeration {
            enum "Low" {
              tailf:info
                "Low default router preference";
            }
            enum "Medium" {
              tailf:info
                "Medium default router preference";
            }
            enum "High" {
              tailf:info
                "High default router preference";
            }
          }
        }
        container inspection {
          tailf:info
            "Configure NDP inspection on the interface";
          presence "true";
          container vlan {
            tailf:info
              "Configure the vlan list for which this policy applies (default: all)";
            choice vlan-choice {
              default "which";
              leaf which {
                tailf:cli-drop-node-name;
                type enumeration {
                  enum "all" {
                    tailf:info
                      "all VLANs";
                  }
                  enum "none" {
                    tailf:info
                      "no VLANs";
                  }
                }
                default "all";
              }
              leaf-list vlans {
                tailf:cli-drop-node-name;
                tailf:cli-range-list-syntax;
                tailf:cli-replace-all;
                ios:leaf-list-modify-replace "default ipv6 nd inspection vlan none";
                type uint16 {
                  tailf:info
                    "WORD;;VLAN IDs of the VLANs for which this policy applies";
                  range "1..4094";
                }
              }
            }
          }
        }
