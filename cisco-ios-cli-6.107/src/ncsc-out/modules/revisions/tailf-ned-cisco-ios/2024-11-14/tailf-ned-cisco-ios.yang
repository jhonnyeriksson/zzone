        container service-policy {
          tailf:info
            "Attach a policy-map to an EFP";
          tailf:cli-diff-set-after "/ios:policy-map" {
            tailf:xpath-root 3;
            tailf:cli-when-target-set;
          }
          tailf:cli-diff-delete-before "/ios:policy-map" {
            tailf:xpath-root 3;
            tailf:cli-when-target-delete;
          }
          list input {
            tailf:info
