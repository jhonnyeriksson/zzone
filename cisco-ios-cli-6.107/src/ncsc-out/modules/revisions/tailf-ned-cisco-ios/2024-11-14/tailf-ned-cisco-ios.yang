    }
    leaf tcp {
      tailf:info
        "Specify max half-open TCP connections";
      type uint32 {
        tailf:info
          "<1-4294967295>;;half-open sessions";
        range "1..4294967295";
      }
    }
    leaf udp {
      tailf:info
        "Specify max half-open UDP connections";
      type uint32 {
        tailf:info
          "<1-4294967295>;;half-open sessions";
        range "1..4294967295";
      }
    }
    leaf icmp {
      tailf:info
        "Specify max half-open ICMP connections";
      type uint32 {
        tailf:info
          "<1-4294967295>;;half-open sessions";
        range "1..4294967295";
      }
    }
  }

