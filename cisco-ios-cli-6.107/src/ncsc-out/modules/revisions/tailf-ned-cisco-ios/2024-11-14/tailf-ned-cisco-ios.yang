        key "name";
        leaf name {
          tailf:non-strict-leafref {
            path "../../../acr/id";
          }
          type uint8 {
            tailf:info
              "<0-255>;;Controller unit number";
            range "0..255";
          }
        }
        uses controller-SONET-grouping;
      }
      list SDH {
        tailf:info
          "Channelized SDH controller";
        tailf:cli-mode-name "config-controller";
        key "name";
        leaf name {
          ios:delete-syntax "!";
          type string {
            tailf:info
              "WORD;;Controller slot/subslot[/unit]";
          }
        }
        container snmp {
          tailf:info
            "Modify SNMP controller parameters";
          container trap {
            tailf:info
              "Allow a specific SNMP trap";
            leaf link-status {
              tailf:info
                "Allow SNMP LINKUP and LINKDOWN traps";
              tailf:cli-boolean-no;
              type boolean;
              default "true";
            }
          }
        }
        leaf rate {
          tailf:info
            "Set the SONET/SDH rates";
          tailf:cli-remove-before-change;
          type enumeration {
            enum "STM1" {
              tailf:info
                "Set the controller to STM1 rate";
            }
            enum "STM4" {
              tailf:info
                "Set the controller to stm4 rate";
            }
            enum "STM16" {
              tailf:info
                "Set the controller to STM16 rate";
            }
          }
        }
        leaf ais-shut {
          tailf:info
            "Send LAIS when shutdown";
          tailf:cli-boolean-no;
          type boolean;
          default "true";
        }
        leaf alarm-report {
          tailf:info
            "Enable reporting of selected alarms";
          type enumeration {
            enum "all" {
              tailf:info
                "All alarm reports";
            }
          }
        }
        leaf shutdown {
          tailf:info
            "Shut down the Sonet/SDH controller";
          type empty;
        }
        container clock {
          tailf:info
            "Specify the clock source for Sonet/SDH port";
          leaf source {
            tailf:info
              "Specify the clock source for Sonet/SDH port";
            tailf:cli-full-command;
            type enumeration {
              enum "line" {
                tailf:info
                  "Recovered Clock";
              }
              enum "internal" {
                tailf:info
                  "Internal Clock";
              }
            }
          }
        }
        container overhead {
          tailf:info
            "Specify overhead settings";
          leaf s1s0 {
            tailf:info
              "Set the s1s0 bits of H1";
            type uint8 {
              tailf:info
                "<0-3>;;s1 & s0 bits";
            }
          }
        }
        container aug {
          tailf:info
            "Specify AU-3 or AU-4 mapping";
          leaf mapping {
            tailf:info
              "Specify AU-3 or AU-4 mapping";
            type enumeration {
              enum "au-3" {
                tailf:info
                  "AU-3";
              }
              enum "au-4" {
                tailf:info
                  "AU-4 (default)";
              }
            }
          }
        }
        list au-4 {
          tailf:info
            "Specify AU-4 number";
          tailf:cli-mode-name "config-ctrlr-au4";
          tailf:cli-recursive-delete;
          tailf:cli-diff-delete-before "../../SDH" {
            tailf:xpath-root 3;
          }
          key "id";
          leaf id {
            ios:delete-syntax "!";
            type uint8 {
              tailf:info
                "<1-4>;;au-4 number";
              range "1..4";
            }
          }
          container clock {
            tailf:info
              "Specify the clock source for a PATH";
            leaf source {
              tailf:info
                "Specify the clock source for a PATH";
              tailf:cli-full-command;
              type enumeration {
                enum "line" {
                  tailf:info
                    "Line Recovered Clock";
                }
                enum "internal" {
                  tailf:info
                    "Internal Clock";
                }
              }
            }
          }
          container overhead {
            tailf:info
              "Configure SDH path overhead flags";
            leaf c2 {
              tailf:info
                "Path signal label <0..255>";
              type uint8 {
                tailf:info
                  "<0-255>;;c2 path signal label <0...255>";
              }
            }
          }
          leaf mode {
            tailf:info
              "Specify the operational mode for au-4";
            type enumeration {
              enum "tug-3" {
                tailf:info
                  "mode 3xTug3";
              }
              enum "vc4" {
                tailf:info
                  "Mode VC4";
              }
            }
          }
          leaf channel-group {
            tailf:info
              "Configure POS channel-group";
            tailf:cli-diff-delete-before "../mode" {
              tailf:xpath-root 3;
            }
            type uint8 {
              tailf:info
                "<0-0>;;Channel group number";
            }
          }
          list tug-3 {
            tailf:info
              "TUG-3 number";
            tailf:cli-mode-name "config-ctrlr-tug3";
            tailf:cli-recursive-delete;
            tailf:cli-diff-delete-before "../../../SDH" {
              tailf:xpath-root 3;
            }
            key "id";
            leaf id {
              type uint8 {
                tailf:info
                  "<1-3>;;tug-3 number <1..3>";
                range "1..3";
              }
            }
            leaf mode {
              tailf:info
                "Specify the payload type for the tug-3";
              tailf:cli-case-insensitive;
              cli:ned-diff-move-last {
                cli:arguments "when-delete";
              }
              type enumeration {
                enum "ce3" {
                  tailf:info
                    "mode CE3";
                }
                enum "ct3" {
                  tailf:info
                    "mode CT3";
                }
                enum "ct3-e1" {
                  tailf:info
                    "mode CT3-E1";
                }
                enum "e3" {
                  tailf:info
                    "Configure E3 in TUG3";
                }
                enum "t3" {
                  tailf:info
                    "Configure T3 in TUG3";
                }
                enum "vc1x" {
                  tailf:info
                    "mode VC1x";
                }
                enum "vc3" {
                  tailf:info
                    "mode VC3";
                }
              }
            }
            list tug-2 {
              tailf:info
                "Tug-2 option to configure payload type";
              tailf:cli-mode-name "config-ctrlr-tug2-vcx";
              tailf:cli-recursive-delete;
              tailf:cli-diff-delete-before "../../tug-3" {
                tailf:xpath-root 3;
              }
              key "id";
              leaf id {
                type uint8 {
                  tailf:info
                    "<1-7>;;Tug-2 number <1-7>";
                  range "1..7";
                }
              }
              leaf payload {
                tailf:info
                  "specify payload type for this tug-2";
                tailf:cli-hide-in-submode;
                tailf:cli-case-insensitive;
                ios:delete-syntax "!";
                type enumeration {
                  enum "vc11" {
                    tailf:info
                      "payload vc11";
                  }
                  enum "vc12" {
                    tailf:info
                      "payload vc12";
                  }
                }
              }
              list e1 {
                tailf:info
                  "E1 line configuration";
                tailf:cli-suppress-mode;
                tailf:cli-delete-when-empty;
                tailf:cli-incomplete-command;
                key "id";
                leaf id {
                  type uint8 {
                    tailf:info
                      "<1-3>;;Choose VC number";
                  }
                }
                container cem-group {
                  tailf:info
                    "Specify the timeslots to cem-group mapping";
                  tailf:cli-flatten-container;
                  tailf:cli-compact-syntax;
                  tailf:cli-sequence-commands {
                    tailf:cli-reset-siblings;
                  }
                  leaf id {
                    tailf:cli-drop-node-name;
                    tailf:cli-remove-before-change;
                    tailf:cli-incomplete-command;
                    type uint16 {
                      tailf:info
                        "<0-65535>;;Channel number";
                    }
                  }
                  leaf unframed {
                    tailf:info
                      "Unframed in the cem group";
                    type empty;
                  }
                }
                uses description-grouping;
                leaf framing {
                  tailf:info
                    "Specify the type of Framing on a T1/E1 link";
                  type enumeration {
                    enum "crc4" {
                      tailf:info
                        "E1 with CRC";
                    }
                    enum "no-crc4" {
                      tailf:info
                        "E1";
                    }
                    enum "unframed" {
                      tailf:info
                        "Clear E1";
                    }
                  }
                }
              }
              list vc {
                tailf:info
                  "VC configurations";
                tailf:cli-suppress-mode;
                tailf:cli-delete-when-empty;
                tailf:cli-incomplete-command;
                key "id";
                leaf id {
                  type uint8 {
                    tailf:info
                      "<1-4>;;Choose VC number";
                  }
                }
                container overhead {
                  tailf:info
                    "Configure VT Line path overhead flag";
                  leaf v5 {
                    tailf:info
                      "Path signal label <0..7>";
                    type uint8 {
                      tailf:info
                        "<0-7>;;v5 path signal label <0..7>";
                    }
                  }
                }
              }
            }
            container t3 {
              tailf:info
                "t3 configuration";
              leaf framing {
                tailf:info
                  "Specify the type of Framing on a T3/E3 link";
                ios:delete-syntax "!";
                tailf:ned-ignore-compare-config;
                type enumeration {
                  enum "g751" {
                    tailf:info
                      "G751 Framing Format";
                  }
                  enum "g832" {
                    tailf:info
                      "G832 Framing Format";
                  }
                  enum "c-bit";
                }
              }
              container clock {
                tailf:info
                  "Specify the clock source for a T3/E3 link";
                leaf source {
                  tailf:info
                    "Specify the clock source for a T3/E3 link";
                  type enumeration {
                    enum "line" {
                      tailf:info
                        "Line Recovered Clock";
                    }
                    enum "internal" {
                      tailf:info
                        "Internal Clock";
                    }
                  }
                }
              }
            }
            list e1 {
              tailf:info
                "e1 configuration";
              tailf:cli-suppress-mode;
              tailf:cli-delete-when-empty;
              tailf:cli-incomplete-command;
              key "id";
              leaf id {
                type uint8 {
                  tailf:info
                    "e1 number";
                }
              }
              container cem-group {
                tailf:info
                  "Specify the timeslots to cem-group mapping";
                tailf:cli-flatten-container;
                tailf:cli-compact-syntax;
                tailf:cli-sequence-commands {
                  tailf:cli-reset-siblings;
                }
                leaf id {
                  tailf:cli-drop-node-name;
                  tailf:cli-remove-before-change;
                  tailf:cli-incomplete-command;
                  type uint16 {
                    tailf:info
                      "<0-65535>;;Channel number";
                  }
                }
                leaf unframed {
                  tailf:info
                    "Unframed in the cem group";
                  type empty;
                }
              }
              leaf framing {
                tailf:info
                  "Specify the type of Framing on a E1";
                type enumeration {
                  enum "crc4" {
                    tailf:info
                      "E1 with CRC";
                  }
                  enum "no-crc4" {
                    tailf:info
                      "E1 with no CRC";
                  }
                  enum "unframed" {
                    tailf:info
                      "No Framing Format";
                  }
                }
              }
            }
          }
        }
      }
      list SHDSL {
        tailf:info
          "SHDSL controller";
        tailf:cli-mode-name "config-controller";
        key "name";
        leaf name {
          type string {
            tailf:info
              "WORD;;Controller slot/Port adapter/Port";
          }
        }
        uses description-grouping;
        leaf termination {
          tailf:info
            "Line termination for this interface";
          type enumeration {
            enum "cpe" {
              tailf:info
                "termination cpe (customer)";
            }
            enum "co" {
              tailf:info
                "termination co (network)";
            }
          }
          default "cpe";
        }
        leaf mode {
          tailf:info
            "Operating mode";
          type enumeration {
            enum "atm" {
              tailf:info
                "ATM mode";
            }
            enum "efm" {
              tailf:info
                "EFM mode";
            }
          }
          default "atm";
        }
        list dsl-group {
          tailf:info
            "Configure the DSL group";
          tailf:cli-mode-name "config-controller-dsl-group";
          key "id";
          leaf id {
            type uint8 {
              tailf:info
                "<0-3>;;DSL group number";
            }
          }
          leaf pairs {
            tailf:info
              "Link number";
            tailf:cli-hide-in-submode;
            type string {
              tailf:info
                "<0-3>;;Comma separated list of link pairs which comprise the group";
            }
          }
          leaf efm-bond {
            tailf:info
              "EFM BOND";
            tailf:cli-hide-in-submode;
            type empty;
          }
          container shdsl {
            tailf:info
              "Symmetric g.shdsl configuration";
            container annex {
              tailf:info
                "Symmetric g.shdsl Annex configuration";
              tailf:cli-compact-syntax;
              tailf:cli-sequence-commands {
                tailf:cli-reset-siblings;
              }
              leaf standard {
                tailf:cli-drop-node-name;
                type enumeration {
                  enum "A" {
                    tailf:info
                      "Annex A of G.991.2 standard";
                  }
                  enum "A-F" {
                    tailf:info
                      "Annex A/F of G.991.2 standard";
                  }
                  enum "B" {
                    tailf:info
                      "Annex B of G.991.2 standard";
                  }
                  enum "B-G" {
                    tailf:info
                      "Annex B/G of G.991.2 standard";
                  }
                  enum "F" {
                    tailf:info
                      "Annex F of G.991.2 standard";
                  }
                  enum "G" {
                    tailf:info
                      "Annex G of G.991.2 standard";
                  }
                }
              }
              leaf coding {
                tailf:info
                  "TCPAM line coding";
                type enumeration {
                  enum "4-TCPAM" {
                    tailf:info
                      "4-TCPAM line coding";
                  }
                  enum "8-TCPAM" {
                    tailf:info
                      "8-TCPAM line coding";
                  }
                  enum "16-TCPAM" {
                    tailf:info
                      "16-TCPAM line coding";
                  }
                  enum "32-TCPAM" {
                    tailf:info
                      "32-TCPAM line coding";
                  }
                  enum "64-TCPAM" {
                    tailf:info
                      "64-TCPAM line coding";
                  }
                  enum "128-TCPAM" {
                    tailf:info
                      "128-TCPAM line coding";
                  }
                }
              }
            }
            container rate {
              tailf:info
                "DSL line rate configuration";
              tailf:cli-compact-syntax;
              tailf:cli-sequence-commands {
                tailf:cli-reset-siblings;
              }
              leaf enhanced {
                tailf:info
                  "Non standard extended rates";
                tailf:cli-optional-in-sequence;
                type empty;
              }
              leaf value {
                tailf:cli-drop-node-name;
                type union {
                  type enumeration {
                    enum "auto" {
                      tailf:info
                        "auto rate mode";
                    }
                  }
                  type uint16 {
                    tailf:info
                      "<512-22784>;;DSL Rate (excluding DSL overhead) in kbps";
                  }
                }
                default "auto";
              }
            }
          }
          container ignore {
            tailf:info
              "Ignore errors";
            leaf crc {
              tailf:info
                "Ignore CRC errors";
              type union {
                type uint8 {
                  tailf:info
                    "<0-60>;;Duration to ignore CRC errors (secs)";
                  range "0..60";
                }
                type enumeration {
                  enum "always" {
                    tailf:info
                      "Always ignore CRC errors";
                  }
                }
              }
            }
          }
          leaf handshake {
            tailf:info
              "Handshake configuration";
            type enumeration {
              enum "itut" {
                tailf:info
                  "Initiate ITUT handshake";
              }
              enum "ieee" {
                tailf:info
                  "Initiate IEEE handshake";
              }
            }
            default "itut";
          }
          leaf shutdown {
            tailf:info
              "shutdown this dsl-group";
            type empty;
          }
        }
      }
      list ISA {
        tailf:info
          "ISA controller";
        tailf:cli-mode-name "config-controller";
        key "name";
        leaf name {
          type string {
            tailf:info
              "WORD;;Controller slot/subslot[/unit]";
          }
        }
