                type uint8 {
                  tailf:info
                    "<0-32>;;Number of secondary paths";
                  range "0..32";
                }
              }
              leaf ibgp {
                tailf:info
                  "iBGP-secondary-multipath";
                type uint8 {
                  tailf:info
                    "<0-32>;;Number of secondary paths";
                  range "0..32";
                }
              }
            }
            container import {
              tailf:info
                "Configure path import";
              container l2vpn {
                tailf:info
                  "Import from l2vpn Address family";
                container evpn {
                  tailf:info
                    "Import from l2vpn evpn Address family";
                  tailf:cli-compact-syntax;
                  tailf:cli-sequence-commands {
                    tailf:cli-reset-siblings;
                  }
                  tailf:cli-delete-when-empty;
                  presence "true";
                  leaf re-originate {
                    tailf:info
                      "imported path with RT re-originate";
                    type empty;
                  }
                  leaf stitching-rt {
                    tailf:info
                      "imported path with RT re-originate with import stitching route-target";
                    type empty;
                  }
                }
              }
              container vpnv4 {
                tailf:info
                  "Import from vpnv4 Address family";
                container unicast {
                  tailf:info
                    "Import prefixes from vpn unicast table";
                  tailf:cli-reset-container;
                  tailf:cli-delete-when-empty;
                  presence "true";
                  leaf re-originate {
                    tailf:info
                      "imported path with RT re-originate";
                    type empty;
                  }
                }
              }
              container path {
                tailf:info
                  "Path selection and path limit";
                container selection {
                  tailf:info
                    "Path selection policy";
                  choice selection-choice {
                    leaf all {
                      tailf:info
                        "Import all available paths";
                      type empty;
                    }
                    container bestpath {
                      tailf:info
                        "Import the best available path.";
                      tailf:cli-delete-when-empty;
                      presence "true";
                      leaf strict {
                        tailf:info
                          "Do not fallback to best available path";
                        type empty;
                      }
                    }
                    container multipaths {
                      tailf:info
                        "Import all multipaths.";
                      tailf:cli-delete-when-empty;
                      presence "true";
                      leaf strict {
                        tailf:info
                          "Do not fallback to best available path";
                        type empty;
                      }
                    }
                  }
                }
                leaf limit {
                  tailf:info
                    "Per net imported path limit";
                  type uint8 {
                    tailf:info
                      "<2-255>;;Maximum number of paths that can be imported into a net";
                    range "2..255";
                  }
                }
              }
            }
