                tailf:info
                  "Suppress all ipv6 Router advertisements";
                type empty;
              }
            }
          }
          container interval {
            tailf:info
              "Set IPv6 Router Advertisement Interval";
            tailf:cli-compact-syntax;
            tailf:cli-sequence-commands {
              tailf:cli-reset-siblings;
            }
            tailf:cli-diff-delete-after "../lifetime" {
