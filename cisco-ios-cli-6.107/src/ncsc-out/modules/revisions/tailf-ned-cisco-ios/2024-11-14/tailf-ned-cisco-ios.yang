          type uint32 {
            tailf:info
              "<32-4294967294>;;Instance ID Value";
            range "32..4294967294";
          }
        }
        leaf level {
          tailf:cli-drop-node-name;
          type enumeration {
            enum "level-1" {
              tailf:info
                "Apply to level-1";
            }
            enum "level-2" {
              tailf:info
                "Apply to level-2";
            }
          }
        }
        leaf throttle {
          tailf:info
            "Set throttle update in seconds";
          type uint8 {
            tailf:info
              "<5-20>;;Specify the throttle value in seconds";
