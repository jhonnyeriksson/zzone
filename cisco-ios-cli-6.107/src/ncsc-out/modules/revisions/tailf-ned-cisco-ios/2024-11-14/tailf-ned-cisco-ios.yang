            type uint16 {
              tailf:info
                "<1-256>;;rate (powers-of-2 only)";
              range "1..256";
            }
          }
          leaf ping-bypass {
            tailf:info
              "allow console pings to bypass SBRL/punt-policer";
            type empty;
          }
        }
        leaf ping-bypass {
          tailf:info
            "allow console pings to bypass SBRL/punt-policer";
          type empty;
        }
