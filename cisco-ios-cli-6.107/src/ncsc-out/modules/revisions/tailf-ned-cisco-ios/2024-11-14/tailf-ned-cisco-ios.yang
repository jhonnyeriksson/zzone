              tailf:cli-compact-syntax;
              tailf:cli-sequence-commands {
                tailf:cli-reset-siblings;
              }
              leaf link-type {
                tailf:info
                  "link type";
                type string {
                  tailf:info
                    "WORD;;Link type 1 (NULL to drop)";
                }
              }
              leaf link-name1 {
                tailf:cli-drop-node-name;
                type string {
                  tailf:info
                    "WORD;;Link type (NULL to drop)";
                }
              }
              leaf link-name2 {
                tailf:cli-drop-node-name;
                type string {
                  tailf:info
                    "WORD;;Link type (NULL to drop)";
                }
              }
              leaf link-name3 {
                tailf:cli-drop-node-name;
                type string {
                  tailf:info
                    "WORD;;Link type (NULL to drop)";
                }
              }
            }
          }
          list nai {
            tailf:info
              "Network access identifier or realm";
            tailf:cli-mode-name "config-ipv6-pmipv6-domain-mn";
