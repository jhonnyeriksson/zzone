        tailf:xpath-root 3;
        tailf:cli-when-target-set;
      }
      tailf:cli-diff-delete-before "/ios:ip/prefix-list/prefixes" {
        tailf:xpath-root 3;
        tailf:cli-when-target-delete;
      }
      type string {
        tailf:info
          "WORD;;Name of an IP prefix-list";
