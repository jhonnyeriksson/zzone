        tailf:cli-compact-syntax;
        tailf:cli-sequence-commands {
          tailf:cli-reset-all-siblings;
        }
        tailf:cli-delete-when-empty;
        presence "true";
        leaf type {
          tailf:cli-drop-node-name;
          tailf:cli-remove-before-change;
          type enumeration {
            enum "facility" {
              tailf:info
                "Facility loopback";
            }
            enum "terminal" {
              tailf:info
                "Terminal loopback";
            }
          }
        }
        leaf vlan {
          tailf:info
            "Vlan";
          tailf:cli-break-sequence-commands;
          tailf:cli-remove-before-change;
          when "../type = 'facility'" {
            tailf:xpath-root 3;
          }
          type string {
            tailf:info
              "WORD;;Vlans to loopback";
          }
        }
        leaf mac-address {
