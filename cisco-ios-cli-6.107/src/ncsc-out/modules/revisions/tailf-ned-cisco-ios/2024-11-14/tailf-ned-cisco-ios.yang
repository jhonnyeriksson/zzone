            tailf:info
              "version control";
            type enumeration {
              enum "1" {
                tailf:info
                  "RIP version 1";
              }
              enum "2" {
                tailf:info
                  "RIP version 2";
              }
            }
          }
        }
        container receive {
          tailf:info
            "advertisement reception";
          leaf version {
            tailf:info
              "version control";
            type enumeration {
              enum "1" {
                tailf:info
                  "RIP version 1";
              }
              enum "2" {
                tailf:info
                  "RIP version 2";
              }
            }
