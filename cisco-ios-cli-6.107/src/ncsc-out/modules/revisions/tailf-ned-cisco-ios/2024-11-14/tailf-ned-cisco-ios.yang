          tailf:cli-mode-name "config-rtr";
          key "as-no";
          leaf as-no {
            type uint16 {
              tailf:info
                "<1-65535>;;Autonomous System";
              range "1..65535";
            }
          }
          container eigrp {
            tailf:info
              "EIGRP specific commands";
            leaf router-id {
              tailf:info
