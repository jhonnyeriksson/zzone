                  tailf:xpath-root 3;
                  tailf:cli-when-target-delete;
                }
                type uint16 {
                  tailf:info
                    "<1-3600>;;Number of seconds before expiration";
                  range "1..3600";
                }
              }
              leaf retry {
                tailf:info
                  "Number of attempts to extend registration";
                tailf:cli-incomplete-command;
                type uint8 {
                  tailf:info
                    "<0-10>;;Stop after number of retries attempted";
