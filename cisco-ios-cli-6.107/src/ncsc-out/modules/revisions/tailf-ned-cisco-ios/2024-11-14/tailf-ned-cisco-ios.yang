      list tie-break {
        tailf:info
          "Set repair path preference";
        tailf:cli-suppress-mode;
        tailf:cli-delete-when-empty;
        key "level";
        leaf level {
          type enumeration {
            enum "level-1" {
              tailf:info
                "Apply to level-1";
            }
            enum "level-2" {
              tailf:info
                "Apply to level-2";
            }
          }
        }
        leaf linecard-disjoint {
          tailf:info
            "Prefer line card disjoint repair path";
          type uint8 {
            tailf:info
              "<1-255>;;priority number";
