        leaf xe-version {
          type string;
        }
        leaf model {
          type string;
        }
        container license {
          leaf level {
            type string;
          }
          leaf type {
            type string;
          }
        }
      }
      list inventory {
        // NCS patched for predictable order
        ordered-by user;
        tailf:cli-suppress-mode;
        key "name";
        leaf name {
          type string;
        }
        leaf sn {
          type string;
        }
      }
    }
    leaf xxyyzztop {
      type string;
      // NCS drop default statement
    }
    leaf xxyyzzfail {
      type empty;
    }
  }

