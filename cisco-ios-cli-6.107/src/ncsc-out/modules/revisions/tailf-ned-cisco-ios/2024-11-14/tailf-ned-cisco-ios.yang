            leaf pure-ds-load {
              tailf:info
                "Do not count US load when calculating DS utilization";
              type empty;
            }
          }
          leaf init-tech-list {
            tailf:info
              "Set DCC initialization technique list";
            type string {
              tailf:info
                "<grouplist>;;DCC Initialization technique list";
            }
          }
          leaf docsis-policy {
            tailf:info
              "Enter load balance group policy";
            tailf:non-strict-leafref {
              path "../../../load-balance/docsis-policy/policy-id";
            }
            type uint32 {
              tailf:info
                "<0-4294967295>;;Load balance group policy number";
              range "0..4294967295";
            }
