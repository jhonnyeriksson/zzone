                    tailf:info
                      "<1-65535>;;Port Number (Recommended ports greater than 1023)";
                    range "1..65535";
                  }
                }
                leaf remote-ip {
                  tailf:info
                    "Address of the TWAMP Light Controller";
                  type union {
                    type inet:host {
                      tailf:info
                        "A.B.C.D;;IP address or hostname, broadcast disallowed";
                    }
                    type enumeration {
                      enum "any" {
                        tailf:info
                          "Any remote address";
                      }
                    }
                  }
                }
                leaf remote-ip-af {
