            type empty;
          }
          leaf dot1q-in-clear {
            tailf:info
              "Dot1q in Clear option";
            type enumeration {
              enum "1" {
                tailf:info
                  "Dot1q in Clear (presently only one tag supported)";
              }
            }
          }
          leaf access-control {
            tailf:info
              "Access Control Policy";
            type enumeration {
              enum "must-secure" {
                tailf:info
