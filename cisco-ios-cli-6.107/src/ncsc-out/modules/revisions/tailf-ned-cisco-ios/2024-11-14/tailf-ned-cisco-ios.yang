            leaf ipv6-address {
              tailf:info
                "Configure V6 address of the LMA";
              type inet:ipv6-address {
                tailf:info
                  "X:X:X:X::X;;LMA IPv6 address";
              }
            }
            leaf ipv4-address {
              tailf:info
                "Configure V4 address of the LMA";
              type inet:ipv4-address {
                tailf:info
                  "A.B.C.D;;LMA IPv4 address";
              }
            }
          }
          list mobile-map {
            tailf:info
              "mobile map configs for application based routing";
            tailf:cli-mode-name "config-ipv6-pmipv6-domain-mobile-map";
            key "name sequence";
            leaf name {
              type string {
                tailf:info
                  "WORD;;string";
              }
            }
            leaf sequence {
              tailf:cli-suppress-range;
              type uint8 {
                tailf:info
                  "<1-255>;;sequence to insert this map";
                range "1..255";
              }
            }
            container match {
              tailf:info
                "setting match clause for this mobile map";
              leaf access-list {
                tailf:info
                  "access list name";
                type string {
                  tailf:info
                    "WORD;;string";
                }
              }
            }
            container set {
              tailf:info
