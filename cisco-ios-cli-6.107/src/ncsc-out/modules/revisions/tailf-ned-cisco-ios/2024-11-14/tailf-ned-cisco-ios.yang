            enum "swap" {
              tailf:info
                "Swap MAC DA and SA";
            }
          }
        }
        leaf timeout {
          tailf:info
            "Configure a timeout";
          type union {
            type enumeration {
              enum "none" {
                tailf:info
                  "No timeout";
              }
            }
            type uint16 {
              tailf:info
                "<5-300>;;Timeout in seconds";
            }
