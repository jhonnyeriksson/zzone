              tailf:info
                "Vlan for voice traffic";
              type union {
                type enumeration {
                  enum "dot1p" {
                    tailf:info
                      "Priority tagged on PVID";
                  }
                  enum "none" {
                    tailf:info
                      "Don't tell telephone about voice vlan";
                  }
                  enum "untagged" {
                    tailf:info
                      "Untagged on PVID";
                  }
                }
                type uint16 {
                  tailf:info
                    "<1-4094>;;Vlan for voice traffic";
