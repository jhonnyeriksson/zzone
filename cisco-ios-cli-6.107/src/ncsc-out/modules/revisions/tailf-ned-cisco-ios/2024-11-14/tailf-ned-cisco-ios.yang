                  tailf:cli-incomplete-command;
                  tailf:cli-incomplete-no;
                  list interface {
                    tailf:info
                      "Specify an interface";
                    tailf:cli-suppress-mode;
                    tailf:cli-delete-when-empty;
                    key "name";
                    leaf name {
                      tailf:cli-diff-set-after "../../../../../../../../../interface" {
                        tailf:xpath-root 3;
                        tailf:cli-when-target-set;
                      }
                      tailf:cli-diff-delete-before "../../../../../../../../../interface" {
                        tailf:xpath-root 3;
                        tailf:cli-when-target-delete;
                      }
                      type string {
                        tailf:info
                          "WORD;;Interface name";
                      }
                    }
                  }
                }
              }
              list local {
                tailf:info
                  "Local address";
                tailf:cli-suppress-mode;
                tailf:cli-delete-when-empty;
                key "address";
                leaf address {
                  tailf:cli-disallow-value "interface";
                  type inet:host {
                    tailf:info
                      "Hostname, A.B.C.D or X:X:X:X::X;;Address";
                  }
                }
              }
            }
            leaf fvrf {
              tailf:info
                "fvrf of the profile";
              tailf:cli-diff-set-after "../../../../../vrf/definition" {
                tailf:xpath-root 3;
                tailf:cli-when-target-set;
              }
              tailf:cli-diff-delete-before "../../../../../vrf/definition" {
                tailf:xpath-root 3;
                tailf:cli-when-target-delete;
              }
              type union {
                type string {
                  tailf:info
                    "WORD;;fvrf name (default: global)";
