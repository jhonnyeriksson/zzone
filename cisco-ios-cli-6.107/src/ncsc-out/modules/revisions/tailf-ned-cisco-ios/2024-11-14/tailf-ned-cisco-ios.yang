          type enumeration {
            enum "in" {
              tailf:info
                "Inbound inspection";
            }
            enum "out" {
              tailf:info
                "Outbound inspection";
            }
          }
        }
        leaf name {
          tailf:cli-prefix-key;
          tailf:cli-drop-node-name;
          // NCS drop tailf-common:non-strict-leafref statement
          type string {
            tailf:info
              "WORD;;Name of inspection defined";
          }
        }
      }
