      leaf enable {
        tailf:info
          "Enable IPv6 on interface";
        tailf:cli-diff-set-after "/ios:vrf/definition/address-family/ipv6" {
          tailf:xpath-root 3;
          tailf:cli-when-target-set;
        }
        tailf:cli-diff-delete-before "/ios:vrf/definition/address-family/ipv6" {
          tailf:xpath-root 3;
          tailf:cli-when-target-delete;
        }
        type empty;
