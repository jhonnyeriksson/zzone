            tailf:cli-optional-in-sequence;
            type empty;
          }
          leaf timeout {
            tailf:info
              "timeout for heatrbeat response";
            type uint16 {
              tailf:info
                "<1-3600>;;specify the timeout for response from MAG|LMA";
              range "1..3600";
            }
          }
        }
      }
    }
    container replay-protection {
      tailf:info
        "Configure replay proection mechanism within lma";
      container timestamp {
        tailf:info
          "timestamp option";
        leaf window {
          tailf:info
            "window value";
          type union {
            type uint8 {
              tailf:info
                "<3-255>;;specify the window value (secs)";
              range "3..255";
            }
            type enumeration {
              enum "ignore" {
                tailf:info
                  "ignore timestamp window";
              }
            }
          }
        }
      }
    }
  }

  grouping ncs_rpc_notif_site-manager-policy-list-grouping {
    list type {
      tailf:info
        "Select policy service type";
      tailf:cli-mode-name "config-site-manager-vrf-mc-policy";
      key "name";
      leaf name {
        type enumeration {
          enum "dca" {
            tailf:info
              "Service of Direct cloud access";
          }
          enum "dia" {
            tailf:info
              "Service of Direct internet access";
          }
        }
      }
      list class {
        tailf:info
          "Create site-manager class and enter site-manager class command mode";
        tailf:cli-mode-name "config-site-manager-vrf-mc-policy-class";
        key "sequence";
        leaf name {
          tailf:cli-drop-node-name;
          tailf:cli-prefix-key;
          type string {
            tailf:info
              "WORD;;site-manager class name";
          }
        }
        leaf sequence {
          tailf:cli-expose-key-name;
          tailf:info
            "Set the Sequence for the class";
          type uint16 {
            tailf:info
              "<1-65535>;;Sequence number for the class";
            range "1..65535";
          }
        }
        container match {
          tailf:info
            "Specify the applications the policy applies to.";
          list app-group {
            tailf:info
              "Specify the application names.";
            tailf:cli-suppress-mode;
            tailf:cli-delete-when-empty;
            tailf:cli-incomplete-command;
            key "name";
            leaf name {
              type string {
                tailf:info
                  "WORD;;application name";
              }
            }
            leaf policy {
              tailf:info
                "Specify the policy (user defined/predefined)";
              type enumeration {
                enum "best-effort" {
                  tailf:info
                    "site-manager policy type best effort";
                }
                enum "custom" {
                  tailf:info
                    "custom user-defined policy";
                }
                enum "saas-dca" {
                  tailf:info
                    "site-manager policy type for SaaS DCA traffic";
                }
              }
            }
          }
          list application {
            tailf:info
              "Specify the application names.";
            tailf:cli-suppress-mode;
            tailf:cli-delete-when-empty;
            tailf:cli-incomplete-command;
            key "name";
            leaf name {
              type string {
                tailf:info
                  "WORD;;application name";
              }
            }
            leaf policy {
              tailf:info
                "Specify the policy (user defined/predefined)";
              type enumeration {
                enum "best-effort" {
                  tailf:info
                    "site-manager policy type best effort";
                }
                enum "custom" {
                  tailf:info
                    "custom user-defined policy";
                }
                enum "saas-dca" {
                  tailf:info
                    "site-manager policy type for SaaS DCA traffic";
                }
              }
            }
          }
        }
        uses ncs_rpc_notif_domain-path-preference-grouping;
      }
    }
  }

  grouping ncs_rpc_notif_class-map-type-ctrl-sub-match {
    container method {
      tailf:info
        "match the type of authentication method from an event";
      leaf webauth {
        tailf:info
          "webauth";
        type empty;
      }
      leaf mab {
        tailf:info
          "mab";
        type empty;
      }
      leaf dot1x {
        tailf:info
          "dot1x";
        type empty;
      }
    }
    container result-type {
      tailf:info
        "match the result type, optionally for a specific method";
      container method {
        tailf:info
          "match the result of a particular method";
        container dot1x {
          tailf:info
            "dot1x result";
          uses ncs_rpc_notif_result-type-method-grouping;
        }
        container mab {
          tailf:info
            "mab result";
          uses ncs_rpc_notif_result-type-method-grouping;
        }
        container webauth {
          tailf:info
            "webauth result";
          uses ncs_rpc_notif_result-type-method-grouping;
        }
      }
      uses ncs_rpc_notif_result-type-method-grouping;
    }
    leaf authorization-status {
      tailf:info
        "match the authorization status of the session";
      type enumeration {
        enum "authorized" {
          tailf:info
            "authorized";
        }
        enum "unauthorized" {
          tailf:info
            "unauthorized";
        }
      }
    }
    list activated-service-template {
      tailf:info
        "match name of service template activated on session";
      tailf:cli-suppress-mode;
      tailf:cli-delete-when-empty;
      key "name";
      leaf name {
        tailf:non-strict-leafref {
          path "../../../../../service-template/name";
        }
        type string {
          tailf:info
            "WORD;;Enter service name (eg template name)";
        }
      }
    }
    list authorizing-method-priority {
      tailf:info
        "match the priority against the authorizing method's priority";
      tailf:cli-suppress-mode;
      tailf:cli-delete-when-empty;
      key "op priority";
      leaf op {
        type enumeration {
          enum "eq" {
            tailf:info
              "equal to";
          }
          enum "gt" {
            tailf:info
              "greater than";
          }
          enum "lt" {
            tailf:info
              "less than";
          }
        }
      }
      leaf priority {
        type uint8 {
          tailf:info
            "<1-254>;;priority value";
        }
      }
    }
  }

  grouping ncs_rpc_notif_pm-dm-x-grouping {
    container advertisement {
      tailf:info
        "Advertisment";
      tailf:cli-add-mode;
      tailf:cli-mode-name "config-pm-dm-x-adv";
      container threshold-check {
        tailf:info
          "Threshold Check";
        tailf:cli-add-mode;
        tailf:cli-mode-name "config-pm-dm-x-adv-threshold-check";
        leaf delay {
          tailf:cli-drop-node-name;
          type enumeration {
            enum "average-delay" {
              tailf:info
                "Enable average-delay threshold check";
            }
            enum "minimum-delay" {
              tailf:info
                "Enable minimum-delay threshold check";
            }
            enum "maximum-delay" {
              tailf:info
                "Enable maximum-delay threshold check";
            }
          }
          default "average-delay";
        }
      }
      container accelerated {
        tailf:info
          "Accelerated";
        tailf:cli-add-mode;
        tailf:cli-mode-name "config-pm-dm-x-adv-acc";
        presence "true";
        leaf threshold {
          tailf:info
            "Accelerated advertisement threshold";
          type uint8 {
            tailf:info
              "<0-100>;;Accelerated advertisement threshold percentage change";
            range "0..100";
          }
        }
        leaf minimum-change {
          tailf:info
            "Accelerated advertisement minimum change";
          type uint32 {
            tailf:info
              "<0-1000000>;;Accelerated advertisement minimum change (uSec)";
            range "0..1000000";
          }
        }
      }
      container periodic {
        tailf:info
          "periodic";
        tailf:cli-add-mode;
        tailf:cli-mode-name "config-pm-dm-x-adv-per";
        leaf interval {
          tailf:info
            "Periodic advertisement interval";
          type uint16 {
            tailf:info
              "<30-3600>;;Periodic advertisement interval (seconds)";
            range "30..3600";
          }
        }
        leaf threshold {
          tailf:info
            "Periodic advertisement threshold";
          type uint8 {
            tailf:info
              "<0-100>;;Periodic advertisement threshold percentage change";
            range "0..100";
          }
          default "10";
        }
        leaf minimum-change {
          tailf:info
            "Periodic advertisement minimum change";
          type uint32 {
            tailf:info
              "<0-1000000>;;Periodic advertisement minimum change (uSec)";
            range "0..1000000";
          }
        }
        leaf disabled {
          tailf:info
            "Periodic advertisement disabled";
          type empty;
        }
      }
    }
    container probe {
      tailf:info
        "Delay profile probe submode";
      tailf:cli-add-mode;
      tailf:cli-mode-name "config-pm-dm-x-probe";
      container sweep {
        tailf:info
          "Enable ECMP hashing by sweeping a field in the probe packet";
        tailf:cli-add-mode;
        tailf:cli-mode-name "config-pm-dm-srpol-probe-sweep";
        container destination {
          tailf:info
            "Sweep a range of IP destination addresses";
          tailf:cli-compact-syntax;
          tailf:cli-sequence-commands {
            tailf:cli-reset-siblings;
          }
          leaf ipv4 {
            tailf:info
              "Start of the IPv4 address range";
            tailf:cli-incomplete-command;
            type inet:ipv4-address {
              tailf:info
                "A.B.C.D;;IPv4 address (Required to be a 127.0.0.0/8 address)";
            }
          }
          leaf range {
            tailf:info
              "Start of the IPv4 address range";
            type uint8 {
              tailf:info
                "<0-128>;;Sweeping range (Should fully be in the 127.0.0.0/8 space)";
              range "0..128";
            }
          }
        }
      }
      leaf computation-interval {
        tailf:info
          "Interval for metric computation";
        type uint16 {
          tailf:info
            "<30-3600>;;Computation interval (seconds)";
        }
        default "30";
      }
      leaf measurement-mode {
        tailf:info
          "Delay measurement mode";
        type enumeration {
          enum "one-way" {
            tailf:info
              "Enable one-way delay measurement";
          }
          enum "two-way" {
            tailf:info
              "Enable two-way delay measurement";
          }
          enum "loopback" {
            tailf:info
              "Enable loopback delay measurement";
          }
        }
      }
      leaf burst-interval {
        tailf:info
          "Burst interval";
        type uint16 {
          tailf:info
            "<30-15000>;;Burst interval (msec)";
          range "30..15000";
        }
      }
      leaf tos-dscp {
        tailf:info
          "TOS DSCP 6-leftmost bits of TOS byte (0-63)";
        type uint8 {
          tailf:info
            "<0-63>;;TOS DSCP";
          range "0..63";
        }
      }
      container protocol {
        tailf:info
          "Probe interval";
        tailf:cli-add-mode;
        tailf:cli-mode-name "config-pm-dm-x-probe-protocol";
        leaf pm-mpls {
          tailf:info
            "SR Policy delay measurement using RFC6374 with MPLS encap";
          type empty;
        }
      }
    }
    container liveness-detection {
      tailf:info
        "Liveness detection";
      tailf:cli-add-mode;
      tailf:cli-mode-name "config-pm-dm-x-live";
      leaf multiplier {
        tailf:info
          "Configure detect multiplier";
        type uint8 {
          tailf:info
            "<2-10>;;Detect Multiplier";
          range "2..10";
        }
      }
    }
  }

  grouping ncs_rpc_notif_ephone-dn-grouping {
    uses ncs_rpc_notif_description-grouping;
    container allow {
      tailf:info
        "allow watcher";
      leaf watch {
        tailf:info
          "allow watcher for presence";
        tailf:cli-no-name-on-delete;
        type empty;
      }
    }
    container caller-id {
      tailf:info
        "Configure port caller id parameters";
      leaf block {
        tailf:info
          "Block the caller id of the calls made from this port";
        type empty;
      }
    }
    container call-forward {
      tailf:info
        "Define E.164 telephone number for call forwarding";
      leaf all {
        tailf:info
          "forward all calls";
        tailf:cli-full-command;
        type string {
          tailf:info
            "WORD;;A sequence of digits";
        }
      }
      container busy {
        tailf:info
          "forward call on busy";
        tailf:cli-compact-syntax;
        tailf:cli-sequence-commands {
          tailf:cli-reset-siblings;
        }
        leaf digits {
          tailf:cli-drop-node-name;
          type string {
            tailf:info
              "WORD;;A sequence of digits";
          }
        }
        leaf forward {
          tailf:cli-drop-node-name;
          type enumeration {
            enum "primary" {
              tailf:info
                "forward to dial-peer created for the primary number";
            }
            enum "secondary" {
              tailf:info
                "forward to dial-peer created for the secondary number";
            }
          }
        }
        leaf dialplan-pattern {
          tailf:info
            "forward to dial-peer created for the dialplan-pattern";
          type empty;
        }
      }
      leaf night-service {
        tailf:info
          "forward call on activated night-service";
        tailf:cli-full-command;
        type string {
          tailf:info
            "WORD;;A sequence of digits";
        }
      }
      container noan {
        tailf:info
          "forward call on no-answer";
        tailf:cli-compact-syntax;
        tailf:cli-sequence-commands {
          tailf:cli-reset-siblings;
        }
        leaf digits {
          tailf:cli-drop-node-name;
          type string {
            tailf:info
              "WORD;;A sequence of digits - representing E.164 number";
          }
        }
        leaf timeout {
          tailf:info
            "Ringing no answer timeout duration";
          type uint16 {
            tailf:info
              "<3-60000>;;Ringing no answer timeout duration in seconds";
          }
        }
      }
    }
    container corlist {
      tailf:info
        "Class of Restriction on dial-peer for this dn";
      leaf incoming {
        tailf:info
          "incoming class of restriction list";
        tailf:cli-no-value-on-delete;
        tailf:non-strict-leafref {
          path "../../../dial-peer/cor/list/name";
        }
        type string {
          tailf:info
            "WORD;;cor list name";
        }
      }
      leaf outgoing {
        tailf:info
          "outgoing class of restriction list";
        tailf:cli-no-value-on-delete;
        tailf:non-strict-leafref {
          path "../../../dial-peer/cor/list/name";
        }
        type string {
          tailf:info
            "WORD;;cor list name";
        }
      }
    }
    container hold-alert {
      tailf:info
        "Set Call On-Hold timeout alert parameters";
      tailf:cli-compact-syntax;
      tailf:cli-sequence-commands {
        tailf:cli-reset-all-siblings;
      }
      leaf timeout {
        tailf:cli-drop-node-name;
        tailf:cli-no-value-on-delete;
        type uint16 {
          tailf:info
            "<15-300>;;call on-hold timeout in seconds";
        }
      }
      leaf type {
        tailf:cli-drop-node-name;
        tailf:cli-break-sequence-commands;
        tailf:cli-no-value-on-delete;
        type enumeration {
          enum "idle" {
            tailf:info
              "alert on-hold originator only if idle";
          }
          enum "originator" {
            tailf:info
              "alert on-hold originator always";
          }
          enum "shared" {
            tailf:info
              "alert all phones that share the line";
          }
          enum "shared-idle" {
            tailf:info
              "alert all idle phones that share the line";
          }
        }
      }
    }
    container translation-profile {
      tailf:info
        "Translation profile";
      leaf incoming {
        tailf:info
          "Translation Profile for incoming call leg";
        // NCS drop tailf-common:non-strict-leafref statement
        type string {
          tailf:info
            "WORD;;Profile name";
        }
      }
      leaf outgoing {
        tailf:info
          "Translation Profile for outgoing call leg";
        // NCS drop tailf-common:non-strict-leafref statement
        type string {
          tailf:info
            "WORD;;Profile name";
        }
      }
    }
  }

  grouping ncs_rpc_notif_ephone-grouping {
    uses ncs_rpc_notif_description-grouping;
    container conference {
      tailf:info
        "Adhoc hardware conference configuration";
      container drop-mode {
        tailf:info
          "Adhoc hardware conference drop mode.  Default is never drop.";
        tailf:cli-reset-container;
        tailf:cli-delete-when-empty;
        presence "true";
        leaf creator {
          tailf:info
            "The active conference terminates when the conference creator hangs up.";
          type empty;
        }
        leaf local {
          tailf:info
            "The active conference terminates when the last local party in the conference hangs up or drops out of the conference.";
          type empty;
        }
      }
      container add-mode {
        tailf:info
          " Adhoc hardware conference add mode.";
        tailf:cli-reset-container;
        tailf:cli-delete-when-empty;
        presence "true";
        leaf creator {
          tailf:info
            "Allow add party by creator only";
          type empty;
        }
      }
      leaf admin {
        tailf:info
          "Adhoc/Meetme hardware conference admin.";
        type empty;
      }
    }
    leaf max-calls-per-button {
      tailf:info
        "Define maximum number of calls per octo-line button of this ephone";
      type uint8 {
        tailf:info
          "<1-8>;;Maximum number of calls supported per octo-line button";
        range "1..8";
      }
    }
    leaf busy-trigger-per-button {
      tailf:info
        "Define the number of calls that triggers call forward busy per octo-line button of this ephone";
      type uint8 {
        tailf:info
          "<1-8>;;The number of calls that triggers call forward busy per octo-line button";
        range "1..8";
      }
    }
    list fastdial {
      tailf:info
        "Define ip-phone fastdial number";
      tailf:cli-suppress-mode;
      tailf:cli-delete-when-empty;
      tailf:cli-compact-syntax;
      tailf:cli-sequence-commands {
        tailf:cli-reset-siblings;
      }
      tailf:cli-incomplete-command;
      key "tag";
      leaf tag {
        type uint8 {
          tailf:info
            "<1-100>;;fast-dial entry tag";
        }
      }
      leaf phone-number {
        tailf:cli-drop-node-name;
        tailf:cli-no-value-on-delete;
        type string {
          tailf:info
            "WORD;;fast-dial phone number";
        }
      }
      leaf name {
        tailf:info
          "Define a text name for the fast dial";
        tailf:cli-multi-value;
        tailf:cli-preformatted;
        tailf:cli-full-command;
        tailf:cli-no-name-on-delete;
        tailf:cli-no-value-on-delete;
        type string {
          tailf:info
            "LINE;;fast-dial name, no quotes required";
        }
      }
    }
    list speed-dial {
      tailf:info
        "Define ip-phone speed-dial number";
      tailf:cli-suppress-mode;
      tailf:cli-delete-when-empty;
      tailf:cli-compact-syntax;
      tailf:cli-sequence-commands {
        tailf:cli-reset-siblings;
      }
      tailf:cli-incomplete-command;
      key "tag";
      leaf tag {
        type string {
          tailf:info
            "<1-75>;;Speed-dial string tag";
        }
      }
      leaf phone-number {
        tailf:cli-drop-node-name;
        tailf:cli-no-value-on-delete;
        type uint64 {
          tailf:info
            "WORD;;Speed-dial phone number";
        }
      }
      leaf label {
        tailf:info
          "Define a text label for the speed dial";
        tailf:cli-no-name-on-delete;
        tailf:cli-no-value-on-delete;
        type string {
          tailf:info
            "WORD;;Speed-dial text label, use quoted string if including spaces";
        }
      }
    }
    container type {
      tailf:info
        "Define ip-phone type";
      tailf:cli-compact-syntax;
      tailf:cli-sequence-commands {
        tailf:cli-reset-all-siblings;
      }
      leaf ip-phone-module {
        tailf:cli-drop-node-name;
        tailf:cli-break-sequence-commands;
        type string {
          tailf:info
            "WORD;;ip phone module";
        }
      }
      container addon {
        tailf:info
          "Define ip-phone addon module";
        tailf:cli-flatten-container;
        tailf:cli-compact-syntax;
        tailf:cli-sequence-commands;
        leaf module-number-1 {
          tailf:alt-name "1";
          tailf:info
            "addon module number";
          tailf:cli-no-name-on-delete;
          tailf:cli-no-value-on-delete;
          type string {
            tailf:info
              "Cisco IP Phone ABCD XY-Button Line Expansion Module";
          }
        }
        leaf module-number-2 {
          tailf:alt-name "2";
          tailf:info
            "addon module number";
          tailf:cli-no-name-on-delete;
          tailf:cli-no-value-on-delete;
          type string {
            tailf:info
              "Cisco IP Phone ABCD XY-Button Line Expansion Module";
          }
        }
      }
    }
    container paging-dn {
      tailf:info
        "set audio paging dn group for phone";
      tailf:cli-reset-container;
      tailf:cli-delete-when-empty;
      presence "true";
      leaf ephone-dn-tag {
        tailf:cli-drop-node-name;
        tailf:cli-no-value-on-delete;
        tailf:non-strict-leafref {
          path "../../../ephone-dn/tag";
        }
        type uint16 {
          tailf:info
            "<1-1200>;;ephone-dn tag used for paging number";
        }
      }
    }
    container night-service {
      tailf:info
        "Define night-service bell";
      leaf bell {
        tailf:info
          "night-service bell";
        type empty;
      }
    }
  }

  grouping ncs_rpc_notif_time-range-abs-grouping {
    leaf time {
      tailf:cli-drop-node-name;
      tailf:cli-incomplete-command;
      type ncs_rpc_notif_hhmm-type;
    }
    leaf date {
      tailf:cli-drop-node-name;
      tailf:cli-incomplete-command;
      type uint8 {
        tailf:info
          "<1-31>;;Day of the month";
        range "1..31";
      }
    }
    leaf month {
      tailf:cli-drop-node-name;
      tailf:cli-incomplete-command;
      type ncs_rpc_notif_month-full-type;
    }
    leaf year {
      tailf:cli-drop-node-name;
      type uint16 {
        tailf:info
          "<1993-2035>;;Year";
        range "1993..2035";
      }
    }
  }

  grouping ncs_rpc_notif_privilege-level-grouping {
    list level {
      tailf:info
        "Set privilege level of command";
      tailf:cli-suppress-mode;
      tailf:cli-delete-when-empty;
      tailf:cli-compact-syntax;
      tailf:cli-incomplete-command;
      tailf:cli-incomplete-no;
      tailf:cli-no-key-completion;
      key "privilege";
      leaf privilege {
        tailf:cli-incomplete-no;
        tailf:cli-suppress-range;
        type uint8 {
          tailf:info
            "<0-15>;;Privilege level";
          range "0..15";
        }
      }
      list command-list {
        tailf:cli-drop-node-name;
        tailf:cli-suppress-mode;
        tailf:cli-delete-when-empty;
        tailf:cli-no-key-completion;
        tailf:cli-suppress-key-abbreviation;
        tailf:cli-no-match-completion;
        key "command";
        leaf command {
          tailf:cli-multi-word-key;
          tailf:cli-suppress-range;
          type string {
            tailf:info
              "LINE;;Initial keywords of the command to modify";
          }
        }
      }
    }
  }

  grouping ncs_rpc_notif_srte-perf-meas-grouping {
    container performance-measurement {
      tailf:info
        "Performance Measurement configuration";
      tailf:cli-add-mode;
      tailf:cli-mode-name "config-srte-x-perf-meas";
      container delay-measurement {
        tailf:info
          "Enable delay measurement for active candidate-path";
        tailf:cli-add-mode;
        tailf:cli-mode-name "config-srte-x-delay-meas";
        presence "true";
        leaf profile {
          tailf:info
            "SR Policy delay Profile name";
          type string {
            tailf:info
              "WORD;;Profile name";
          }
        }
        container liveness-detection {
          tailf:info
            "Action to be taken when PM liveness session is invalidated";
          tailf:cli-add-mode;
          tailf:cli-mode-name "config-srte-x-pm-live";
          presence "true";
          leaf invalidation-action {
            tailf:info
              "Action to be taken when PM liveness session is invalidated";
            type enumeration {
              enum "down" {
                tailf:info
                  "LSP can only be operationally up if the PM liveness session is up";
              }
              enum "none" {
                tailf:info
                  "PM liveness session state does not affect LSP state, use for diagnostic purposes";
              }
            }
          }
        }
        container reverse-path {
          tailf:info
            "Specify parameters about the reverse path back to the head-en";
          tailf:cli-add-mode;
          tailf:cli-mode-name "config-srte-x-pm-reversep";
          leaf label {
            tailf:info
              "DM packets return to head-end using a label";
            type uint32 {
              tailf:info
                "<16-1048575>;;Reverse path label";
              range "16..1048575";
            }
          }
        }
      }
    }
  }

  grouping description-grouping {
    leaf description {
      tailf:info
        "Description text";
      tailf:cli-multi-value;
      tailf:cli-preformatted;
      tailf:cli-full-command;
      type string {
        tailf:info
          "LINE;;Description";
      }
    }
  }

  grouping description-quote-grouping {
    leaf description {
      tailf:info
        "Description text";
      tailf:cli-no-value-on-delete;
      tailf:cli-full-command;
      type string {
        tailf:info
          "LINE;;Description";
      }
    }
  }

  grouping password-grouping {
    leaf type {
      tailf:cli-drop-node-name;
      tailf:cli-optional-in-sequence;
      tailf:cli-incomplete-command;
      type enumeration {
        enum "0" {
          tailf:info
            "Specifies an UNENCRYPTED password/key will follow";
        }
        enum "5" {
          tailf:info
            "Specifies a HIDDEN key will follow";
        }
        enum "6" {
          tailf:info
            "Specifies ENCRYPTED key will follow";
        }
        enum "7" {
          tailf:info
            "Specifies a HIDDEN password/key will follow";
        }
      }
    }
    leaf secret {
      tailf:cli-drop-node-name;
      tailf:cli-reset-container;
      tailf:cli-disallow-value "0|5|6|7|key-chain";
      ios:password-quote-input " 6 <STRING>";
      type string {
        tailf:info
          "LINE;;The UNENCRYPTED (cleartext) password/key";
      }
    }
  }

  grouping crypto-key-grouping {
    leaf encryption {
      tailf:cli-drop-node-name;
      tailf:cli-optional-in-sequence;
      tailf:cli-incomplete-command;
      type enumeration {
        enum "0" {
          tailf:info
            "Specifies an UNENCRYPTED password will follow";
        }
        enum "6" {
          tailf:info
            "Specifies an ENCRYPTED password will follow";
        }
        enum "7" {
          tailf:info
            "Specifies an HIDDEN password will follow";
        }
      }
    }
    leaf secret {
      tailf:cli-drop-node-name;
      tailf:cli-reset-container;
      tailf:cli-disallow-value "0|6|7";
      ios:password-quote-input " 6 <STRING>";
      type string {
        tailf:info
          "LINE;;The UNENCRYPTED (cleartext) user password";
      }
    }
  }

