          }
        }
        container ipv6 {
          tailf:info
            "IPv6 specific commands";
          container route {
            tailf:info
              "ISIS IPV6 routes";
            container priority {
              tailf:info
                "Assign priority to IPV6 prefixes";
              container high {
                tailf:info
                  "Assign high priority to important IPV6 prefixes in ISIS IPV6 local RIB";
