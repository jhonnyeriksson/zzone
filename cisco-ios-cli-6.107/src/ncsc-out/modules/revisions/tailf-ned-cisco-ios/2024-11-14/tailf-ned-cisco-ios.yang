          }
          list Te {
            tailf:info
              "Ten Gigabit Ethernet";
            tailf:cli-allow-join-with-key {
              tailf:cli-display-joined;
            }
            tailf:cli-mode-name "config-rpd-core";
            key "name";
            leaf name {
              type string {
                tailf:info
                  "WORD;;TenGigabitEthernet interface number";
                pattern '[0-9]+.*';
              }
