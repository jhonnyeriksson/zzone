              container limit {
                tailf:info
                  "DHCP Snooping limit";
                leaf rate {
                  tailf:info
                    "DHCP Snooping limit";
                  type uint16 {
                    tailf:info
                      "<1-2048>;;DHCP snooping rate limit";
                    range "1..2048";
                  }
                }
