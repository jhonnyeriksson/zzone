                  tailf:info
                    "pool prefix length";
                  tailf:cli-incomplete-command;
                  type uint8 {
                    tailf:info
                      "<8-24>;;v4 pool prefix length";
                    range "8..24";
                  }
                }
                leaf network-prefix {
                  tailf:info
                    "mobile network prefix length";
                  type uint8 {
                    tailf:info
                      "<8-32>;;v4 network prefix length";
                    range "8..32";
                  }
                }
              }
            }
          }
