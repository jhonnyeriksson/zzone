              case seconds {
                leaf seconds {
                  tailf:cli-drop-node-name;
                  type uint16 {
                    tailf:info
                      "<4-65535>;;RA Interval (sec). Default 200";
                    range "4..65535";
                  }
                  default "200";
                }
                leaf seconds-interval {
                  tailf:cli-drop-node-name;
                  type uint16 {
                    tailf:info
                      "<3-49151>;;Minimum interval (seconds)";
                    range "3..49151";
                  }
                }
              }
              case msec {
                leaf msec {
                  tailf:info
                    "Interval in milliseconds";
                  type uint32 {
                    tailf:info
                      "<70-65535000>;;RA Interval (msec)";
                    range "70..65535000";
                  }
                }
                leaf msec-interval {
                  tailf:cli-drop-node-name;
                  type uint32 {
                    tailf:info
                      "<30-6201577>;;Minimum interval (milliseconds)";
                    range "30..6201577";
                  }
                }
              }
            }
          }
          leaf lifetime {
            tailf:info
              "Set IPv6 Router Advertisement Lifetime";
            type uint16 {
              tailf:info
                "<0-9000>;;RA Lifetime (seconds). Default 1800";
              range "0..9000";
            }
            default "1800";
          }
          container dns {
            tailf:info
              "DNS";
            list server {
              tailf:info
                "DNS Server";
              tailf:cli-suppress-mode;
              tailf:cli-delete-when-empty;
