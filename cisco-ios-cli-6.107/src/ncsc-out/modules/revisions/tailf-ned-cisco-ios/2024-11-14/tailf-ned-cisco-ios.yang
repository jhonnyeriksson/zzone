            tailf:cli-drop-node-name;
            type string;
          }
          uses ncs_template_bandwidth-remaining-account-grouping;
        }
      }
    }
    container compress {
      container header {
        container ip {
          presence "true";
          leaf protocol {
            tailf:cli-drop-node-name;
            type string;
          }
        }
      }
    }
    leaf dbl {
      type empty;
    }
    container estimate {
      container bandwidth {
        presence "true";
        container delay-one-in {
          leaf doi {
            tailf:cli-drop-node-name;
            type string;
          }
          leaf milliseconds {
            type string;
          }
        }
        leaf drop-one-in {
          type string;
        }
      }
