  typedef ncs_rpc_notif_percentage-type {
    type uint8 {
      tailf:info
        "<1-100>;;Percentage";
      range "1..100";
    }
  }

  typedef ncs_rpc_notif_ppp-auth-method {
    type enumeration {
      enum "chap" {
        tailf:info
          "Challenge Handshake Authentication Protocol (CHAP)";
      }
      enum "eap" {
        tailf:info
          "Extensible Authentication Protocol (EAP)";
      }
      enum "ms-chap" {
        tailf:info
          "Microsoft Challenge Handshake Authentication Protocol (MS-CHAP)";
      }
      enum "ms-chap-v2" {
        tailf:info
          "Microsoft CHAP Version 2 (MS-CHAP-V2)";
      }
      enum "pap" {
        tailf:info
          "Password Authentication Protocol (PAP)";
      }
    }
  }

  typedef ncs_rpc_notif_mac-address-type {
    type string {
      tailf:info
        "H.H.H;;MAC address";
      pattern '[0-9a-fA-F]+\.[0-9a-fA-F]+\.[0-9a-fA-F]+';
    }
  }

  typedef ncs_rpc_notif_ios-ipv6-address {
    type string {
      pattern '((:|[0-9a-fA-F]{0,4}):)([0-9a-fA-F]{0,4}:){0,5}((([0-9a-fA-F]{0,4}:)?(:|[0-9a-fA-F]{0,4}))|(((25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])))(%.+)?';
      pattern '(([^:]+:){6}(([^:]+:[^:]+)|(.*\..*)))|((([^:]+:)*[^:]+)?::(([^:]+:)*[^:]+)?)(%.+)?';
    }
  }

  typedef ncs_rpc_notif_all-address {
    type union {
      type inet:ipv4-address {
        tailf:info
          "A.B.C.D;;IPv4 address";
      }
      type inet:ipv6-address {
        tailf:info
          "X:X:X:X::X;;IPv6 address";
      }
      type ncs_rpc_notif_ios-ipv6-address;
    }
  }

  typedef ncs_rpc_notif_ipv4-prefix {
    type tailf:ipv4-address-and-prefix-length;
  }

  typedef ncs_rpc_notif_ipv6-prefix {
    type tailf:ipv6-address-and-prefix-length;
  }

  typedef ncs_rpc_notif_rd-type {
    type string {
      tailf:info
        "ASN:nn or IP-address:nn;;VPN Route Distinguisher";
      pattern '(\d*(.\d*)*)?:(\d*(.\d*)*)?';
    }
  }

  typedef ncs_rpc_notif_vpn-id-type {
    type string {
      tailf:info
        "OUI:VPN-Index;;, format (hex) <3 bytes OUI:4 bytes VPN_Index>";
      pattern '[0-9a-fA-F]{1,6}:[0-9a-fA-F]{1,8}';
    }
  }

  typedef ncs_rpc_notif_asn-ip-type {
    type string {
      tailf:info
        "ASN:nn or IP-address:nn";
      pattern '(([0-9]+)|((([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])\.){3}([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5]))):[0-9]+';
    }
  }

  typedef ncs_rpc_notif_hhmm-type {
    type string {
      pattern '([0-1]?[0-9]|2[0-4]):([0-5][0-9])(:[0-5][0-9])?';
    }
  }

  typedef ncs_rpc_notif_weekday-type {
    type enumeration {
      enum "Mon";
      enum "Tue";
      enum "Wed";
      enum "Thu";
      enum "Fri";
      enum "Sat";
      enum "Sun";
    }
  }

  typedef ncs_rpc_notif_month-type {
