                enum "conference" {
                  tailf:info
                    "Configure conference join/leave tone";
                }
                enum "disconnect" {
                  tailf:info
                    "Configure disconnect dualtone";
                }
                enum "number-unobtainable" {
                  tailf:info
                    "Configure number-unobtainable dualtone";
                }
                enum "out-of-service" {
                  tailf:info
                    "Configure out-of-service dualtone";
                }
                enum "reorder" {
                  tailf:info
                    "Configure reorder/congestion dualtone";
                }
                enum "ringback" {
                  tailf:info
