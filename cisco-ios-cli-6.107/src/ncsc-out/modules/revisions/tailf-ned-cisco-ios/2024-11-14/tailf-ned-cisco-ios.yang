            tailf:cli-suppress-range;
            type string {
              tailf:info
                "WORD;;Create named local prefix pool";
            }
          }
          leaf prefix {
            tailf:cli-drop-node-name;
            tailf:cli-remove-before-change;
            tailf:cli-incomplete-command;
            type ipv6-prefix {
              tailf:info
                "X:X:X:X::X/<0-128>;;IPv6 pool prefix x:x::y/<z>";
            }
          }
          leaf assigned-length {
            tailf:cli-drop-node-name;
            type uint8 {
              tailf:info
                "<0-128>;;Prefix length to assign from pool";
            }
          }
          leaf shared {
            tailf:info
              "Advertise the same prefix";
            tailf:cli-optional-in-sequence;
            type empty;
          }
          leaf cache-size {
            tailf:info
              "Number of free entries to search";
            type uint16;
          }
        }
      }
      container dhcp {
        tailf:info
          "Configure IPv6 DHCP";
        tailf:cli-diff-set-after "../local" {
          tailf:xpath-root 3;
          tailf:cli-when-target-set;
        }
        tailf:cli-diff-delete-before "../local" {
          tailf:xpath-root 3;
          tailf:cli-when-target-delete;
        }
        container binding {
          tailf:info
            "Configure IPv6 DHCP binding parameters";
          container track {
            tailf:info
              "Track bindings associated with a virtual interface";
            leaf ppp {
              tailf:info
                "Clear bindings when PPP session goes down";
              type empty;
            }
          }
        }
        list pool {
          tailf:info
            "Configure IPv6 DHCP pool";
          tailf:cli-mode-name "config-dhcpv6";
          tailf:cli-full-command;
          key "name";
          leaf name {
            type string {
              tailf:info
                "WORD;;DHCP pool name";
            }
          }
          leaf vrf {
            tailf:info
              "Associate pool with a VRF";
            tailf:cli-full-command;
            type string {
              tailf:info
                "WORD;;VRF name";
            }
          }
          list address {
            tailf:info
              "IPv6 address allocation";
            tailf:cli-suppress-mode;
            tailf:cli-delete-when-empty;
            tailf:cli-show-long-obu-diffs;
            ordered-by user;
            key "prefix";
            leaf prefix {
              tailf:info
                "IPv6 address allocation prefix";
              tailf:cli-expose-key-name;
              type ios:ipv6-prefix {
                tailf:info
                  "X:X:X:X::X/<0-128>;;IPv6  x:x::y/<z>";
              }
            }
          }
          list dns-server {
            tailf:info
              "DNS servers";
            tailf:cli-suppress-mode;
            tailf:cli-delete-when-empty;
            tailf:cli-show-long-obu-diffs;
            ordered-by user;
            key "address";
            leaf address {
              type inet:host {
                tailf:info
                  "Hostname or X:X:X:X::X;;Server's name or IPv6 address";
              }
            }
          }
          list domain-name {
            tailf:info
              "Domain name to complete unqualified host names";
            tailf:cli-suppress-mode;
            tailf:cli-delete-when-empty;
            tailf:cli-show-long-obu-diffs;
            ordered-by user;
            key "name";
            leaf name {
              type string {
                tailf:info
                  "WORD;;A domain name";
              }
            }
          }
          container prefix-delegation {
            tailf:info
              "IPv6 prefix delegation";
            container aaa {
              tailf:info
                "Acquire prefix from AAA";
              tailf:cli-compact-syntax;
              tailf:cli-sequence-commands {
                tailf:cli-reset-siblings;
              }
              tailf:cli-delete-when-empty;
              presence "true";
              leaf method-list {
                tailf:info
                  "Specify AAA authorization method list";
                type string {
                  tailf:info
                    "AAA authorization method list name";
                }
              }
              container lifetime {
                tailf:info
                  "Configure prefix lifetimes";
                tailf:cli-flatten-container;
                tailf:cli-compact-syntax;
                tailf:cli-sequence-commands {
                  tailf:cli-reset-siblings;
                }
                leaf valid-lifetime-seconds {
                  tailf:cli-drop-node-name;
                  tailf:cli-incomplete-command;
                  type uint32 {
                    tailf:info
                      "<60-4294967295>;;Valid lifetime (seconds)";
                  }
                }
                leaf preferred-lifetime-seconds {
                  tailf:cli-drop-node-name;
                  type uint32 {
                    tailf:info
                      "<60-4294967295>;;Preferred lifetime (seconds)";
                  }
                }
              }
            }
            container pool {
              tailf:info
                "IPv6 prefix pool";
              tailf:cli-compact-syntax;
              tailf:cli-sequence-commands {
                tailf:cli-reset-siblings;
              }
              tailf:cli-diff-delete-before "../aaa" {
                tailf:xpath-root 3;
              }
              leaf poolname {
                tailf:cli-drop-node-name;
                type string {
                  tailf:info
                    "WORD;;IPv6 prefix pool";
                }
              }
              container lifetime {
                tailf:info
                  "Configure prefix lifetimes";
                tailf:cli-flatten-container;
                tailf:cli-compact-syntax;
                tailf:cli-sequence-commands {
                  tailf:cli-reset-siblings;
                }
                leaf valid-lifetime-seconds {
                  tailf:cli-drop-node-name;
                  tailf:cli-incomplete-command;
                  type uint32 {
                    tailf:info
                      "<60-4294967295>;;Valid lifetime (seconds)";
                  }
                }
                leaf preferred-lifetime-seconds {
                  tailf:cli-drop-node-name;
                  type uint32 {
                    tailf:info
                      "<60-4294967295>;;Preferred lifetime (seconds)";
                  }
                }
              }
            }
          }
        }
        container guard {
          tailf:info
            "Configure IPv6 DHCP guard";
          list policy {
            tailf:info
              "Configure a policy for feature dhcp guard";
            tailf:cli-mode-name "config-dhcp-guard";
            key "name";
            leaf name {
              type string {
                tailf:info
                  "WORD;;Name of the dhcp guard policy";
              }
            }
            choice port-choice {
              case a {
                leaf device-role {
                  tailf:info
                    "Sets the role of the device attached to the port";
                  type enumeration {
                    enum "client" {
                      tailf:info
                        "Attached device is a client (default)";
                    }
                    enum "server" {
                      tailf:info
                        "Attached device is a dhcp server";
                    }
                  }
                  default "client";
                }
                container match {
                  tailf:info
                    "dhcp filtering";
                  tailf:cli-diff-set-after "../device-role" {
                    tailf:xpath-root 3;
                    tailf:cli-when-target-set;
                  }
                  tailf:cli-diff-delete-before "../device-role" {
                    tailf:xpath-root 3;
                    tailf:cli-when-target-delete;
                  }
                  container server {
                    tailf:info
                      "permitted server source addresses";
                    leaf access-list {
                      tailf:info
                        "specify access-list for match";
                      tailf:non-strict-leafref {
                        path "../../../../../../access-list/named-acl/name";
                      }
                      type string {
                        tailf:info
                          "WORD;;access-list";
                      }
                    }
                  }
                  container reply {
                    tailf:info
                      "premitted server reply prefixes";
                    leaf prefix-list {
                      tailf:info
                        "specify prefix-list for match";
                      tailf:non-strict-leafref {
                        path "../../../../../../prefix-list/prefixes/name";
                      }
                      type string {
                        tailf:info
                          "WORD;;prefix-list";
                      }
                    }
                  }
                }
              }
              case b {
                leaf trusted-port {
                  tailf:info
                    "This is a trusted port (no policing)";
                  type empty;
                }
              }
            }
          }
        }
      }
      container dhcp-relay {
        tailf:info
          "Configure IPv6 DHCP relay agent";
        container bulk-lease {
          tailf:info
            "Configure IPv6 DHCP Bulk Lease Query";
          leaf disable {
            tailf:info
              "Disable bulk lease query";
            type empty;
          }
        }
      }
      container rip {
        tailf:info
          "Configure ipv6 RIP settings";
        container vrf-mode {
          tailf:info
            "Enable RIPng VRF support";
          leaf enable {
            tailf:info
              "Enable RIPng VRF support";
            type empty;
          }
        }
      }
      container mobile {
        tailf:info
          "Mobile IPv6";
        list pmipv6-domain {
          tailf:info
            "PMIPv6 Domain";
          tailf:cli-mode-name "config-ipv6-pmipv6-domain";
          max-elements 1;
          key "name";
          leaf name {
            type string {
              tailf:info
                "WORD;;Domain name";
            }
          }
          container replay-protection {
            tailf:info
              "Configure replay proection mechanism within domain";
            container timestamp {
              tailf:info
                "timestamp option";
              leaf window {
                tailf:info
                  "configure the window value";
                type uint8 {
                  tailf:info
                    "<3-255>;;window value";
                }
              }
            }
          }
          leaf encap {
            tailf:info
              "encapsulation type between MAG and LMA";
            type enumeration {
              enum "gre-ipv4" {
                tailf:info
                  "GRE in V4 encapsulation";
              }
              enum "gre-ipv6" {
                tailf:info
                  "GRE n V6 encapsulation";
              }
              enum "ipv6-in-ipv6" {
                tailf:info
                  "V6 in V6 encapsulation";
              }
              enum "udptunnel" {
                tailf:info
                  "UDP tunneling";
              }
            }
          }
          list lma {
            tailf:info
              "LMA with in the domain";
            tailf:cli-mode-name "config-ipv6-pmipv6-domain-lma";
            key "name";
            leaf name {
              type string {
                tailf:info
                  "WORD;;LMA identifier";
              }
