            container detect {
              tailf:info
                "detection enhancement keyword";
              tailf:cli-incomplete-command;
              container cisco-phone {
                tailf:info
                  "Cisco IP phone";
                presence "true";
                leaf full-duplex {
                  tailf:info
                    "full duplex keyword";
                  type empty;
                }
