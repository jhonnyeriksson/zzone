        list pmipv6-mag {
          tailf:info
            "PMIPv6 MAG";
          tailf:cli-mode-name "config-ipv6-pmipv6-mag";
          key "name domain";
          leaf name {
            type string {
              tailf:info
                "WORD;;MAG name";
            }
          }
          leaf domain {
            tailf:info
              "PMIPv6 Domain for this MAG";
            tailf:cli-expose-key-name;
            type string {
              tailf:info
                "WORD;;Domain name";
            }
          }
          container tunnel-template {
            tailf:info
              "Configure a tunnel template for tunnels to the LMA";
            leaf Tunnel {
              tailf:info
                "Tunnel interface";
              tailf:cli-allow-join-with-value {
                tailf:cli-display-joined;
              }
              tailf:non-strict-leafref {
                path "/ncs:devices/ncs:device/ncs:config/ios:interface/Tunnel/name" {
                  tailf:xpath-root 3;
                }
              }
              type uint32 {
                tailf:info
                  "<0-2147483647>;;Tunnel interface number";
              }
            }
          }
          uses ipv6-mobile-pmipv6-mag-lma-grouping;
          container address {
            tailf:info
              "Specifies MAG's ipv4 and ipv6 address";
            choice address-choice {
              leaf ipv4 {
                tailf:info
                  "MAG's ipv4 address";
                type inet:ipv4-address {
                  tailf:info
                    "A.B.C.D;;IPv4 address";
                }
              }
              container dynamic {
                tailf:info
                  "Dynamic COA for MAG";
                tailf:cli-add-mode;
                tailf:cli-mode-name "config-ipv6-pmipv6mag-addr-dyn";
                presence "true";
                container roaming {
                  tailf:info
                    "specify the roaming interface for this MAG";
                  list interface {
                    tailf:info
                      "roaming interface";
                    tailf:cli-suppress-mode;
                    tailf:cli-delete-when-empty;
                    tailf:cli-compact-syntax;
                    tailf:cli-sequence-commands {
                      tailf:cli-reset-siblings;
                    }
                    key "name";
                    leaf name {
                      tailf:cli-diff-set-after "/ios:interface" {
                        tailf:xpath-root 3;
                        tailf:cli-when-target-set;
                      }
                      tailf:cli-diff-delete-before "/ios:interface" {
                        tailf:xpath-root 3;
                        tailf:cli-when-target-delete;
                      }
                      type string {
                        tailf:info
                          "WORD;;Interface name";
                      }
                    }
                    leaf egress-interface {
                      tailf:info
                        "tunnel egress interface";
                      tailf:cli-diff-set-after "/ios:interface" {
                        tailf:xpath-root 3;
                        tailf:cli-when-target-set;
                      }
                      tailf:cli-diff-delete-before "/ios:interface" {
                        tailf:xpath-root 3;
                        tailf:cli-when-target-delete;
                      }
                      tailf:cli-incomplete-command;
                      type string {
                        tailf:info
                          "WORD;;Interface name";
                      }
                    }
                    leaf priority {
                      tailf:info
                        "priority for this interface";
                      tailf:cli-incomplete-command;
                      type uint8 {
                        tailf:info
                          "<1-100>;;specify priority value (higher number is higher priority)";
                        range "1..100";
                      }
                    }
                    leaf egress-att {
                      tailf:info
                        "Access Technology Type of this interface";
                      tailf:cli-incomplete-command;
                      type enumeration {
                        enum "3G" {
                          tailf:info
                            "att as 3g";
                        }
                        enum "ETHERNET" {
                          tailf:info
                            "att as ethernet";
                        }
                        enum "LTE" {
                          tailf:info
                            "att as lte";
                        }
                        enum "WLAN" {
                          tailf:info
                            "att as wireless lan";
                        }
                      }
                    }
                    leaf label {
                      tailf:info
                        "Label for this interface";
                      type string {
                        tailf:info
                          "WORD;;LABEL string";
                      }
                    }
                  }
                }
              }
            }
          }
          list interface {
            tailf:info
              "Configure MAG enabled interfaces";
            tailf:cli-mode-name "config-ipv6-pmipv6mag-intf";
            key "name";
            leaf name {
              tailf:cli-diff-set-after "/ios:interface" {
