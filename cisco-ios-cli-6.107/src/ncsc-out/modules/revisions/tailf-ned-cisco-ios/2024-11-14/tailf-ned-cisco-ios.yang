              enum "include-all" {
                tailf:info
                  "Enter include-all mode";
              }
              enum "include-any" {
                tailf:info
                  "Affinity attributes to include";
              }
            }
          }
          list name {
            tailf:info
              "Affinity color name";
            tailf:cli-suppress-mode;
            tailf:cli-delete-when-empty;
            key "name";
