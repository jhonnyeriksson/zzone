              type uint8 {
                tailf:info
                  "<0-255>;;Send identifier";
                range "0..255";
              }
            }
            leaf recv-id {
              tailf:info
                "Configure a receive id";
              type uint8 {
                tailf:info
                  "<0-255>;;Send identifier";
                range "0..255";
              }
            }
            leaf cryptographic-algorithm {
