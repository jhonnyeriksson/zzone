            tailf:cli-allow-join-with-key;
            tailf:cli-suppress-mode;
            tailf:cli-delete-when-empty;
            tailf:cli-diff-delete-after "../sg-channel" {
              tailf:xpath-root 3;
            }
            key "name";
            leaf name {
              type string {
                tailf:info
                  "<slot>/<card>/<port>;;Enter slot/subslot/bay";
              }
            }
            leaf rf-channel {
              tailf:info
                "RF channel";
              type string {
                tailf:info
                  "<grouplist>;;List of port numbers and number ranges";
              }
            }
          }
          list Integrated-Cable {
            tailf:info
              "Integrated cable";
            tailf:cli-allow-join-with-key;
            tailf:cli-suppress-mode;
            tailf:cli-delete-when-empty;
            tailf:cli-diff-delete-after "../sg-channel" {
              tailf:xpath-root 3;
            }
            key "name";
            leaf name {
              type string {
                tailf:info
                  "<slot>/<card>/<port>;;Enter slot/subslot/bay";
              }
            }
            leaf rf-channel {
              tailf:info
                "RF channel";
              type string {
                tailf:info
                  "<grouplist>;;List of port numbers and number ranges";
              }
            }
          }
          list sg-channel {
            tailf:info
