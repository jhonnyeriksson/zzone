              }
            }
          }
          container dns {
            tailf:info
              "DNS classification";
            container learning {
              tailf:info
                "DNS learning";
              leaf guard {
                tailf:info
                  "DNS guard prevents learning from responses only";
                type empty;
              }
            }
          }
        }
        list custom {
          tailf:info
            "Custom PDL (protocol description language) Module";
          tailf:cli-suppress-mode;
          tailf:cli-delete-when-empty;
          tailf:cli-incomplete-command;
          key "name";
          leaf name {
            type string {
              tailf:info
                "WORD;;Name of the User defined Protocol";
            }
          }
          list ports {
            tailf:cli-drop-node-name;
            tailf:cli-suppress-mode;
            tailf:cli-delete-when-empty;
            tailf:cli-compact-syntax;
            tailf:cli-sequence-commands {
              tailf:cli-reset-siblings;
            }
            tailf:cli-incomplete-command;
            tailf:cli-remove-before-change;
            key "name";
            leaf name {
              type enumeration {
                enum "udp" {
                  tailf:info
                    "UDP ports";
                }
                enum "tcp" {
                  tailf:info
                    "TCP ports";
                }
              }
            }
            choice ports-choice {
              container range {
                tailf:info
                  "Range of maximum 1000 Ports";
                tailf:cli-flatten-container;
                tailf:cli-compact-syntax;
                tailf:cli-sequence-commands {
                  tailf:cli-reset-siblings;
                }
                leaf start {
                  tailf:cli-drop-node-name;
                  tailf:cli-incomplete-command;
                  type uint16 {
                    tailf:info
                      "<1-65535>;;Enter Start port number for Range";
                  }
                }
                leaf end {
                  tailf:cli-drop-node-name;
                  type uint16 {
                    tailf:info
                      "<1-65535>;;Enter End port number for Range";
                  }
                }
              }
              leaf-list ports {
                tailf:cli-drop-node-name;
                tailf:cli-range-list-syntax;
                ios:space-flat-list-syntax "ip nbar custom \\S+ (?:udp|tcp) (\\S+)";
                max-elements 16;
                type uint16 {
                  tailf:info
                    "<1-65535>;;Up to 16 port numbers, NSO range-list-syntax (transformed to spaces)";
                  range "1..65535";
                }
              }
            }
            leaf id {
              tailf:info
                "Selector ID";
              type uint16 {
                tailf:info
                  "<1-65535>;;Enter Selector ID";
                range "1..65535";
              }
            }
          }
          container composite {
            tailf:info
              "Custom protocols based on multiple underlying protocols";
            tailf:cli-flatten-container;
            tailf:cli-compact-syntax;
            tailf:cli-sequence-commands {
              tailf:cli-reset-siblings;
            }
            leaf server-name {
              tailf:info
                "Match the server name based on various protocols";
              type string {
                tailf:info
                  "WORD  Enter String Format - cannot exceed 30 characters";
              }
            }
            leaf id {
              tailf:info
                "Selector ID";
              tailf:cli-optional-in-sequence;
              type uint16 {
                tailf:info
                  "<1-65535>;;Enter Selector ID";
                range "1..65535";
              }
            }
            leaf extends {
              tailf:info
                "Extend existing protocol";
              type string {
                tailf:info
                  "WORD;;Protocol Name";
              }
            }
          }
        }
        container custom-transport {
          tailf:cli-drop-node-name;
          list custom {
            tailf:info
              "Custom PDL (protocol description language) Module";
            tailf:cli-mode-name "config-custom";
            tailf:cli-incomplete-command;
            tailf:cli-explicit-exit;
            key "name";
            leaf name {
              type string {
                tailf:info
                  "WORD;;Name of the User defined Protocol";
              }
            }
            leaf transport {
              tailf:info
                "Transport";
              tailf:cli-hide-in-submode;
              type enumeration {
                enum "tcp" {
                  tailf:info
                    "TCP transport";
                }
                enum "udp" {
                  tailf:info
                    "UDP transport";
                }
                enum "udp-tcp" {
                  tailf:info
                    "UDP or TCP transport";
                }
              }
            }
            leaf id {
              tailf:info
                "Selector ID";
              tailf:cli-hide-in-submode;
              type uint16 {
                tailf:info
                  "<1-65535>;;Enter Selector ID";
                range "1..65535";
              }
            }
            container ip {
              tailf:info
                "ip address";
              leaf-list address {
                tailf:info
                  "ip address list";
                tailf:cli-flat-list-syntax;
                tailf:cli-replace-all;
                ordered-by user;
                max-elements 8;
                type inet:ipv4-address {
                  tailf:info
                    "A.B.C.D;;List of up to 8 IPs separated by white-spaces.";
                }
              }
              container subnet {
                tailf:info
                  "Subnet IP/mask length";
                tailf:cli-compact-syntax;
                tailf:cli-sequence-commands {
                  tailf:cli-reset-siblings;
                }
                leaf ip {
                  tailf:cli-drop-node-name;
                  tailf:cli-incomplete-command;
                  type inet:ipv4-address {
                    tailf:info
                      "A.B.C.D;;Subnet IP";
                  }
                }
                leaf mask {
                  tailf:cli-drop-node-name;
                  type uint8 {
                    tailf:info
                      "<0-32>;;Subnet mask length";
                    range "0..8";
                  }
                }
              }
            }
            container port {
              tailf:info
                "ports";
              leaf-list ports {
                tailf:cli-drop-node-name;
                tailf:cli-flat-list-syntax;
                tailf:cli-replace-all;
                ordered-by user;
                max-elements 8;
                type uint16 {
                  tailf:info
                    "<1-65535>;;Up to 8 port numbers separated by white-spaces";
                  range "1..65535";
                }
              }
              container range {
                tailf:info
                  "Range of maximum 1000 Ports. With IP option use maximum range of 8.";
                tailf:cli-compact-syntax;
                tailf:cli-sequence-commands;
                leaf start {
                  tailf:cli-drop-node-name;
                  type uint16 {
                    tailf:info
                      "<1-65535>;;Enter Start port number for Range";
                    range "1..65535";
                  }
                }
                leaf end {
                  tailf:cli-drop-node-name;
                  type uint16 {
                    tailf:info
                      "<1-65535>;;Enter End port number for Range";
                    range "1..65535";
                  }
                }
              }
            }
            leaf direction {
              tailf:info
                "Flow direction";
              type enumeration {
                enum "any" {
                  tailf:info
                    "Any Direction";
                }
                enum "destination" {
                  tailf:info
                    "Destination Direction";
                }
                enum "source" {
                  tailf:info
                    "Source Direction";
                }
              }
            }
          }
        }
        list attribute-set {
          tailf:info
            "Set attribute-set";
          tailf:cli-suppress-mode;
          tailf:cli-delete-when-empty;
          tailf:cli-incomplete-command;
          key "protocol-name";
          leaf protocol-name {
            type string {
              tailf:info
                "WORD;;Name of protocol";
            }
          }
          leaf profile-name {
            tailf:cli-drop-node-name;
            type string {
              tailf:info
                "Attribute Profile Name";
            }
            tailf:non-strict-leafref {
              path "../../attribute-map/name";
            }
          }
        }
        list pdlm {
          tailf:info
            "PDL (protocol description language) Module - DEPRECATED!";
          tailf:cli-suppress-mode;
          tailf:cli-delete-when-empty;
          key "name";
          leaf name {
            type string {
              tailf:info
                "WORD;;Load PDLM from <file> - DEPRECATED!";
            }
          }
        }
        list port-map {
          tailf:info
            "Map well-known port of a protocol to a new port";
          tailf:cli-suppress-mode;
          tailf:cli-delete-when-empty;
          tailf:cli-incomplete-command;
          key "name";
          leaf name {
            type string {
              tailf:info
                "WORD;;Protocol name";
            }
          }
          leaf-list udp {
            tailf:info
              "UDP ports";
            tailf:cli-flat-list-syntax;
            tailf:cli-replace-all;
            ordered-by user;
            max-elements 16;
            type uint16 {
              tailf:info
                "<1-65535>;;Up to 16 port numbers separated by white-spaces";
              range "1..65535";
            }
          }
          leaf-list tcp {
            tailf:info
              "TCP ports";
            tailf:cli-flat-list-syntax;
            tailf:cli-replace-all;
            ordered-by user;
            max-elements 16;
            type uint16 {
              tailf:info
                "<1-65535>;;Up to 16 port numbers separated by white-spaces";
              range "1..65535";
            }
          }
        }
        container protocol-discovery {
          tailf:info
            "Enable protocol discovery for both ipv4 and ipv6";
          presence "true";
        }
        container protocol-pack {
          tailf:info
            "Protocol Pack";
          tailf:cli-compact-syntax;
          tailf:cli-sequence-commands {
            tailf:cli-reset-siblings;
          }
          leaf path {
            tailf:cli-drop-node-name;
            type string {
              tailf:info
                "WORD;;Load protocol pack from <path>";
            }
          }
          leaf force {
            tailf:info
              "Force";
            type empty;
          }
        }
      }
      container inspect {
        tailf:info
          "Context-based Access Control Engine";
        list name {
          tailf:info
            "Specify an inspection rule";
          tailf:cli-suppress-mode;
          tailf:cli-delete-when-empty;
          tailf:cli-incomplete-command;
          key "name";
          leaf name {
            type string {
              tailf:info
                "WORD;;Name of inspection defined (16 characters max)";
            }
          }
          list rule {
            tailf:cli-drop-node-name;
            tailf:cli-suppress-mode;
            tailf:cli-delete-when-empty;
            tailf:cli-show-long-obu-diffs;
            ordered-by user;
            key "rule";
            leaf rule {
              tailf:cli-multi-word-key;
              type string {
                tailf:info
                  "WORD;;Rule";
              }
            }
          }
        }
      }
      container spd {
        tailf:info
          "Selective Packet Discard parameters";
        leaf enable {
          tailf:cli-boolean-no;
          tailf:cli-full-command;
          type boolean;
          default "true";
        }
      }
      container spd-conf {
        tailf:cli-drop-node-name;
        container spd {
          tailf:info
            "Selective Packet Discard parameters";
          tailf:cli-incomplete-command;
          tailf:cli-incomplete-no;
          container queue {
            tailf:info
              "SPD IP queuing thresholds";
            leaf max-threshold {
              tailf:info
                "Sets SPD max threshold";
              type uint16 {
                tailf:info
                  "<0-65535>;;Max queue threshold";
              }
              default "74";
            }
            leaf min-threshold {
              tailf:info
                "Sets SPD min threshold";
              type uint16 {
                tailf:info
                  "<0-65535>;;Min queue threshold";
              }
              default "73";
            }
          }
        }
      }
      container source {
        tailf:info
          "static IP binding";
        list binding {
          tailf:info
            "static IP binding";
          tailf:cli-suppress-mode;
          tailf:cli-delete-when-empty;
          tailf:cli-compact-syntax;
          tailf:cli-sequence-commands {
            tailf:cli-reset-siblings;
          }
          tailf:cli-incomplete-command;
          key "mac-address vlan";
          leaf mac-address {
            tailf:cli-diff-set-after "../../../../interface/Ethernet/switchport" {
              tailf:xpath-root 3;
              tailf:cli-when-target-set;
            }
            tailf:cli-diff-delete-before "../../../../interface/Ethernet/switchport" {
              tailf:xpath-root 3;
              tailf:cli-when-target-delete;
            }
            tailf:cli-diff-set-after "../../../../interface/FastEthernet/switchport" {
              tailf:xpath-root 3;
              tailf:cli-when-target-set;
            }
            tailf:cli-diff-delete-before "../../../../interface/FastEthernet/switchport" {
              tailf:xpath-root 3;
              tailf:cli-when-target-delete;
            }
            tailf:cli-diff-set-after "../../../../interface/GigabitEthernet/switchport" {
              tailf:xpath-root 3;
              tailf:cli-when-target-set;
            }
            tailf:cli-diff-delete-before "../../../../interface/GigabitEthernet/switchport" {
              tailf:xpath-root 3;
              tailf:cli-when-target-delete;
            }
            tailf:cli-diff-set-after "../../../../interface/TenGigabitEthernet/switchport" {
              tailf:xpath-root 3;
              tailf:cli-when-target-set;
            }
            tailf:cli-diff-delete-before "../../../../interface/TenGigabitEthernet/switchport" {
              tailf:xpath-root 3;
              tailf:cli-when-target-delete;
            }
            tailf:cli-diff-set-after "../../../../interface/FortyGigabitEthernet/switchport" {
              tailf:xpath-root 3;
              tailf:cli-when-target-set;
            }
            tailf:cli-diff-delete-before "../../../../interface/FortyGigabitEthernet/switchport" {
              tailf:xpath-root 3;
              tailf:cli-when-target-delete;
            }
            tailf:cli-diff-set-after "../../../../interface/HundredGigE/switchport" {
              tailf:xpath-root 3;
              tailf:cli-when-target-set;
            }
            tailf:cli-diff-delete-before "../../../../interface/HundredGigE/switchport" {
              tailf:xpath-root 3;
              tailf:cli-when-target-delete;
            }
            tailf:cli-diff-set-after "../../../../interface/Port-channel/switchport" {
              tailf:xpath-root 3;
              tailf:cli-when-target-set;
            }
            tailf:cli-diff-delete-before "../../../../interface/Port-channel/switchport" {
              tailf:xpath-root 3;
              tailf:cli-when-target-delete;
            }
            type string {
              tailf:info
                "H.H.H;;binding MAC address";
            }
          }
          leaf vlan {
            tailf:info
              "binding VLAN learned";
            tailf:cli-expose-key-name;
            type uint16 {
              tailf:info
                "<1-4094>;;binding VLAN number";
              range "1..4094";
            }
          }
          leaf ip-address {
            tailf:cli-drop-node-name;
            tailf:cli-incomplete-command;
            type inet:ipv4-address {
              tailf:info
                "A.B.C.D;;binding IP address";
            }
          }
          container interface {
            tailf:info
              "binding interface";
            tailf:cli-flatten-container;
            tailf:cli-compact-syntax;
            uses interface-name-grouping;
          }
        }
      }
      container ips {
        tailf:info
          "Intrusion Prevention System";
        container po {
          tailf:info
            "Specify nr-director's PostOffice information (for sending events to the nr-directors";
          leaf max-events {
            tailf:info
              "Specify number of Post Office event structures";
            type uint16 {
              tailf:info
                "<1-65535>;;Number of Post Office event structures";
              range "1..65535";
            }
          }
        }
      }
    }
    container isdn {
      tailf:ncs-device-type "cli-ned";
      tailf:display-when "not(../../ncs:module) or ../../ncs:module[ncs:name='tailf-ned-cisco-ios']";
      tailf:info
        "ISDN configuration commands";
      leaf switch-type {
        tailf:info
          "Select the ISDN switch type";
        tailf:cli-full-command;
        type string {
          tailf:info
            "WORD;;switch type";
        }
      }
      container leased-line {
        tailf:info
          "Sets a BRI interface to support leased lines on B & D channels";
        tailf:cli-compact-syntax;
        tailf:cli-sequence-commands {
          tailf:cli-reset-siblings;
        }
        cli:ned-diff-move-before ">interface" {
          cli:arguments "when-set";
        }
        leaf BRI {
          tailf:info
            "ISDN Basic Rate Interface";
          tailf:cli-allow-join-with-value {
            tailf:cli-display-joined;
          }
          tailf:non-strict-leafref {
            path "../../../interface/BRI/name";
          }
          type string {
            tailf:info
              "<slot>/<port>;;BRI interface number";
            pattern '[0-9]+.*';
          }
        }
        leaf hundredtwentyeight {
          tailf:alt-name "128";
          tailf:info
            "combined B1+B2 channels leased line";
          type empty;
        }
      }
    }
    container vmps {
      tailf:ncs-device-type "cli-ned";
      tailf:display-when "not(../../ncs:module) or ../../ncs:module[ncs:name='tailf-ned-cisco-ios']";
      tailf:info
        "VMPS settings";
      leaf reconfirm {
        tailf:info
          "Set VMPS reconfirm interval";
        type uint8 {
          tailf:info
            "Number of minutes between reconfirmations";
          range "0..120";
        }
      }
      leaf retry {
        tailf:info
          "Set VMPS retry count";
        type uint8 {
          tailf:info
            "<1-10>;;Retry count per server";
          range "1..10";
        }
      }
      list server {
        tailf:info
          "Configure server IP address";
        tailf:cli-suppress-mode;
        tailf:cli-delete-when-empty;
        tailf:cli-compact-syntax;
        key "name";
        leaf name {
          type inet:host {
            tailf:info
              "Hostname or A.B.C.D;;IP address";
          }
        }
        leaf primary {
          tailf:info
            "Specify primary server";
          type empty;
        }
      }
    }
    container ipv6 {
      tailf:ncs-device-type "cli-ned";
      tailf:display-when "not(../../ncs:module) or ../../ncs:module[ncs:name='tailf-ned-cisco-ios']";
      tailf:info
        "Global IPv6 configuration commands";
      leaf unicast-routing {
        tailf:info
          "Enable unicast routing";
        cli:ned-diff-move-first {
          cli:arguments "when-set";
        }
        cli:ned-diff-move-last {
          cli:arguments "when-delete";
        }
        type empty;
      }
      leaf source-route {
        tailf:info
          "Process packets with source routing header options";
        tailf:cli-boolean-no;
        tailf:cli-full-command;
        type boolean;
      }
      leaf hop-limit {
        tailf:info
          "Configure hop count limit";
        type uint16 {
          tailf:info
            "<1-255>;;Hop Limit value";
          range "1..255";
        }
        default "64";
      }
      leaf cef {
        tailf:info
          "Cisco Express Forwarding";
        tailf:cli-show-no;
        tailf:cli-diff-set-after "../unicast-routing" {
          tailf:xpath-root 3;
          tailf:cli-when-target-set;
        }
        tailf:cli-diff-delete-before "../unicast-routing" {
          tailf:xpath-root 3;
          tailf:cli-when-target-delete;
        }
        type empty;
      }
      container cef-conf {
        tailf:cli-drop-node-name;
        container cef {
          tailf:info
            "Cisco Express Forwarding";
          tailf:cli-incomplete-no;
          tailf:cli-incomplete-command;
          tailf:cli-diff-set-after "../../cef" {
            tailf:xpath-root 3;
            tailf:cli-when-target-set;
          }
          tailf:cli-diff-delete-before "../../cef" {
            tailf:xpath-root 3;
            tailf:cli-when-target-delete;
          }
          container accounting {
            tailf:info
              "Enable CEF accounting";
            tailf:cli-compact-syntax;
            leaf per-prefix {
              tailf:info
                "Enable per prefix accounting";
              type empty;
            }
            leaf prefix-length {
              tailf:info
                "Enable prefix length accounting";
              type empty;
            }
          }
          leaf distributed {
            tailf:info
              "Distributed Cisco Express Forwarding";
            tailf:cli-full-command;
            type empty;
          }
          container load-sharing {
            tailf:info
              "Load sharing";
            tailf:cli-compact-syntax;
            tailf:cli-sequence-commands {
              tailf:cli-reset-siblings;
            }
            leaf algorithm {
              tailf:info
                "Per-destination load sharing algorithm selection";
              type enumeration {
                enum "original" {
                  tailf:info
                    "Original algorithm";
                }
                enum "universal" {
                  tailf:info
                    "Algorithm for use in most environments";
                }
                enum "include-ports" {
                  tailf:info
                    "Algorithm that includes layer 4 ports";
                }
              }
              default "universal";
            }
            leaf source {
              tailf:info
                "Use source port in hash function";
              tailf:cli-optional-in-sequence;
              when "../algorithm = 'include-ports'" {
                tailf:xpath-root 3;
                tailf:dependency "../algorithm";
              }
              type empty;
            }
            leaf destination {
              tailf:info
                "Use destination port in hash function";
              tailf:cli-optional-in-sequence;
              when "../algorithm = 'include-ports'" {
                tailf:xpath-root 3;
                tailf:dependency "../algorithm";
              }
              type empty;
            }
            leaf id {
              tailf:cli-drop-node-name;
              type string {
                tailf:info
                  "<1-FFFFFFFF>;;Fixed ID";
              }
            }
          }
        }
      }
      leaf flowset {
        tailf:info
          "Set flow label random for originated packets";
        tailf:cli-full-command;
        type empty;
      }
      container icmp {
        tailf:info
          "Configure ICMP parameters";
        container error-interval {
          tailf:info
            "Interval between ICMP error messages";
          tailf:cli-compact-syntax;
          tailf:cli-sequence-commands {
            tailf:cli-reset-siblings;
          }
          leaf milliseconds {
            tailf:cli-drop-node-name;
            type uint32 {
              tailf:info
                "<0-2147483647>;;Interval between tokens in milliseconds";
              range "0..2147483647";
            }
          }
          leaf bucketsize {
            tailf:cli-drop-node-name;
            type uint8 {
              tailf:info
                "<1-200>;;Bucket size";
              range "1..200";
            }
          }
        }
      }
      container wccp {
        tailf:info
          "Web-Cache Coordination Protocol IPv6 Commands";
        uses ip-wccp-grouping;
        list vrf {
          tailf:info
            "Configure WCCP for a VRF";
          tailf:cli-suppress-mode;
          tailf:cli-delete-when-empty;
          tailf:cli-compact-syntax;
          tailf:cli-incomplete-command;
          key "name";
          leaf name {
            tailf:cli-diff-set-after "../../../../vrf/definition" {
              tailf:xpath-root 3;
              tailf:cli-when-target-set;
            }
            tailf:cli-diff-delete-before "../../../../vrf/definition" {
              tailf:xpath-root 3;
              tailf:cli-when-target-delete;
            }
            type string {
              tailf:info
                "WORD;;VRF name";
            }
          }
          uses ip-wccp-grouping;
        }
      }
      container mld {
        tailf:info
          "Global mld commands";
        container snooping-enable {
          tailf:cli-drop-node-name;
          leaf snooping {
            tailf:info
              "Global MLD Snooping enable for Catalyst Vlans";
            tailf:cli-boolean-no;
            type boolean;
            default "true";
          }
        }
        leaf state-limit {
          tailf:info
            "State Limit";
          type uint16 {
            tailf:info
              "<1-64000>;;Max Allowed State";
            range "1..64000";
          }
        }
      }
      leaf multicast-routing {
        tailf:info
          "Enable IPv6 multicast";
        tailf:cli-full-command;
        type empty;
      }
      container multicast-routing-conf {
        tailf:cli-drop-node-name;
        container multicast-routing {
          tailf:info
            "Enable IPv6 multicast";
          tailf:cli-incomplete-command;
          tailf:cli-incomplete-no;
          list vrf {
            tailf:info
              "Select VPN Routing/Forwarding instance";
            tailf:cli-suppress-list-no;
            tailf:cli-suppress-mode;
            tailf:cli-delete-when-empty;
            key "name";
            leaf name {
              tailf:cli-diff-set-after "../../../../../ip/vrf" {
                tailf:xpath-root 3;
                tailf:cli-when-target-set;
              }
              tailf:cli-diff-delete-before "../../../../../ip/vrf" {
                tailf:xpath-root 3;
                tailf:cli-when-target-delete;
              }
              tailf:cli-diff-set-after "../../../../../vrf/definition" {
                tailf:xpath-root 3;
                tailf:cli-when-target-set;
              }
              tailf:cli-diff-delete-before "../../../../../vrf/definition" {
                tailf:xpath-root 3;
                tailf:cli-when-target-delete;
              }
              type string {
                tailf:info
                  "WORD;;VPN Routing/Forwarding instance name";
              }
            }
          }
        }
      }
      container multicast {
        tailf:info
          "Configure multicast related commands";
        uses ipv6-multicast-grouping;
        container hardware-switching {
          tailf:info
            "Hardware switching for IPv6 multicast packets";
          leaf replication-mode {
            tailf:info
              "Set HW replication mode";
            type enumeration {
              enum "ingress" {
                tailf:info
                  "Set HW Ingress replication mode";
              }
            }
          }
        }
        leaf pim-passive-enable {
          tailf:info
            "Enable PIM Passive feature";
          type empty;
        }
        list vrf {
          tailf:info
