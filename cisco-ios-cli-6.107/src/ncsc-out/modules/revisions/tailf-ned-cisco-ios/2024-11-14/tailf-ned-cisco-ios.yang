          tailf:cli-prefix-key;
          tailf:cli-diff-set-after "/ios:ip/access-list" {
            tailf:xpath-root 3;
            tailf:cli-when-target-set;
          }
          tailf:cli-diff-delete-before "/ios:ip/access-list" {
            tailf:xpath-root 3;
            tailf:cli-when-target-delete;
          }
          tailf:cli-disallow-value "common";
          type ncs_rpc_notif_exp-ip-acl-type;
        }
        leaf regular-access-list {
          when '../common' {
