          tailf:cli-compact-syntax;
          key "instance-id prefix";
          leaf instance-id {
            tailf:info
              "EID instance-ID";
            tailf:cli-expose-key-name;
            type uint32 {
              tailf:info
                "<1-16777214>;;Instance-ID";
              range "1..16777214";
            }
          }
          leaf prefix {
            type union {
              type ios:ncs_rpc_notif_ipv4-prefix;
              type ios:ncs_rpc_notif_ipv6-prefix;
