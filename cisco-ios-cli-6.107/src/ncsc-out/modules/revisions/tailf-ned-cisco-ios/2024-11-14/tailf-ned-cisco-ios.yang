                tailf:non-strict-leafref {
                  path "/ncs:devices/ncs:device/ncs:config/ios:redirect/server-group/name" {
                    tailf:xpath-root 3;
                  }
                }
                type string {
                  tailf:info
                    "WORD;;Server group name";
                }
              }
            }
          }
        }
        container class-name {
          tailf:cli-drop-node-name;
          list class {
            tailf:info
              "Specify a class-map to match against for this policy-map";
            tailf:cli-mode-name "config-service-policymap-class-traffic";
            tailf:cli-show-long-obu-diffs;
            tailf:cli-diff-set-after "../../../../class-map-traffic/class-map" {
              tailf:xpath-root 3;
              tailf:cli-when-target-set;
            }
            tailf:cli-diff-delete-before "../../../../class-map-traffic/class-map" {
              tailf:xpath-root 3;
              tailf:cli-when-target-delete;
            }
            ordered-by user;
            key "name";
            leaf type {
              tailf:info
                "Specify a typed class-map";
              tailf:cli-prefix-key;
              type enumeration {
                enum "traffic" {
                  tailf:info
                    "Specify a traffic class-map";
                }
              }
            }
            leaf name {
              tailf:cli-disallow-value "type|default";
              tailf:non-strict-leafref {
                path "../../../../../class-map-traffic/class-map/name";
              }
              type string {
                tailf:info
                  "WORD;;class-map name";
              }
            }
            container timeout {
              tailf:info
                "Timeout parameters";
              leaf idle {
                tailf:info
                  "Idle timeout for the session";
                type uint32 {
                  tailf:info
                    "<30-15552000>;;Idle timeout value in seconds";
                  range "30..15552000";
                }
              }
              leaf absolute {
                tailf:info
                  "Absolute timeout for the session";
                type uint32 {
                  tailf:info
                    "<0-31104000>;;Absolute timeout value in seconds";
                  range "0..31104000";
                }
              }
            }
            container accounting {
              tailf:info
                "Configure accounting parameters";
              container aaa {
                tailf:info
                  "Configure accounting aaa parameters";
                leaf list {
                  tailf:info
                    "Configure accounting method-list";
                  tailf:cli-diff-set-after "/ios:aaa/accounting/network/name" {
                    tailf:xpath-root 3;
                    tailf:cli-when-target-set;
                  }
                  tailf:cli-diff-delete-before "/ios:aaa/accounting/network/name" {
                    tailf:xpath-root 3;
                    tailf:cli-when-target-delete;
                  }
                  type string {
                    tailf:info
                      "WORD;;AAA method-list name";
                  }
                }
              }
            }
          }
        }
        container class-default {
          tailf:cli-drop-node-name;
          list class {
            tailf:info
              "Specify a class-map to match against for this policy-map";
            tailf:cli-mode-name "config-service-policymap-class-traffic";
            tailf:cli-incomplete-command;
            key "name";
            leaf type {
              tailf:info
                "Specify a typed class-map";
              tailf:cli-prefix-key;
              type enumeration {
                enum "traffic" {
                  tailf:info
                    "Specify a traffic class-map";
                }
              }
            }
            leaf name {
              tailf:cli-disallow-value "type";
              type enumeration {
                enum "default" {
                  tailf:info
                    "Default actions";
                }
              }
            }
            leaf direction {
              tailf:cli-drop-node-name;
              tailf:cli-hide-in-submode;
              type enumeration {
                enum "in-out" {
                  tailf:info
                    "Specify both input and output directions for drop";
                }
                enum "input" {
                  tailf:info
                    "Specify input direction for drop";
                }
                enum "output" {
                  tailf:info
                    "Specify output direction for drop";
                }
              }
            }
            leaf drop {
              tailf:info
                "action drop";
              type empty;
            }
          }
        }
      }
    }
