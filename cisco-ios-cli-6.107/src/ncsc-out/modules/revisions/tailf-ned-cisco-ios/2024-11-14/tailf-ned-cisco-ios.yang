                }
                leaf no-autoconfig {
                  tailf:info
                    "Do not use prefix for autoconfiguration";
                  type empty;
                }
                leaf no-rtr-address {
                  tailf:info
                    "Do not send full router address in prefix advert";
                  type empty;
                }
                leaf no-onlink {
                  tailf:info
                    "Do not use prefix for onlink determination";
                  type empty;
                }
              }
