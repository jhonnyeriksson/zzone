module tailf-ned-extreme-xos {
  // Generated by yanger -t ncs
  tailf:mount-id "extreme-xos-cli-1.5:extreme-xos-cli-1.5";
  tailf:ncs-device-type "cli-ned";

  namespace "http://tail-f.com/ned/extreme-xos";
  prefix extreme-xos;

  import tailf-common {
    prefix tailf;
  }
  import ietf-inet-types {
    prefix inet;
  }
  import cliparser-extensions-v11 {
    prefix cli;
  }
  import ietf-yang-types {
    prefix yang;
  }
  import tailf-ncs {
    prefix ncs;
  }

  revision 2024-05-10 {
    description
      "version 1.5.4, see CHANGES";
  }

  grouping ncs_compliance_template_port-list-grouping {
    list ports {
      // NCS patched for predictable order
      ordered-by user;
      // NCS drop tailf-common:cli-diff-set-after statement
      // NCS drop tailf-common:cli-diff-delete-before statement
      tailf:cli-suppress-mode;
      tailf:cli-range-list-syntax;
      key "id";
      leaf id {
        type string;
      }
    }
  }

  grouping ncs_compliance_template_ports-enable-grouping {
    list ports {
      // NCS patched for predictable order
      ordered-by user;
      extreme-xos:replace-delete-output "un(configure.*)ena(ble.*) :: $1disa$2";
      tailf:cli-drop-node-name;
      // NCS drop tailf-common:cli-diff-set-after statement
      // NCS drop tailf-common:cli-diff-delete-before statement
      // NCS drop tailf-common:cli-diff-create-after statement
      // NCS drop tailf-common:cli-diff-delete-before statement
      // NCS drop tailf-common:cli-diff-create-after statement
      // NCS drop tailf-common:cli-diff-delete-before statement
      // NCS drop tailf-common:cli-diff-create-after statement
      // NCS drop tailf-common:cli-diff-create-after statement
      // NCS drop tailf-common:cli-diff-delete-before statement
      // NCS drop tailf-common:cli-diff-delete-before statement
      tailf:cli-suppress-mode;
      tailf:cli-range-list-syntax;
      key "id";
      leaf id {
        type string;
      }
      leaf enable {
        type empty;
      }
    }
  }

  grouping ncs_compliance_template_vlanList-grouping {
    leaf-list vlan {
      // NCS patched for predictable order
      ordered-by user;
      // NCS drop tailf-common:cli-diff-set-after statement
      // NCS drop tailf-common:cli-diff-delete-before statement
      type string;
    }
  }

  grouping ncs_compliance_template_netlogin-authprotocol-grouping {
    leaf dot1x {
      type empty;
    }
    leaf mac {
      type empty;
    }
    leaf web-based {
      type empty;
    }
  }

  grouping ncs_compliance_template_radius-timeout-grouping {
    leaf timeout {
      extreme-xos:replace-delete-output "unconfigure(.*) :: configure$1 3";
      type string;
      // NCS drop default statement
    }
  }

  grouping ncs_compliance_template_shared-secret-grouping {
    container shared-secret {
      leaf encrypted {
        cli:secret "encrypted <SECRET>" {
          cli:arguments "always-encrypted";
        }
        extreme-xos:send-secret;
        extreme-xos:quoted-string;
        type string;
      }
    }
  }

  grouping ncs_compliance_template_exam-grouping {
    container examination {
      container ports {
        choice ports {
          leaf all {
            type empty;
          }
          leaf-list ports-list {
            // NCS patched for predictable order
            ordered-by user;
            tailf:cli-range-list-syntax;
            tailf:cli-drop-node-name;
            type string;
          }
        }
      }
    }
  }

  grouping ncs_compliance_template_user-grouping {
