                type uint16 {
                  tailf:info
                    "<server_timeout>;;RADIUS server timeout (1..120 sec)";
                }
                default "30";
              }
              leaf quiet-period {
                tailf:info
                  "Configure 802.1X quiet period";
                type uint16 {
                  tailf:info
                    "<quiet_period>;;Quiet period (0..65535 sec)";
                }
                default "60";
              }
              leaf supp-resp-timeout {
                tailf:info
                  "Configure supplicant response timeout";
                type uint16 {
                  tailf:info
                    "<supp_resp_timeout>;;Supplicant response timeout (1..120 sec)";
                }
                default "30";
              }
            }
          }
        }
        list ports {
          extreme-xos:trim-delete-if-match "unconfigure netlogin ports \\S+";
          tailf:info
            "Specify ports to add";
          tailf:cli-suppress-mode;
          tailf:cli-range-list-syntax;
          tailf:cli-delete-when-empty;
          key "id";
          leaf id {
            type union {
              type uint32 {
                tailf:info
                  "<port_list>;;Port list";
              }
              type enumeration {
                enum "all" {
                  tailf:info
                    "all";
                }
              }
            }
          }
          leaf mode {
            tailf:cli-no-name-on-delete;
            tailf:cli-no-value-on-delete;
            tailf:info
              "Configure port operation mode";
            type enumeration {
              enum "mac-based-vlans" {
                tailf:info
                  "Allow more than one untagged VLAN";
              }
              enum "port-based-vlans" {
                tailf:info
                  "Allow only one untagged VLAN";
              }
            }
          }
        }
        container authentication {
          tailf:info
            "Configure Network Login client authentication settings";
          leaf protocol-order {
            tailf:cli-diff-set-after "/extreme-xos:enable/policy" {
              tailf:xpath-root 3;
            }
            tailf:cli-no-value-on-delete;
            extreme-xos:replace-delete-output "un(.*) :: $1 dot1x web-based mac cep";
            tailf:info
              "Configure order of authentication protocol methods to use";
            tailf:cli-multi-value;
            type string;
          }
        }
        leaf vlan {
          tailf:cli-no-value-on-delete;
          tailf:non-strict-leafref {
            path "/ncs:devices/ncs:device/ncs:config/extreme-xos:create/vlan/id" {
              tailf:xpath-root 3;
            }
          }
          tailf:cli-diff-set-after "/extreme-xos:create/vlan" {
            tailf:xpath-root 3;
            tailf:cli-when-target-create;
          }
          tailf:cli-diff-delete-before "/extreme-xos:create/vlan" {
            tailf:xpath-root 3;
            tailf:cli-when-target-delete;
          }
          tailf:info
            "VLAN";
          type string {
            tailf:info
              "<vlan_name>;;VLAN name";
          }
        }
      }
      container policy {
        tailf:info
          "Policy Classification";
        leaf rule-model {
          tailf:cli-diff-delete-after "/extreme-xos:enable/policy" {
            tailf:xpath-root 3;
            tailf:cli-when-target-delete;
          }
          tailf:cli-diff-set-before "/extreme-xos:enable/policy" {
