            }
          }
          default "hierarchical";
        }
        container slices {
          tailf:info
            "Configure Lookup Stage TCAM resources";
          leaf tci-overwrite {
            tailf:cli-diff-set-before "/extreme-xos:enable/policy" {
              tailf:xpath-root 3;
              tailf:cli-when-target-set;
            }
            extreme-xos:replace-delete-output "un(.*) :: $1 4";
            tailf:cli-no-value-on-delete;
            tailf:info
              "Configure Lookup Stage TCAM resources used by profile with tci-overwrite enabled";
            type uint8 {
              tailf:info
                "<slices>;;Number of slices between 0 and 4 (Default 4)";
            }
            default "4";
          }
          leaf shared {
            tailf:cli-diff-delete-before "../tci-overwrite" {
              tailf:xpath-root 3;
              tailf:cli-when-target-delete;
            }
            tailf:cli-diff-set-before "/extreme-xos:enable/policy" {
              tailf:xpath-root 3;
              tailf:cli-when-target-set;
            }
            extreme-xos:replace-delete-output "un(.*) :: $1 0";
            tailf:cli-no-value-on-delete;
            tailf:info
              "Configure Lookup Stage TCAM resources";
            type uint8 {
              tailf:info
                "<shared>;;Shared slice value - (0-4)";
            }
            default "0";
          }
        }
        container maptable {
          tailf:info
            "Set VLAN ID - Policy Profile mappings table";
          leaf response {
            tailf:cli-no-value-on-delete;
            tailf:info
              "Indicates which attributes to use from RADIUS response";
            type enumeration {
              enum "both" {
                tailf:info
                  "Apply both attributes";
              }
              enum "policy" {
                tailf:info
                  "Apply the filter-id attribute";
              }
              enum "tunnel" {
                tailf:info
                  "Apply the vlan-tunnel attribute";
              }
            }
          }
        }
        container vlanauthorization {
          tailf:info
            "Configure VLAN Authorization specific settings";
          leaf enable {
            tailf:cli-no-name-on-delete;
            extreme-xos:replace-delete-output "un(.*) :: $1 disable";
            tailf:info
              "Enable VLAN Authorization";
            type empty;
          }
        }
        list profile {
          tailf:info
            "Set current policy profile";
          tailf:cli-compact-syntax;
          tailf:cli-suppress-mode;
          key "index";
          leaf index {
            type uint8 {
              tailf:info
                "<profile_index>;;Policy ID [1-63]";
            }
          }
          leaf name {
            tailf:cli-no-value-on-delete;
            tailf:cli-no-name-on-delete;
            tailf:info
              "Policy profile name";
            type string {
              tailf:info
                "<name>;;Profile name string 1-64 characters";
            }
          }
          leaf access-list {
            tailf:cli-no-value-on-delete;
            tailf:cli-no-name-on-delete;
            tailf:info
              "Assign an access-list to this profile";
            type string {
              tailf:info
                "<list_name>;;Existing Access-list name to assign to this profile";
            }
          }
          leaf pvid-status {
            tailf:cli-no-value-on-delete;
            tailf:cli-no-name-on-delete;
            tailf:info
              "PVid status - enable / disable";
            type enumeration {
              enum "enable";
              enum "disable";
            }
          }
          leaf pvid {
            tailf:cli-no-value-on-delete;
            tailf:cli-no-name-on-delete;
            tailf:info
              "PVid value - (0-4095)";
            type uint16 {
              tailf:info
                "<pvid>;;PVid value - (0-4095)";
            }
          }
          leaf web-redirect {
            tailf:cli-no-value-on-delete;
            tailf:cli-no-name-on-delete;
            tailf:info
              "Web Redirect class index value - (0-10)";
            type uint16 {
              tailf:info
                "<web_redir_index>;;Web Redirect class index value - (0-10)(Defaults to 0 which is disabled)";
            }
          }
        }
        container captive-portal {
          tailf:info
            "Configure a Captive Portal that uses HTTP redirection to force a client's web browser to be redirected to a URL";
          leaf-list listening {
            tailf:cli-list-syntax;
            tailf:cli-remove-before-change;
            tailf:info
              "Configure Captive Portal HTTP listening ports (up to 3 L4 ports)";
            type string {
              tailf:info
                "<socket_list>;;List of up to 3 sockets on which to listen (1-65535) comma separated (eg.. 80,8080,2000)";
            }
          }
          list web-redirect {
            tailf:info
              "Configure Web Redirect";
            tailf:cli-suppress-mode;
            tailf:cli-compact-syntax;
            key "index server";
            leaf index {
              type uint8 {
                tailf:info
                  "<redirect_index>;;Configure a Web Redirect index (1-10)";
              }
            }
            leaf server {
              tailf:cli-expose-key-name;
              tailf:info
                "Configure a Server for the Web Redirect Index";
              type uint8 {
                tailf:info
                  "<server_id>;;Server id to use (1-2)";
              }
            }
            leaf url {
              tailf:cli-no-value-on-delete;
              tailf:cli-no-name-on-delete;
              tailf:info
                "Captive Portal Server absolute URL";
              type string {
                tailf:info
                  "<redirect_url>;;HTTP or HTTPS URL that user is redirected to (http://<IPv4Address or Hostname>:<L4Port>/<Path>)";
              }
            }
            leaf status {
              tailf:cli-no-value-on-delete;
              tailf:cli-drop-node-name;
              type enumeration {
                enum "enable" {
                  tailf:info
                    "Captive Portal Server status - enable / disable (Default disable)";
                }
                enum "disable";
              }
            }
          }
        }
      }
      list stpd {
        tailf:info
          "STP domain/STP global configuration";
        tailf:cli-compact-syntax;
        tailf:cli-suppress-mode;
        tailf:cli-delete-when-empty;
        tailf:cli-diff-create-after "/extreme-xos:enable/stpd" {
          tailf:xpath-root 3;
          tailf:cli-when-target-create;
        }
        tailf:cli-diff-delete-before "/extreme-xos:enable/stpd" {
          tailf:xpath-root 3;
          tailf:cli-when-target-delete;
        }
        extreme-xos:trim-delete-if-match "unconfigure.*mode dot1d.*";
        key "name";
        leaf name {
          type string {
            tailf:info
              "<stpd_name>;;STP domain name";
          }
        }
        container ports {
          tailf:info
            "Ports in this STP domain to configure";
          container edge-safeguard {
            tailf:info
              "Edge port safe guard mode (transmit BPDUs)";
            uses ports-enable-grouping;
          }
          container bpdu-restrict {
            tailf:info
              "Disable port as soon as BPDU is received";
            uses ports-enable-grouping;
          }
          list link-type {
            tailf:info
              "802.1w port mode";
            tailf:cli-suppress-mode;
            tailf:cli-compact-syntax;
            tailf:cli-range-list-syntax;
            tailf:cli-diff-create-after "/extreme-xos:create/stpd" {
              tailf:xpath-root 3;
              tailf:cli-when-target-create;
            }
            tailf:cli-diff-delete-before "/extreme-xos:create/stpd" {
              tailf:xpath-root 3;
              tailf:cli-when-target-delete;
            }
            tailf:cli-diff-create-after "/extreme-xos:enable/stpd" {
              tailf:xpath-root 3;
              tailf:cli-when-target-create;
            }
            tailf:cli-diff-delete-before "/extreme-xos:enable/stpd" {
              tailf:xpath-root 3;
              tailf:cli-when-target-delete;
            }
            key "ports";
            leaf ports {
              type union {
                type uint32 {
                  tailf:info
                    "<port_list>;;List of ports to configure";
                }
                type enumeration {
                  enum "all" {
                    tailf:info
                      "Configure all ports in the system";
                  }
                }
              }
            }
            leaf edge {
              tailf:cli-prefix-key;
              tailf:info
                "edge mode";
              tailf:cli-no-name-on-delete;
              type empty;
            }
          }
        }
        list add {
          tailf:info
            "Add ports in a vlan to a STP domain";
          tailf:cli-compact-syntax;
          tailf:cli-suppress-mode;
          tailf:cli-delete-when-empty;
          key "vlan";
          leaf vlan {
            type string {
              tailf:info
                "VLAN";
            }
            tailf:cli-expose-key-name;
          }
          leaf-list ports {
            tailf:cli-diff-set-after "/extreme-xos:create/vlan" {
              tailf:xpath-root 3;
              tailf:cli-when-target-create;
            }
            tailf:cli-diff-delete-before "/extreme-xos:create/vlan" {
              tailf:xpath-root 3;
              tailf:cli-when-target-delete;
            }
            tailf:info
              "Ports in this VLAN to add";
            tailf:cli-range-list-syntax;
            type uint32 {
              tailf:info
                "<port_list>;;Ports in this VLAN to add";
            }
          }
          leaf dot1d {
            tailf:cli-no-name-on-delete;
            tailf:info
              "802.1d mode";
            type empty;
          }
        }
      }
      container cdp {
        tailf:info
          "Cisco Discovery Protocol (CDP)";
        list voip-vlan {
          extreme-xos:replace-delete-output "un(configure cdp voip-vlan) \\S+ (.*) :: $1 none $2";
          tailf:info
            "VLAN information for Voice traffic received from IP phone.";
          tailf:cli-compact-syntax;
          tailf:cli-suppress-mode;
          tailf:cli-delete-when-empty;
          tailf:cli-diff-set-after "/extreme-xos:create/vlan" {
            tailf:xpath-root 3;
            tailf:cli-when-target-create;
          }
          tailf:cli-diff-delete-before "/extreme-xos:create/vlan" {
            tailf:xpath-root 3;
            tailf:cli-when-target-delete;
          }
          key "vlan_name";
          leaf vlan_name {
            type string {
              tailf:info
                "<vlan_name>;;VLAN name";
            }
          }
          uses port-list-grouping;
        }
      }
      container lldp {
        tailf:info
          "Configure LLDP specific settings";
        list ports {
          tailf:cli-diff-set-after "/extreme-xos:create/vlan" {
            tailf:xpath-root 3;
            tailf:cli-when-target-create;
          }
          tailf:cli-diff-delete-before "/extreme-xos:create/vlan" {
            tailf:xpath-root 3;
            tailf:cli-when-target-delete;
          }
          tailf:info
            "Specify ports to configure";
          tailf:cli-suppress-mode;
          tailf:cli-compact-syntax;
          tailf:cli-range-list-syntax;
          key "id";
          leaf id {
            type union {
              type uint32 {
                tailf:info
                  "<port_list>;;List of ports to configure";
              }
              type enumeration {
                enum "all" {
                  tailf:info
                    "Configure all ports in the system";
                }
              }
            }
          }
          container advertise {
            tailf:cli-no-name-on-delete;
            tailf:info
              "Specifies to send the TLV to neighbors";
            leaf port-description {
              tailf:cli-no-name-on-delete;
              tailf:info
                "Advertise the LLDP Port Description TLV";
              type empty;
            }
            leaf system-capabilities {
              tailf:cli-no-name-on-delete;
              tailf:info
                "Advertise the LLDP System Capabilities TLV";
              type empty;
            }
            leaf management-address {
              tailf:cli-no-name-on-delete;
              tailf:info
                "Advertise the LLDP Management Address TLV";
              type empty;
            }
          }
        }
      }
      container inline-power {
        tailf:info
          "Inline-Power";
        container detection {
          tailf:info
            "PoE device detection mode";
          list portlist {
            tailf:cli-drop-node-name;
            tailf:cli-diff-set-after "/extreme-xos:create/vlan" {
              tailf:xpath-root 3;
              tailf:cli-when-target-create;
            }
            tailf:cli-diff-delete-before "/extreme-xos:create/vlan" {
              tailf:xpath-root 3;
              tailf:cli-when-target-delete;
            }
            tailf:cli-suppress-mode;
            tailf:cli-compact-syntax;
            tailf:cli-range-list-syntax;
            key "ports";
            leaf ports {
              tailf:info
                "port";
              tailf:cli-expose-key-name;
              type union {
                type uint32 {
                  tailf:info
                    "<port_list>;;List of ports to configure";
                }
                type enumeration {
                  enum "all" {
                    tailf:info
                      "Configure all ports in the system";
                  }
                }
              }
            }
            leaf "legacy-and-802.3af" {
              tailf:cli-no-name-on-delete;
              tailf:cli-no-value-on-delete;
              tailf:cli-prefix-key;
              tailf:info
                "Capacitive and IEEE 802.3af detection (default for VPEX V400 products)";
              type enumeration {
                enum "2-point" {
                  tailf:info
                    "2-point detection (for extended detection signature range)";
                }
                enum "4-point" {
                  tailf:info
                    "4-point detection (default)";
                }
              }
            }
          }
        }
      }
    }
    container enable {
      tailf:ncs-device-type "cli-ned";
      tailf:display-when "not(../../ncs:module) or ../../ncs:module[ncs:name='tailf-ned-extreme-xos']";
      tailf:info
        "Enable running system setting";
      extreme-xos:no-to-disable;
      container snmp {
        tailf:info
          "Enable SNMP";
        container access {
          tailf:cli-display-separated;
          tailf:info
            "Enable SNMP-v1v2c and SNMPv3 access";
          presence "true";
          leaf snmp-v1v2c {
            tailf:info
              "Enable SNMPv1 and SNMPv2c access";
            type empty;
          }
          leaf snmpv3 {
            tailf:info
              "Enable SNMPv3 access";
            type empty;
          }
        }
        container traps {
          tailf:info
            "Configure SNMP Trap generation settings";
          leaf fdb {
            tailf:info
              "Configure FDB related traps";
            type enumeration {
              enum "mac-tracking" {
                tailf:info
                  "Configure MAC address tracking specific traps";
              }
            }
          }
          container configuration {
            tailf:info
              "Traps for switch configuration";
            leaf change {
              tailf:info
                "Generate trap when configuration is changed (Default disabled)";
              type empty;
            }
            leaf save {
              tailf:info
                "Generate trap when configuration is saved (Default disabled)";
              type empty;
            }
          }
        }
      }
      leaf ssh2 {
        tailf:info
          "allow incoming ssh connections";
        type empty;
      }
      leaf cli-config-logging {
        tailf:info
          "CLI command logging";
        type empty;
      }
      leaf tacacs {
        tailf:info
          "TACACS+ Client";
        type empty;
      }
      leaf tacacs-accounting {
        tailf:info
          "TACACS+ accounting";
        type empty;
      }
      leaf tacacs-authorization {
        tailf:info
          "TACACS+ Client Cli Authorization";
        type empty;
      }
      leaf sntp-client {
        tailf:info
          "Enable SNTP client";
        type empty;
      }
      container log {
        tailf:info
          "Configure log service";
        leaf debug-mode {
          tailf:info
            "Debug-Mode";
          type empty;
        }
        container target {
          tailf:info
            "Target to enable or disable";
          list syslog {
            tailf:cli-diff-create-after "/extreme-xos:create/vr" {
              tailf:xpath-root 3;
              tailf:cli-when-target-create;
            }
            tailf:cli-diff-delete-before "/extreme-xos:create/vr" {
              tailf:xpath-root 3;
              tailf:cli-when-target-delete;
            }
            tailf:info
              "Remote syslog target";
            tailf:cli-compact-syntax;
            tailf:cli-suppress-mode;
            key "ipPort vr local";
            leaf ipPort {
              type string {
                tailf:info
                  "<ipPort>;;Remote syslog server IPv4 address : UDP Port";
              }
            }
            leaf vr {
              tailf:cli-expose-key-name;
              tailf:info
                "Virtual router ID";
              type string {
                tailf:info
                  "<vr_name>;;Virtual router ID";
              }
            }
            leaf local {
              tailf:cli-drop-node-name;
              type string {
                tailf:info
                  "<local>;;Remote syslog server facility";
              }
            }
          }
          leaf-list upm {
            tailf:info
              "Sending messages to UPM as event";
            tailf:cli-list-syntax;
            tailf:cli-diff-create-after "/extreme-xos:create/log/target/upm" {
              tailf:xpath-root 3;
              tailf:cli-when-target-create;
            }
            tailf:cli-diff-delete-before "/extreme-xos:create/log/target/upm" {
              tailf:xpath-root 3;
              tailf:cli-when-target-delete;
            }
            tailf:cli-diff-modify-before "/extreme-xos:create/log/target/upm" {
              tailf:xpath-root 3;
              tailf:cli-when-target-modify;
            }
            type string {
              tailf:info
                "<upm_profile_name>;;UPM Profile Name";
            }
          }
        }
      }
      container cli {
        tailf:info
          "Command line interface (CLI)";
        leaf config-logging {
          tailf:info
            "CLI command logging";
          type empty;
        }
      }
      container loopback-mode {
        tailf:info
          "loopback";
        list vlan {
          tailf:cli-diff-set-after "/extreme-xos:create/vlan" {
            tailf:xpath-root 3;
            tailf:cli-when-target-create;
          }
          tailf:cli-diff-delete-before "/extreme-xos:create/vlan" {
            tailf:xpath-root 3;
            tailf:cli-when-target-delete;
          }
          tailf:info
            "VLAN";
          tailf:cli-compact-syntax;
          tailf:cli-suppress-mode;
          key "id";
          leaf id {
            type string {
              tailf:info
                "<vlan_name>;;VLAN Name";
            }
          }
        }
      }
      container ipforwarding {
        tailf:info
          "IP forwarding";
        list vlan {
          tailf:info
            "VLAN";
          tailf:cli-compact-syntax;
          tailf:cli-suppress-mode;
          tailf:cli-diff-set-after "/extreme-xos:create/vlan" {
            tailf:xpath-root 3;
            tailf:cli-when-target-create;
          }
          tailf:cli-diff-delete-before "/extreme-xos:create/vlan" {
            tailf:xpath-root 3;
            tailf:cli-when-target-delete;
          }
          tailf:cli-diff-set-after "/extreme-xos:configure/vlan/ipaddress/ipaddress" {
            tailf:xpath-root 3;
            tailf:cli-when-target-create;
          }
          tailf:cli-diff-delete-before "/extreme-xos:configure/vlan/ipaddress/ipaddress" {
            tailf:xpath-root 3;
            tailf:cli-when-target-delete;
          }
          key "id";
          leaf id {
            type string {
              tailf:info
                "<vlan_name>;;VLAN Name";
            }
          }
        }
      }
      container diffserv {
        tailf:info
          "diffserv";
        uses exam-grouping;
      }
      container radius {
        tailf:info
          "RADIUS Client";
        leaf netlogin {
          tailf:info
            "RADIUS authentication for netlogin access";
          type empty;
        }
        leaf dynamic-authorization {
          tailf:info
            "RADIUS Dynamic Authorization";
          type empty;
        }
      }
      list stpd {
        tailf:info
          "STP domain";
        tailf:cli-compact-syntax;
        tailf:cli-suppress-mode;
        tailf:cli-delete-when-empty;
        tailf:cli-diff-set-after "/extreme-xos:create/stpd" {
          tailf:xpath-root 3;
          tailf:cli-when-target-create;
        }
        tailf:cli-diff-delete-before "/extreme-xos:create/stpd" {
          tailf:xpath-root 3;
          tailf:cli-when-target-delete;
        }
        key "name";
        leaf name {
          type string {
            tailf:info
              "<stpd_name>;;STP domain name";
          }
        }
        container auto-bind {
          tailf:info
            "Auto-bind feature for dynamic port changes";
          // NCS expand uses statement
          leaf-list vlan {
            tailf:cli-list-syntax;
            tailf:non-strict-leafref {
              path "/ncs:devices/ncs:device/ncs:config/extreme-xos:create/vlan/id" {
                tailf:xpath-root 3;
              }
            }
            tailf:cli-diff-set-after "/extreme-xos:create/vlan" {
              tailf:xpath-root 3;
              tailf:cli-when-target-create;
            }
            tailf:cli-diff-delete-before "/extreme-xos:create/vlan" {
              tailf:xpath-root 3;
              tailf:cli-when-target-delete;
            }
            tailf:info
              "VLAN";
            type string {
              tailf:info
                "<vlan_name>;;VLAN name";
            }
            tailf:cli-diff-delete-after "/extreme-xos:configure/stpd/ports" {
              tailf:xpath-root 3;
            }
          }
        }
      }
      container netlogin {
        tailf:info
          "Network Login related commands";
        list ports {
          tailf:cli-diff-set-after "/extreme-xos:create/vlan" {
            tailf:xpath-root 3;
            tailf:cli-when-target-create;
          }
          tailf:cli-diff-delete-before "/extreme-xos:create/vlan" {
            tailf:xpath-root 3;
            tailf:cli-when-target-delete;
          }
          tailf:info
            "port list";
          tailf:cli-suppress-mode;
          tailf:cli-delete-when-empty;
          tailf:cli-range-list-syntax;
          key "id";
          leaf id {
            type union {
              type uint32 {
                tailf:info
                  "<port_list>;;Port list";
              }
              type enumeration {
                enum "all" {
                  tailf:info
                    "all";
                }
              }
            }
          }
          uses netlogin-authprotocol-grouping;
        }
        container dot1x-max {
          tailf:cli-drop-node-name;
          tailf:cli-compact-syntax;
          // NCS expand uses statement
          leaf dot1x {
            tailf:info
              "Configure the 802.1x authentication protocol";
            type empty;
            tailf:cli-diff-set-after "/extreme-xos:configure/netlogin/vlan" {
              tailf:xpath-root 3;
              tailf:cli-when-target-create;
            }
            tailf:cli-diff-delete-before "/extreme-xos:configure/netlogin/vlan" {
              tailf:xpath-root 3;
              tailf:cli-when-target-delete;
            }
          }
          leaf mac {
            tailf:info
              "Configure the MAC-based authentication protocol";
            type empty;
            tailf:cli-diff-set-after "/extreme-xos:configure/netlogin/vlan" {
              tailf:xpath-root 3;
              tailf:cli-when-target-create;
            }
            tailf:cli-diff-delete-before "/extreme-xos:configure/netlogin/vlan" {
              tailf:xpath-root 3;
              tailf:cli-when-target-delete;
            }
          }
          leaf web-based {
            tailf:info
              "Configure the web-based authentication protocol";
            type empty;
            tailf:cli-diff-set-after "/extreme-xos:configure/netlogin/vlan" {
              tailf:xpath-root 3;
              tailf:cli-when-target-create;
            }
            tailf:cli-diff-delete-before "/extreme-xos:configure/netlogin/vlan" {
              tailf:xpath-root 3;
              tailf:cli-when-target-delete;
            }
          }
        }
      }
      leaf policy {
        tailf:info
          "Policy Classification";
        type empty;
      }
      container cdp {
        tailf:info
          "Cisco Discovery Protocol (CDP)";
        uses port-list-grouping;
      }
      container ip-security {
        tailf:info
          "IP Security";
        container dhcp-snooping {
          tailf:info
            "DHCP Snooping";
          list vlan {
            tailf:cli-diff-set-after "/extreme-xos:create/vlan" {
              tailf:xpath-root 3;
              tailf:cli-when-target-create;
            }
            tailf:cli-diff-delete-before "/extreme-xos:create/vlan" {
              tailf:xpath-root 3;
              tailf:cli-when-target-delete;
            }
            tailf:cli-diff-set-after "/extreme-xos:configure/vlan" {
              tailf:xpath-root 3;
              tailf:cli-when-target-create;
            }
            tailf:cli-diff-delete-before "/extreme-xos:configure/vlan" {
              tailf:xpath-root 3;
              tailf:cli-when-target-delete;
            }
            tailf:info
              "VLAN";
            tailf:cli-compact-syntax;
            tailf:cli-suppress-mode;
            tailf:cli-delete-when-empty;
            key "id";
            leaf id {
              type string {
                tailf:info
                  "<vlan_name>;;VLAN Name";
              }
            }
            list ports {
              tailf:cli-diff-set-after "/extreme-xos:create/vlan" {
                tailf:xpath-root 3;
                tailf:cli-when-target-create;
              }
              tailf:cli-diff-delete-before "/extreme-xos:create/vlan" {
                tailf:xpath-root 3;
                tailf:cli-when-target-delete;
              }
              tailf:cli-diff-set-after "/extreme-xos:configure/vlan/add/ports" {
                tailf:xpath-root 3;
                tailf:cli-when-target-create;
              }
              tailf:cli-diff-delete-before "/extreme-xos:configure/vlan/add/ports" {
                tailf:xpath-root 3;
                tailf:cli-when-target-delete;
              }
              tailf:cli-diff-delete-before "/extreme-xos:configure/vlan/add/ports" {
                tailf:xpath-root 3;
                tailf:cli-when-target-create;
              }
              tailf:info
                "port list";
              tailf:cli-suppress-mode;
              tailf:cli-compact-syntax;
              tailf:cli-range-list-syntax;
              key "id";
              leaf id {
                type union {
                  type uint32 {
                    tailf:info
                      "<port_list>;;Port list";
                  }
                  type enumeration {
                    enum "all" {
                      tailf:info
                        "all";
                    }
                  }
                }
              }
              leaf violation-action {
                tailf:cli-no-name-on-delete;
                tailf:cli-no-value-on-delete;
                tailf:info
                  "Action to take on DHCP violation";
                type enumeration {
                  enum "drop-packet" {
                    tailf:info
                      "Drop the violating DHCP packet";
                  }
                  enum "none" {
                    tailf:info
                      "Take no action";
                  }
                }
              }
            }
          }
        }
      }
    }
    container disable {
      tailf:ncs-device-type "cli-ned";
      tailf:display-when "not(../../ncs:module) or ../../ncs:module[ncs:name='tailf-ned-extreme-xos']";
      tailf:info
        "Enable running system setting";
      extreme-xos:no-to-disable;
      leaf telnet {
        type empty;
        tailf:info
          "allow incoming telnet connections";
      }
      list stpd {
        tailf:info
          "STP domain";
        tailf:cli-suppress-mode;
        key "stpd_name";
        leaf stpd_name {
          type string {
            tailf:info
              "<stpd_name>;;STP domain name";
          }
        }
      }
      container snmp {
        tailf:info
          "Disable SNMP";
        container traps {
          tailf:info
            "Configure SNMP Trap generation settings";
          container port-up-down {
            tailf:info
              "Configure port-up-down specific traps";
            leaf-list port {
              tailf:info
                "Specify ports to configure";
              tailf:cli-list-syntax;
              tailf:cli-range-list-syntax;
              type uint32 {
                tailf:info
                  "<port_list>;;Port List to configure";
              }
            }
          }
        }
      }
      container dot1p {
        tailf:info
          "dot1p";
        uses exam-grouping;
      }
      container edp {
        tailf:info
          "EDP (Extreme Discovery Protocol)";
        uses port-list-grouping;
      }
    }
  }
