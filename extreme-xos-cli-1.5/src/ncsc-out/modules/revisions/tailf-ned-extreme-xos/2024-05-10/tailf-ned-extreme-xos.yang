        tailf:cli-when-target-delete;
      }
      tailf:cli-diff-delete-before "/extreme-xos:enable/stpd/auto-bind/vlan" {
        tailf:xpath-root 3;
        tailf:cli-when-target-modify;
      }
      tailf:cli-suppress-mode;
      tailf:cli-delete-when-empty;
      tailf:cli-range-list-syntax;
      key "id";
      leaf id {
        type union {
          type uint32 {
            tailf:info
              "<port_list>;;Port list";
          }
          type enumeration {
            enum "all" {
              tailf:info
                "all";
            }
          }
        }
      }
      leaf enable {
        tailf:cli-prefix-key;
        tailf:info
          "Enable option";
        type empty;
      }
    }
  }

  grouping vlanList-grouping {
    leaf-list vlan {
      tailf:cli-list-syntax;
      tailf:non-strict-leafref {
        path "/ncs:devices/ncs:device/ncs:config/extreme-xos:create/vlan/id" {
          tailf:xpath-root 3;
        }
      }
      tailf:cli-diff-set-after "/extreme-xos:create/vlan" {
        tailf:xpath-root 3;
        tailf:cli-when-target-create;
      }
      tailf:cli-diff-delete-before "/extreme-xos:create/vlan" {
        tailf:xpath-root 3;
        tailf:cli-when-target-delete;
      }
      tailf:info
        "VLAN";
      type string {
        tailf:info
          "<vlan_name>;;VLAN name";
      }
    }
  }

  grouping netlogin-authprotocol-grouping {
    leaf dot1x {
      tailf:info
        "Configure the 802.1x authentication protocol";
      type empty;
    }
    leaf mac {
      tailf:info
        "Configure the MAC-based authentication protocol";
      type empty;
    }
    leaf web-based {
      tailf:info
        "Configure the web-based authentication protocol";
      type empty;
    }
  }

  grouping radius-timeout-grouping {
    leaf timeout {
      extreme-xos:replace-delete-output "unconfigure(.*) :: configure$1 3";
      tailf:cli-no-value-on-delete;
      tailf:info
        "RADIUS server timeout";
      type uint16 {
        tailf:info
          "<seconds>;;RADIUS server timeout seconds. Range is 1 to 240.";
      }
      default "3";
    }
  }

  grouping shared-secret-grouping {
    container shared-secret {
      tailf:info
        "shared secret";
      tailf:cli-flatten-container;
      leaf encrypted {
        cli:secret "encrypted <SECRET>" {
          cli:arguments "always-encrypted";
        }
        extreme-xos:send-secret;
        extreme-xos:quoted-string;
        tailf:info
          "Password is Encrypted";
        type string {
          tailf:info
            "<encrypted_secret>;;encrypted secret string";
        }
      }
    }
  }

  grouping exam-grouping {
    container examination {
      tailf:info
        "examination";
      container ports {
        tailf:info
          "ports";
        choice ports {
          leaf all {
            tailf:info
              "all";
            type empty;
          }
          leaf-list ports-list {
            tailf:cli-list-syntax;
            tailf:cli-range-list-syntax;
            tailf:cli-drop-node-name;
            type uint32 {
              tailf:info
                "<port_list>;;Port list";
            }
          }
        }
      }
    }
  }

  grouping user-grouping {
    leaf user {
      tailf:cli-suppress-no;
      tailf:cli-no-value-on-delete;
      tailf:cli-no-name-on-delete;
      tailf:info
        "User";
      type string {
        tailf:info
          "hex|<user_name>;;Following value is to be specified in hexadecimal
                  User Name (in ASCII)";
      }
    }
  }

  grouping sec-level-grouping {
    leaf sec-level {
      tailf:info
        "Security Level";
      type enumeration {
        enum "authnopriv";
        enum "noauth";
        enum "priv";
      }
    }
  }

  grouping sec-model-grouping {
    leaf sec-model {
      tailf:info
        "Security Model";
      type enumeration {
        enum "snmpv1";
        enum "snmpv2c";
        enum "usm";
      }
    }
  }

  grouping sntpc-grouping {
    leaf host {
      tailf:cli-no-value-on-delete;
      tailf:cli-drop-node-name;
      type inet:host;
    }
    leaf vr {
      tailf:cli-diff-create-after "/extreme-xos:create/vr" {
        tailf:xpath-root 3;
        tailf:cli-when-target-create;
      }
      tailf:cli-diff-delete-before "/extreme-xos:create/vr" {
        tailf:xpath-root 3;
        tailf:cli-when-target-delete;
      }
      tailf:cli-no-value-on-delete;
      tailf:cli-no-name-on-delete;
      tailf:info
        "Virtual router ID";
      type string {
        tailf:info
          "<vr_name>;;Virtual router ID";
      }
    }
  }

  grouping vr-grouping {
    leaf vr {
      tailf:cli-diff-create-after "/extreme-xos:create/vr" {
        tailf:xpath-root 3;
        tailf:cli-when-target-create;
      }
      tailf:cli-diff-delete-before "/extreme-xos:create/vr" {
        tailf:xpath-root 3;
        tailf:cli-when-target-delete;
      }
      tailf:info
        "Virtual router ID";
      type string {
        tailf:info
          "<vr_name>;;Virtual router ID";
      }
    }
  }

  grouping portList-grouping {
    leaf-list ports {
      tailf:info
        "Physical ports";
      tailf:cli-range-list-syntax;
      type uint32 {
        tailf:info
          "<portlist>;;List of ports separated by comma";
      }
    }
  }

  grouping tacacs-grouping {
    container primary {
      tailf:info
        "primary server";
      uses tacacs-server-grouping;
    }
    container secondary {
      tailf:info
        "secondary server";
      uses tacacs-server-grouping;
    }
    leaf timeout {
      extreme-xos:replace-delete-output "unconfigure (\\S+) timeout :: configure $1 timeout 3";
      tailf:ned-default-handling trim;
      tailf:cli-no-value-on-delete;
      tailf:info
        "TACACS+ server timeout";
      type uint32 {
        tailf:info
          "<sec>;;TACACS+ server timeout seconds";
      }
      default "3";
    }
  }

  grouping tacacs-server-grouping {
    container server {
      tailf:info
        "TACACS+ server";
      tailf:cli-compact-syntax;
      tailf:cli-sequence-commands;
      leaf host {
        tailf:cli-no-value-on-delete;
        tailf:cli-drop-node-name;
        type inet:host;
      }
      leaf port {
        tailf:cli-no-value-on-delete;
        tailf:cli-drop-node-name;
        type uint32 {
          tailf:info
            "<tcp_port>;;server tcp port";
        }
      }
      leaf client-ip {
        tailf:cli-no-value-on-delete;
        tailf:cli-no-name-on-delete;
        tailf:info
          "client ip";
        type inet:ip-address {
          tailf:info
            "<client_ipaddr>;;client ip ipaddress";
        }
      }
      leaf vr {
        tailf:cli-no-value-on-delete;
        tailf:cli-no-name-on-delete;
        tailf:cli-diff-create-after "/extreme-xos:create/vr" {
          tailf:xpath-root 3;
          tailf:cli-when-target-create;
        }
        tailf:cli-diff-delete-before "/extreme-xos:create/vr" {
          tailf:xpath-root 3;
          tailf:cli-when-target-delete;
        }
        tailf:info
          "Virtual router ID";
        type string {
          tailf:info
            "<vr_name>;;Virtual router ID";
        }
      }
    }
    uses shared-secret-grouping;
  }

  augment "/ncs:devices/ncs:device/ncs:config" {
    container create {
      tailf:ncs-device-type "cli-ned";
      tailf:display-when "not(../../ncs:module) or ../../ncs:module[ncs:name='tailf-ned-extreme-xos']";
      extreme-xos:delete-with "delete";
      tailf:info
        "Create system configuration";
      list account {
        tailf:info
          "Login account";
        tailf:cli-compact-syntax;
        tailf:cli-suppress-mode;
        key "account-name";
        leaf account-name {
          type string {
            tailf:info
              "<account-name>;;Account name";
          }
        }
        leaf account-type {
          tailf:cli-prefix-key;
          tailf:cli-no-value-on-delete;
          tailf:cli-drop-node-name;
          type enumeration {
            enum "admin" {
              tailf:info
                "Administrative privilege";
            }
            enum "lawful-intercept" {
              tailf:info
                "Lawful intercept privilege";
            }
            enum "user" {
              tailf:info
                "User (non-administrative) privilege";
            }
          }
        }
        leaf encrypted {
          tailf:cli-suppress-no;
          tailf:cli-no-value-on-delete;
          tailf:cli-no-name-on-delete;
          cli:secret "encrypted <SECRET>" {
            cli:arguments "always-encrypted";
          }
          extreme-xos:accounts-password;
          tailf:info
            "Password is Encrypted";
          type string {
            tailf:info
              "<new_password>;;clear-text or post-encrypted hash code";
          }
        }
        leaf old-password {
          type string {
            tailf:info
              "<old_password>;;clear-text old password";
          }
          tailf:cli-suppress-no;
          tailf:cli-no-value-on-delete;
          tailf:cli-no-name-on-delete;
          tailf:cli-drop-node-name;
          tailf:ned-ignore-compare-config;
        }
      }
      list access-list {
        extreme-xos:redeploy-access-profile-at-acl-modify;
        tailf:info
          "dynamic rule";
        tailf:cli-compact-syntax;
        tailf:cli-delete-when-empty;
        tailf:cli-remove-before-change;
        tailf:cli-sequence-commands {
          tailf:cli-reset-siblings;
        }
        tailf:cli-suppress-mode;
        key "dynamic-rule";
        leaf dynamic-rule {
          type string {
            tailf:info
              "<dynamic-rule>;;Dynamic Rule Name";
          }
        }
        leaf conditions {
          tailf:cli-suppress-no;
          tailf:cli-drop-node-name;
          tailf:cli-no-value-on-delete;
          type string {
            tailf:info
              "<conditions>;;Conditions separated by a semi-colon";
          }
        }
        leaf actions {
          tailf:cli-suppress-no;
          tailf:cli-drop-node-name;
          tailf:cli-no-value-on-delete;
          type string {
            tailf:info
              "<actions>;;Actions separated by a semi-colon";
          }
        }
        leaf application {
          tailf:cli-suppress-no;
          tailf:cli-no-value-on-delete;
          tailf:cli-no-name-on-delete;
          type string;
        }
      }
      list vlan {
        tailf:cli-diff-create-after "../vr" {
          tailf:xpath-root 3;
          tailf:cli-when-target-create;
        }
        tailf:cli-diff-delete-before "../vr" {
          tailf:xpath-root 3;
          tailf:cli-when-target-delete;
        }
        tailf:info
          "VLAN list (1-4094)";
        tailf:cli-compact-syntax;
        tailf:cli-suppress-mode;
        key "id";
        leaf id {
          type string {
            tailf:info
              "<vlan_name>;;VLAN Name";
          }
        }
        leaf vr {
          tailf:cli-no-value-on-delete;
          tailf:cli-no-name-on-delete;
          type string {
            tailf:info
              "<vr-name>;;Virtual router name";
          }
        }
      }
      list vr {
        tailf:info
          "Virtual router";
        tailf:cli-compact-syntax;
        tailf:cli-suppress-mode;
        tailf:cli-delete-when-empty;
        key "id";
        leaf id {
          type string {
            tailf:info
              "<vr-name>;;Virtual router name";
          }
        }
      }
      leaf-list qosprofile {
        tailf:cli-list-syntax;
        tailf:info
          "qosprofile";
        type string {
          tailf:info
            "<qosprofile>;;QOS profile";
        }
      }
      container log {
        tailf:info
          "Configure log service";
        leaf-list filter {
          tailf:cli-list-syntax;
          tailf:info
            "Create a filter";
          type string {
            tailf:info
              "<name>;;Name of the filter to create";
          }
        }
        container target {
          tailf:info
            "Create a target";
          leaf-list upm {
            tailf:cli-diff-delete-before "../../filter" {
              tailf:xpath-root 3;
              tailf:cli-when-target-delete;
            }
            tailf:cli-diff-modify-before "../../filter" {
              tailf:xpath-root 3;
              tailf:cli-when-target-modify;
            }
            tailf:cli-diff-delete-before "/extreme-xos:create/upm/profile" {
              tailf:xpath-root 3;
              tailf:cli-when-target-delete;
            }
            tailf:cli-diff-create-after "/extreme-xos:create/upm/profile" {
              tailf:xpath-root 3;
              tailf:cli-when-target-create;
            }
            tailf:cli-diff-delete-before "/extreme-xos:create/upm/profile/commands" {
              tailf:xpath-root 3;
              tailf:cli-when-target-delete;
            }
            tailf:cli-diff-create-after "/extreme-xos:create/upm/profile/commands" {
              tailf:xpath-root 3;
              tailf:cli-when-target-set;
            }
            tailf:cli-list-syntax;
            tailf:info
              "Type of the target is upm";
            type string {
              tailf:info
                "<upm_profile_name>;;Name of an already existing upm profile";
            }
          }
        }
      }
      container upm {
        tailf:info
          "Profile";
        list profile {
          extreme-xos:remove-before-change;
          tailf:meta-data "! meta-data :: turbo :: no-prompt-after-send";
          tailf:cli-explicit-exit;
          tailf:cli-exit-command ".";
          tailf:info
            "UPM profile";
          key "name";
          leaf name {
            type string {
              tailf:info
                "<profile-name>;;name";
            }
          }
          leaf commands {
            tailf:cli-drop-node-name;
            tailf:cli-full-command;
            tailf:cli-multi-value;
            tailf:cli-preformatted;
            extreme-xos:upm-list-out;
            type string {
              tailf:info
                "\"command1
                 command
                 command3
                 ...\" - commands quoted string, '
                 ' separated";
            }
          }
        }
      }
      list stpd {
        tailf:info
          "STP domain";
        tailf:cli-compact-syntax;
        tailf:cli-suppress-mode;
        tailf:cli-delete-when-empty;
        key "name";
        leaf name {
          type string {
            tailf:info
              "<stpd_name>;;STP domain name";
          }
        }
      }
    }
    container configure {
      tailf:ncs-device-type "cli-ned";
      tailf:display-when "not(../../ncs:module) or ../../ncs:module[ncs:name='tailf-ned-extreme-xos']";
      extreme-xos:delete-with "unconfigure";
      extreme-xos:trim-delete-if-match "unconfigure vlan \\S* tag";
      extreme-xos:trim-delete-if-match "unconfigure timezone.*";
      extreme-xos:trim-delete-if-match "unconfigure account.*";
      extreme-xos:trim-delete-if-match "unconfigure log target upm.*";
      list access-list {
        tailf:cli-diff-create-after "/extreme-xos:create/access-list" {
          tailf:xpath-root 3;
          tailf:cli-when-target-create;
        }
        tailf:cli-diff-delete-before "/extreme-xos:create/access-list" {
          tailf:xpath-root 3;
          tailf:cli-when-target-delete;
        }
        tailf:info
          "Access list";
        tailf:cli-compact-syntax;
        tailf:cli-remove-before-change;
        tailf:cli-sequence-commands {
          tailf:cli-reset-siblings;
        }
        tailf:cli-suppress-mode;
        key "aclname";
        leaf aclname {
          type string {
            tailf:info
              "<aclname>;;ACL policy file name";
          }
        }
        leaf any {
          tailf:cli-no-name-on-delete;
          tailf:cli-no-value-on-delete;
          tailf:info
            "Apply the ACL to wildcard, including all VLANs and all ports";
          type enumeration {
            enum "egress" {
              tailf:info
                "Acls applied to egress";
            }
            enum "ingress" {
              tailf:info
                "Acls applied to ingress";
            }
          }
        }
      }
      container snmp {
        tailf:info
          "Simple network Management Protocol";
        container access-profile {
          tailf:info
            "Access Profile";
          list add {
            tailf:info
              "Add";
            tailf:cli-diff-create-after "/extreme-xos:create/access-list" {
              tailf:xpath-root 3;
              tailf:cli-when-target-create;
            }
            tailf:cli-diff-delete-before "/extreme-xos:create/access-list" {
              tailf:xpath-root 3;
              tailf:cli-when-target-delete;
            }
            tailf:cli-compact-syntax;
            tailf:cli-suppress-mode;
            tailf:cli-remove-before-change;
            tailf:cli-sequence-commands;
            tailf:cli-delete-when-empty;
            key "rule";
            leaf rule {
              type string {
                tailf:info
                  "<rule>;;Access-list rule Name";
              }
            }
            leaf condition {
              tailf:cli-drop-node-name;
              tailf:cli-no-value-on-delete;
              type enumeration {
                enum "first" {
                  tailf:info
                    "Rule to be added as first rule";
                }
                enum "before" {
                  tailf:info
                    "Rule to be added before rule";
                }
                enum "after" {
                  tailf:info
                    "Rule to be added after rule";
                }
              }
            }
            leaf previous_rule {
              tailf:cli-no-value-on-delete;
              tailf:cli-drop-node-name;
              tailf:non-strict-leafref {
                path "/ncs:devices/ncs:device/ncs:config/extreme-xos:configure/snmp/access-profile/add/rule" {
                  tailf:xpath-root 3;
                }
              }
              type string {
                tailf:info
                  "<previous_rule>;;Previously added rule";
              }
            }
          }
        }
        leaf sysContact {
          extreme-xos:replace-delete-output "unconfigure snmp sysContact :: configure snmp sysContact \"support@extremenetworks.com, +1 888 257 3000\"";
          tailf:cli-no-value-on-delete;
          tailf:info
            "System Contact";
          type string {
            tailf:info
              "<sysName>;;System Contact";
          }
          default "support@extremenetworks.com, +1 888 257 3000";
        }
        leaf sysLocation {
          extreme-xos:replace-delete-output "unconfigure snmp sysLocation :: configure snmp sysLocation \"NO LOCATION PROVIDED\"";
          tailf:cli-no-value-on-delete;
          tailf:info
            "System Location";
          type string {
            tailf:info
              "<sysName>;;System Location";
          }
          default "NO LOCATION PROVIDED";
        }
        leaf sysName {
          extreme-xos:replace-delete-output "unconfigure snmp sysName :: configure snmp sysName \"EXOS-Switch\"";
          tailf:cli-no-value-on-delete;
          tailf:info
            "System Name";
          type string {
            tailf:info
              "<sysName>;;System Name";
          }
          default "EXOS-Switch";
        }
      }
      container snmpv3 {
        tailf:info
          "Configure SNMPv3";
        leaf engine-id {
          tailf:cli-no-value-on-delete;
          tailf:cli-no-name-on-delete;
          tailf:info
            "Configure SNMP engine-id";
          type yang:hex-string {
            tailf:info
              "<hex_engine_id>;;Engine-id (in hexadecimal)";
          }
        }
        container add {
          tailf:info
            "Add";
          list access {
            tailf:info
              "Access";
            tailf:cli-compact-syntax;
            tailf:cli-suppress-mode;
            key "group_name sec-model sec-level";
            leaf group_name {
              type string {
                tailf:info
                  "hex|group_name>;;Following value is to be specified in hexadecimal
                          Group name (in ASCII)";
              }
            }
            leaf sec-model {
              tailf:cli-expose-key-name;
              tailf:info
                "Security Model";
              type enumeration {
                enum "snmpv1";
                enum "snmpv2c";
                enum "usm";
              }
            }
            leaf sec-level {
              tailf:cli-expose-key-name;
              tailf:info
                "Security Level";
              type enumeration {
                enum "authnopriv";
                enum "noauth";
                enum "priv";
              }
            }
            leaf read-view {
              tailf:cli-no-value-on-delete;
              tailf:cli-no-name-on-delete;
              tailf:info
                "Read View";
              type string {
                tailf:info
                  "hex|<read_view_name>;;Following value is to be specified in hexadecimal
                       Read View Name (in ASCII)";
              }
            }
            leaf write-view {
              tailf:cli-no-value-on-delete;
              tailf:cli-no-name-on-delete;
              tailf:info
                "Write View";
              type string {
                tailf:info
                  "hex|<write-view>;;Following value is to be specified in hexadecimal
                       Write View Name (in ASCII)";
              }
            }
            leaf notify-view {
              tailf:cli-no-value-on-delete;
              tailf:cli-no-name-on-delete;
              tailf:info
                "Notify View";
              type string {
                tailf:info
                  "hex|<notify-view>;;Following value is to be specified in hexadecimal
                       Notify View Name (in ASCII)";
              }
            }
          }
          list community {
            tailf:info
              "Community";
            tailf:cli-compact-syntax;
            tailf:cli-suppress-mode;
            key "community_index";
            leaf community_index {
              type string {
                tailf:info
                  "hex|<community_index>;;Following value is to be specified in hexadecimal
                          Community Index (in ASCII)";
              }
            }
            leaf name {
              tailf:cli-suppress-no;
              tailf:cli-no-value-on-delete;
              tailf:cli-no-name-on-delete;
              tailf:info
                "Community name";
              type string {
                tailf:info
                  "<community_name>;;Community name (in ASCII)";
              }
            }
            uses user-grouping;
          }
          list group {
            tailf:info
              "Group";
            tailf:cli-compact-syntax;
            tailf:cli-suppress-mode;
            key "group_name user sec-model";
            leaf group_name {
              type string {
                tailf:info
                  "hex|<<group_name>>;;Following value is to be specified in hexadecimal
                          Group Name (in ASCII)";
              }
            }
            leaf user {
              tailf:cli-expose-key-name;
              tailf:info
                "User";
              type string {
                tailf:info
                  "hex|<user_name>;;Following value is to be specified in hexadecimal
                          User Name (in ASCII)";
              }
            }
            leaf sec-model {
              tailf:cli-expose-key-name;
              tailf:info
                "Security Model";
              type enumeration {
                enum "snmpv1";
                enum "snmpv2c";
                enum "usm";
              }
            }
          }
          list target-addr {
            tailf:info
              "Target Address";
            tailf:cli-compact-syntax;
            tailf:cli-suppress-mode;
            key "addr_name";
            leaf addr_name {
              type string {
                tailf:info
                  "<addr_name>;;Address Name (in ASCII)";
              }
            }
            leaf param {
              tailf:cli-suppress-no;
              tailf:cli-no-value-on-delete;
              tailf:cli-no-name-on-delete;
              tailf:info
                "Param";
              type string {
                tailf:info
                  "<param_name>;;Param name (in ASCII)";
              }
            }
            leaf ipaddress {
              tailf:cli-suppress-no;
              tailf:cli-no-value-on-delete;
              tailf:cli-no-name-on-delete;
              tailf:info
                "IP address (IPv4 or IPv6 Address)";
              type inet:ip-address;
            }
            leaf transport-port {
              tailf:cli-suppress-no;
              tailf:cli-no-value-on-delete;
              tailf:cli-no-name-on-delete;
              tailf:info
                "Transport port";
              type uint32 {
                tailf:info
                  "<port_number>;;Port number";
              }
            }
            leaf from {
              tailf:cli-diff-set-after "/extreme-xos:configure/vlan/ipaddress/ipaddress" {
                tailf:xpath-root 3;
                tailf:cli-when-target-create;
              }
              tailf:cli-diff-delete-before "/extreme-xos:configure/vlan/ipaddress/ipaddress" {
                tailf:xpath-root 3;
                tailf:cli-when-target-delete;
              }
              tailf:cli-suppress-no;
              tailf:cli-no-value-on-delete;
              tailf:cli-no-name-on-delete;
              tailf:info
                "Src IP address (IPv4 or IPv6 Address)";
              type inet:ip-address {
                tailf:info
                  "<src_ip_address>;;Src IPv4 address";
              }
            }
            leaf-list tag-list {
              tailf:cli-suppress-no;
              tailf:cli-no-value-on-delete;
              tailf:cli-no-name-on-delete;
              tailf:info
                "Tag list";
              tailf:cli-range-list-syntax;
              tailf:cli-flat-list-syntax;
              type string {
                tailf:info
                  "<tag_list>;;List of tags separated by commas";
              }
            }
          }
          list target-params {
            tailf:info
              "Target Params";
            tailf:cli-compact-syntax;
            tailf:cli-suppress-mode;
            key "group_name";
            leaf group_name {
              type string {
                tailf:info
                  "<param_name>;;Param Name (in ASCII)";
              }
            }
            uses user-grouping;
            leaf mp-model {
              tailf:cli-suppress-no;
              tailf:cli-no-value-on-delete;
              tailf:cli-no-name-on-delete;
              tailf:info
                "Message Processing Model";
              type enumeration {
                enum "snmpv1";
                enum "snmpv2c";
                enum "snmpv3";
              }
            }
            leaf sec-model {
              tailf:cli-suppress-no;
              tailf:cli-no-value-on-delete;
              tailf:cli-no-name-on-delete;
              tailf:info
                "Security Model";
              type enumeration {
                enum "snmpv1";
                enum "snmpv2c";
                enum "usm";
              }
            }
            leaf sec-level {
              tailf:cli-suppress-no;
              tailf:cli-no-value-on-delete;
              tailf:cli-no-name-on-delete;
              tailf:info
                "Security Level";
              type enumeration {
                enum "authnopriv";
                enum "noauth";
                enum "priv";
              }
            }
          }
          list user {
            extreme-xos:replace-input "(\\s+engine-id [0-9a-f:]+) :: ";
            tailf:info
              "User";
            tailf:cli-compact-syntax;
            tailf:cli-suppress-mode;
            key "user_name";
            leaf user_name {
              type string {
                tailf:info
                  "hex|<user_name>;;Following value is to be specified in hexadecimal
                          User Name (in ASCII)";
              }
            }
            leaf authentication {
              tailf:cli-suppress-no;
              tailf:cli-no-value-on-delete;
              tailf:cli-no-name-on-delete;
              tailf:info
                "Authentication scheme";
              type enumeration {
                enum "md5" {
                  tailf:info
                    "MD5";
                }
                enum "sha" {
                  tailf:info
                    "SHA";
                }
              }
            }
            container auth-encrypted {
              tailf:cli-suppress-no;
              tailf:cli-no-name-on-delete;
              tailf:info
                "Authentication secret is to be entered in encrypted form";
              tailf:cli-flatten-container;
              leaf localized-key {
                tailf:cli-suppress-no;
                tailf:cli-no-value-on-delete;
                tailf:cli-no-name-on-delete;
                tailf:info
                  "Following value is a MD5 or SHA hash of the engine-id and user's password";
                cli:secret " auth-encrypted localized-key (\\S+)" {
                  cli:arguments "always-encrypted";
                }
                extreme-xos:send-secret;
                tailf:cli-disallow-value "privacy";
                type string {
                  tailf:info
                    "<auth_localized_key>|<auth_password>;;Authentication localized key (in hexadecimal)| Authentication Password (in ASCII)";
                }
              }
            }
            leaf privacy {
              tailf:cli-suppress-no;
              tailf:cli-no-value-on-delete;
              tailf:cli-no-name-on-delete;
              tailf:info
                "Privacy";
              type enumeration {
                enum "3des" {
                  tailf:info
                    "Specifies the use of the 168-bit 3DES algorithm for encryption";
                }
                enum "aes" {
                  tailf:info
                    "Specifies the use of the AES algorithm for encryption";
                }
                enum "des" {
                  tailf:info
                    "Specifies the use of the 56-bit DES algorithm for encryption(default)";
                }
              }
            }
            leaf aes-bits {
              tailf:cli-suppress-no;
              tailf:cli-no-value-on-delete;
              tailf:cli-no-name-on-delete;
              tailf:cli-drop-node-name;
              when "../privacy = 'aes'" {
                tailf:xpath-root 3;
              }
              type enumeration {
                enum "128" {
                  tailf:info
                    "Specifies the use of the 128-bit AES algorithm for encryption";
                }
                enum "192" {
                  tailf:info
                    "Specifies the use of the 192-bit AES algorithm for encryption";
                }
                enum "256" {
                  tailf:info
                    "Specifies the use of the 256-bit AES algorithm for encryption";
                }
              }
            }
            leaf privacy-encrypted {
              tailf:cli-suppress-no;
              tailf:cli-no-name-on-delete;
              tailf:info
                "Privacy Password is to be entered in encrypted form";
              type empty;
            }
            leaf localized-key {
              tailf:cli-suppress-no;
              tailf:cli-no-value-on-delete;
              tailf:cli-no-name-on-delete;
              tailf:info
                "Following value is a MD5 or SHA hash of the engine-id and user's password";
              cli:secret " privacy-encrypted localized-key (\\S+)" {
                cli:arguments "always-encrypted";
              }
              extreme-xos:send-secret;
              type string {
                tailf:info
                  "<auth_localized_key>|<auth_password>;;Authentication localized key (in hexadecimal)| Authentication Password (in ASCII)";
              }
            }
          }
        }
      }
      list vlan {
        tailf:info
          "VLAN list (1-4094)";
        tailf:cli-suppress-mode;
        tailf:cli-delete-when-empty;
        key "id";
        leaf id {
          type string {
            tailf:info
              "<vlan_name>;;VLAN Name";
          }
        }
        container delete {
          when "../id = 'default'" {
            tailf:xpath-root 3;
          }
          tailf:info
            "Delete entities from VLAN";
          list ports {
            tailf:cli-diff-set-after "/extreme-xos:create/vlan" {
              tailf:xpath-root 3;
              tailf:cli-when-target-create;
            }
            tailf:cli-diff-delete-before "/extreme-xos:create/vlan" {
              tailf:xpath-root 3;
              tailf:cli-when-target-delete;
            }
            tailf:info
              "port list";
            tailf:cli-suppress-mode;
            tailf:cli-compact-syntax;
            tailf:cli-range-list-syntax;
            key "id";
            leaf id {
              type union {
                type uint32 {
                  tailf:info
                    "<port_list>;;Port list";
                }
                type enumeration {
                  enum "all" {
                    tailf:info
                      "all";
                  }
                }
              }
            }
          }
        }
        container add {
          tailf:info
            "Add entities to VLAN";
          list ports {
            tailf:cli-diff-set-after "/extreme-xos:create/vlan" {
              tailf:xpath-root 3;
              tailf:cli-when-target-create;
            }
            tailf:cli-diff-delete-before "/extreme-xos:create/vlan" {
              tailf:xpath-root 3;
              tailf:cli-when-target-delete;
            }
            tailf:cli-diff-create-before "../../tag" {
              tailf:xpath-root 3;
              tailf:cli-when-target-delete;
            }
            tailf:cli-diff-create-after "../../tag" {
              tailf:xpath-root 3;
              tailf:cli-when-target-set;
            }
            tailf:cli-diff-create-after "/extreme-xos:configure/vr/add/ports" {
              tailf:xpath-root 3;
              tailf:cli-when-target-delete;
            }
            tailf:info
              "Ports in this VLAN to add";
            tailf:cli-suppress-mode;
            tailf:cli-compact-syntax;
            tailf:cli-range-list-syntax;
            key "id";
            leaf id {
              type union {
                type uint32 {
                  tailf:info
                    "<port_list>;;Port list";
                }
                type enumeration {
                  enum "all" {
                    tailf:info
                      "all";
                  }
                }
              }
            }
            choice tag {
              leaf untagged {
                tailf:cli-no-name-on-delete;
                tailf:info
                  "untagged";
                type empty;
              }
              leaf tagged {
                tailf:cli-no-name-on-delete;
                tailf:info
                  "untagged";
                type empty;
              }
            }
          }
        }
        container ipaddress {
          tailf:info
            "IP address";
          tailf:cli-compact-syntax;
          tailf:cli-sequence-commands {
            tailf:cli-reset-siblings;
          }
          leaf ipaddress {
            tailf:cli-diff-set-after "/extreme-xos:create/vlan" {
              tailf:xpath-root 3;
              tailf:cli-when-target-create;
            }
            tailf:cli-diff-delete-before "/extreme-xos:create/vlan" {
              tailf:xpath-root 3;
              tailf:cli-when-target-delete;
            }
            tailf:cli-diff-set-before "../../tag" {
              tailf:xpath-root 3;
              tailf:cli-when-target-delete;
            }
            tailf:cli-remove-before-change;
            tailf:cli-suppress-no;
            tailf:cli-no-value-on-delete;
            tailf:cli-drop-node-name;
            type inet:ip-address {
              tailf:info
                "<ipaddress>;;IP address";
            }
          }
          leaf netmask {
            tailf:cli-suppress-no;
            tailf:cli-no-value-on-delete;
            tailf:cli-drop-node-name;
            type inet:ip-address {
              tailf:info
                "<netmask>;;IP netmask";
            }
          }
        }
        leaf tag {
          tailf:cli-diff-set-after "/extreme-xos:create/vlan" {
            tailf:xpath-root 3;
            tailf:cli-when-target-create;
          }
          tailf:cli-diff-delete-before "/extreme-xos:create/vlan" {
            tailf:xpath-root 3;
            tailf:cli-when-target-delete;
          }
          tailf:cli-full-command;
          tailf:cli-no-value-on-delete;
          tailf:info
            "VLAN tag";
          type uint16 {
            tailf:info
              "<tag>;;VLAN tag ID between 1 and 4094";
          }
        }
        leaf description {
          tailf:cli-diff-set-after "/extreme-xos:create/vlan" {
            tailf:xpath-root 3;
            tailf:cli-when-target-create;
          }
          tailf:cli-diff-delete-before "/extreme-xos:create/vlan" {
            tailf:xpath-root 3;
            tailf:cli-when-target-delete;
          }
          tailf:cli-no-value-on-delete;
          tailf:cli-full-command;
          tailf:info
            "Description string up to 64 characters";
          type string {
            tailf:info
              "<vlan-desc>;;Description string in quotes up to 64 characters";
          }
          default "none";
        }
      }
      list vr {
        tailf:info
          "Virtual router";
        tailf:cli-compact-syntax;
        tailf:cli-suppress-mode;
        tailf:cli-delete-when-empty;
        key "id";
        leaf id {
          type string {
            tailf:info
              "<vr-name>;;Virtual router name";
          }
        }
        container delete {
          when "../id = 'VR-Default'" {
            tailf:xpath-root 3;
          }
          tailf:info
            "Delete configuration";
          uses portList-grouping;
        }
        container add {
          tailf:info
            "Add configuration";
          leaf-list ports {
            tailf:cli-diff-create-after "/extreme-xos:create/vr" {
              tailf:xpath-root 3;
              tailf:cli-when-target-create;
            }
            tailf:cli-diff-delete-before "/extreme-xos:create/vr" {
              tailf:xpath-root 3;
              tailf:cli-when-target-delete;
            }
            tailf:info
              "Physical ports";
            tailf:cli-range-list-syntax;
            type uint32 {
              tailf:info
                "<portlist>;;List of ports separated by comma";
            }
          }
        }
      }
      container iproute {
        tailf:info
          "IP routing module";
        container add {
          tailf:info
            "Add route";
          container default {
            tailf:info
              "default route";
            leaf gateway {
              tailf:cli-drop-node-name;
              type inet:ip-address {
                tailf:info
                  "<gateway>;;gateway address";
              }
            }
          }
          list route {
            tailf:cli-drop-node-name;
            tailf:cli-suppress-mode;
            key "address netmask gateway";
            leaf address {
              type inet:ip-address {
                tailf:info
                  "<ipaddress>;;Destination address";
              }
            }
            leaf netmask {
              type inet:ip-address {
                tailf:info
                  "<netmask>;;IP address netmask";
              }
            }
            leaf gateway {
              type inet:ip-address {
                tailf:info
                  "<gateway>;;gateway address";
              }
            }
          }
        }
      }
      container tacacs {
        extreme-xos:replace-delete-output "unconfigure tacacs (\\w+) server :: unconfigure tacacs server $1";
        extreme-xos:trim-delete-if-match "unconfigure.*shared-secret";
        tailf:info
          "Configure TACACS+ Server";
        uses tacacs-grouping;
        leaf priv-lvl {
          extreme-xos:replace-delete-output "unconfigure tacacs priv-lvl :: configure tacacs priv-lvl optional";
          tailf:ned-default-handling trim;
          tailf:info
            "Privilege level attribute of authorization request.";
          tailf:cli-no-value-on-delete;
          type enumeration {
            enum "optional" {
              tailf:info
                "Allow login with read-only privilege if priv-lvl is not provided. (Default)";
            }
            enum "required" {
              tailf:info
                "Fail login attempt if priv-lvl attribute is not provided";
            }
          }
          default "optional";
        }
      }
      container tacacs-accounting {
        extreme-xos:replace-delete-output "unconfigure tacacs-accounting (\\w+) server :: unconfigure tacacs-accounting server $1";
        extreme-xos:trim-delete-if-match "unconfigure.*shared-secret";
        tailf:info
          "Configure TACACS+ Accounting Server";
        uses tacacs-grouping;
      }
      container banner {
        tailf:info
          "System login banner";
        container before-login {
          tailf:info
            "Banner to be displayed before login (default)";
          leaf save-to-configuration {
            tailf:cli-no-value-on-delete;
            extreme-xos:replace-delete-output "unconfigure banner before-login save-to-configuration :: configure banner before-login save-to-configuration  ";
            extreme-xos:multi-line-banner;
            tailf:info
              "Save the before login banner to the configuration file as well as non-volatile memory";
            type string;
          }
        }
        leaf after-login {
          tailf:info
            "Banner to be displayed after login";
          tailf:cli-no-value-on-delete;
          extreme-xos:replace-delete-output "unconfigure banner after-login :: configure banner after-login  ";
          extreme-xos:multi-line-banner;
          type string;
        }
      }
      container syslog {
        tailf:info
          "Remote syslog target";
        list add {
          tailf:cli-diff-create-after "/extreme-xos:create/vr" {
            tailf:xpath-root 3;
            tailf:cli-when-target-create;
          }
          tailf:cli-diff-delete-before "/extreme-xos:create/vr" {
            tailf:xpath-root 3;
            tailf:cli-when-target-delete;
          }
          tailf:info
            "Add a syslog target";
          tailf:cli-compact-syntax;
          tailf:cli-suppress-mode;
          key "ipPort vr local";
          leaf ipPort {
            type string {
              tailf:info
                "<ipPort>;;Remote syslog server IPv4 address : UDP Port";
            }
          }
          leaf vr {
            tailf:cli-expose-key-name;
            tailf:info
              "Virtual router ID";
            type string {
              tailf:info
                "<vr_name>;;Virtual router ID";
            }
          }
          leaf local {
            tailf:cli-drop-node-name;
            type string {
              tailf:info
                "<local>;;Remote syslog server facility";
            }
          }
        }
      }
      container log {
        tailf:info
          "Configure log service";
        container target {
          tailf:info
            "Configure target";
          list syslog {
            extreme-xos:replace-delete-output "unconfigure log target syslog :: configure syslog delete :: format,filter,match,from";
            extreme-xos:trim-delete-if-match "unconfigure log target syslog.*filter.*";
            extreme-xos:trim-delete-if-match "unconfigure log target syslog.*match.*";
            extreme-xos:trim-delete-if-match "unconfigure log target syslog.*from.*";
            tailf:cli-diff-create-after "/extreme-xos:create/vr" {
              tailf:xpath-root 3;
              tailf:cli-when-target-create;
            }
            tailf:cli-diff-delete-before "/extreme-xos:create/vr" {
              tailf:xpath-root 3;
              tailf:cli-when-target-delete;
            }
            tailf:cli-diff-create-after "/extreme-xos:configure/syslog/add" {
              tailf:xpath-root 3;
              tailf:cli-when-target-create;
            }
            tailf:cli-diff-delete-before "/extreme-xos:configure/syslog/add" {
              tailf:xpath-root 3;
              tailf:cli-when-target-delete;
            }
            tailf:info
              "Remote syslog target";
            tailf:cli-compact-syntax;
            tailf:cli-suppress-mode;
            tailf:cli-delete-when-empty;
            key "ipPort vr local";
            leaf ipPort {
              type string {
                tailf:info
                  "<ipPort>;;Remote syslog server IPv4 address : UDP Port";
              }
            }
            leaf vr {
              tailf:cli-expose-key-name;
              tailf:info
                "Virtual router ID";
              type string {
                tailf:info
                  "<vr_name>;;Virtual router ID";
              }
            }
            leaf local {
              type string {
                tailf:info
                  "<local>;;Remote syslog server facility";
              }
            }
            leaf from {
              tailf:cli-diff-set-after "/extreme-xos:configure/vlan/ipaddress/ipaddress" {
                tailf:xpath-root 3;
                tailf:cli-when-target-create;
              }
              tailf:cli-diff-delete-before "/extreme-xos:configure/vlan/ipaddress/ipaddress" {
                tailf:xpath-root 3;
                tailf:cli-when-target-delete;
              }
              tailf:info
                "Configure specific local source IP address";
              tailf:cli-full-command;
              type inet:ip-address {
                tailf:info
                  "<source-ip-address>;;Local source address to use";
              }
            }
            container filter {
              tailf:cli-compact-syntax;
              tailf:cli-sequence-commands {
                tailf:cli-reset-siblings;
              }
              tailf:info
                "Filter";
              leaf filter {
                tailf:cli-diff-set-after "/extreme-xos:configure/syslog/add" {
                  tailf:xpath-root 3;
                  tailf:cli-when-target-create;
                }
                tailf:cli-diff-delete-before "/extreme-xos:configure/syslog/add" {
                  tailf:xpath-root 3;
                  tailf:cli-when-target-delete;
                }
                tailf:cli-drop-node-name;
                type string {
                  tailf:info
                    "<filter-name>;filter name";
                }
              }
              leaf severity {
                tailf:cli-no-name-on-delete;
                tailf:cli-no-value-on-delete;
                tailf:info
                  "Configure a severity threshold for this target";
                type string {
                  tailf:info
                    "<severity>;;Severity value to use";
                }
              }
            }
            container format {
              tailf:info
                "Display format";
              tailf:cli-compact-syntax;
              tailf:cli-sequence-commands {
                tailf:cli-reset-siblings;
              }
              leaf timestamp {
                tailf:cli-diff-set-after "/extreme-xos:configure/syslog/add" {
                  tailf:xpath-root 3;
                  tailf:cli-when-target-create;
                }
                tailf:cli-diff-delete-before "/extreme-xos:configure/syslog/add" {
                  tailf:xpath-root 3;
                  tailf:cli-when-target-delete;
                }
                tailf:cli-no-name-on-delete;
                tailf:cli-no-value-on-delete;
                tailf:info
                  "Configure timestamp format";
                type enumeration {
                  enum "hundredths" {
                    tailf:info
                      "Time format as hh:mm:ss.HH (e.g. 12:00:23.96)";
                  }
                  enum "none" {
                    tailf:info
                      "Do not display anything";
                  }
                  enum "seconds" {
                    tailf:info
                      "Time format as hh:mm:ss (e.g. 12:00:23)";
                  }
                }
              }
              leaf date {
                tailf:cli-no-name-on-delete;
                tailf:cli-no-value-on-delete;
                tailf:info
                  "Configure date format";
                type enumeration {
                  enum "Mmm-dd" {
                    tailf:info
                      "Date format as specified in RFC 3164 (e.g. Jan 14)";
                  }
                  enum "dd-Mmm-yyyy" {
                    tailf:info
                      "Date format as 14-Jan-2003";
                  }
                  enum "dd-mm-yyyy" {
                    tailf:info
                      "Date format as 14-01-2003";
                  }
                  enum "mm/dd/yyyy" {
                    tailf:info
                      "Date format as 01/14/2003";
                  }
                  enum "none" {
                    tailf:info
                      "Do not display anything";
                  }
                }
              }
              leaf event-name {
                tailf:cli-no-name-on-delete;
                tailf:cli-no-value-on-delete;
                tailf:info
                  "Configure event name format ";
                tailf:cli-optional-in-sequence;
                tailf:cli-break-sequence-commands;
                type enumeration {
                  enum "component" {
                    tailf:info
                      "Display component name";
                  }
                  enum "condition" {
                    tailf:info
                      "Display component and condition name";
                  }
                  enum "none" {
                    tailf:info
                      "Do not display anything";
                  }
                }
              }
              leaf priority {
                tailf:cli-no-name-on-delete;
                tailf:info
                  "Enable or disable the display of the priority";
                type empty;
              }
              leaf host-name {
                tailf:cli-no-name-on-delete;
                tailf:info
                  "Enable or disable the display of the host name";
                type empty;
              }
              leaf severity {
                tailf:cli-no-name-on-delete;
                tailf:info
                  "Enable or disable the display of the severity";
                type empty;
              }
              leaf tag-name {
                tailf:cli-no-name-on-delete;
                tailf:info
                  "Enable or disable the display of the tag name";
                type empty;
              }
            }
            container match {
              tailf:info
                "Configure regular expression";
              choice regex-choice {
                leaf any {
                  tailf:cli-diff-set-after "/extreme-xos:configure/syslog/add" {
                    tailf:xpath-root 3;
                    tailf:cli-when-target-create;
                  }
                  tailf:cli-diff-delete-before "/extreme-xos:configure/syslog/add" {
                    tailf:xpath-root 3;
                    tailf:cli-when-target-delete;
                  }
                  tailf:info
                    "Do not match any regular expression";
                  type empty;
                }
                leaf regex {
                  tailf:cli-diff-set-after "/extreme-xos:configure/syslog/add" {
                    tailf:xpath-root 3;
                    tailf:cli-when-target-create;
                  }
                  tailf:cli-diff-delete-before "/extreme-xos:configure/syslog/add" {
                    tailf:xpath-root 3;
                    tailf:cli-when-target-delete;
                  }
                  tailf:cli-drop-node-name;
                  tailf:cli-disallow-value "any";
                  type string {
                    tailf:info
                      "<regex>;;Regular expression to match";
                  }
                }
              }
            }
          }
          list upm {
            tailf:cli-diff-delete-before "/extreme-xos:create/upm/profile" {
              tailf:xpath-root 3;
              tailf:cli-when-target-delete;
            }
            tailf:cli-diff-create-after "/extreme-xos:create/upm/profile" {
              tailf:xpath-root 3;
              tailf:cli-when-target-create;
            }
            tailf:cli-diff-delete-before "/extreme-xos:create/log/target/upm" {
              tailf:xpath-root 3;
              tailf:cli-when-target-delete;
            }
            tailf:cli-diff-create-after "/extreme-xos:create/log/target/upm" {
              tailf:xpath-root 3;
              tailf:cli-when-target-create;
            }
            tailf:cli-diff-delete-before "/extreme-xos:create/log/filter" {
              tailf:xpath-root 3;
              tailf:cli-when-target-delete;
            }
            tailf:cli-diff-delete-before "/extreme-xos:create/log/filter" {
              tailf:xpath-root 3;
              tailf:cli-when-target-modify;
            }
            tailf:info
              "Sending messages to UPM as events";
            tailf:cli-compact-syntax;
            tailf:cli-suppress-mode;
            tailf:cli-delete-when-empty;
            key "name";
            leaf name {
              tailf:non-strict-leafref {
                path "/ncs:devices/ncs:device/ncs:config/extreme-xos:create/log/target/upm" {
                  tailf:xpath-root 3;
                }
              }
              type string {
                tailf:info
                  "<upm_profile_name>;;UPM Profile Name";
              }
            }
            leaf filter {
              tailf:info
                "Filter";
              tailf:cli-diff-delete-before "/extreme-xos:create/log/filter" {
                tailf:xpath-root 3;
                tailf:cli-when-target-delete;
              }
              tailf:non-strict-leafref {
                path "/ncs:devices/ncs:device/ncs:config/extreme-xos:create/log/filter" {
                  tailf:xpath-root 3;
                }
              }
              type string {
                tailf:info
                  "<name>;;Name of the filter to configure";
              }
            }
            leaf severity {
              tailf:cli-case-insensitive;
              tailf:info
                "Configure a severity threshold for this target";
              type enumeration {
                enum "critical";
                enum "debug-data";
                enum "debug-summary";
                enum "debug-verbose";
                enum "error";
                enum "info";
                enum "notice";
                enum "warning";
              }
            }
          }
        }
        list filter {
          tailf:cli-diff-delete-before "/extreme-xos:create/log/filter" {
            tailf:xpath-root 3;
            tailf:cli-when-target-delete;
          }
          tailf:info
            "Configure filter";
          tailf:cli-compact-syntax;
          tailf:cli-suppress-mode;
          tailf:cli-delete-when-empty;
          key "name";
          leaf name {
            tailf:non-strict-leafref {
              path "/ncs:devices/ncs:device/ncs:config/extreme-xos:create/log/filter" {
                tailf:xpath-root 3;
              }
            }
            type string {
              tailf:info
                "<name>;;Name of the filter to configure";
            }
          }
          container add {
            tailf:info
              "Add event to filter";
            leaf-list events {
              extreme-xos:replace-delete-output "un(.*) add (.*) :: $1 delete $2";
              tailf:info
                "Events to add";
              tailf:cli-list-syntax;
              type string {
                tailf:info
                  "<event-component>;;Component to add or delete";
              }
            }
          }
        }
      }
      container ports {
        tailf:info
          "Ports";
        list port_list {
          tailf:cli-drop-node-name;
          tailf:cli-suppress-mode;
          tailf:cli-compact-syntax;
          tailf:cli-delete-when-empty;
          key "port";
          leaf port {
            type uint32 {
              tailf:info
                "<port_list>;;Port list";
            }
          }
          container debounce {
            tailf:cli-no-name-on-delete;
            tailf:info
              "Configure debounce time for the amount of time specified in milliseconds.";
            leaf time {
              tailf:cli-no-name-on-delete;
              tailf:cli-no-value-on-delete;
              tailf:info
                "Configure amount of time to delay link down detection.";
              type uint32 {
                tailf:info
                  "<milliseconds>;;Time in milliseconds. Range is 0 (no debouncing) to 5000.";
              }
              default "0";
            }
          }
          leaf description-string {
            tailf:cli-no-value-on-delete;
            tailf:info
              "Description string associated with the port (255 Chars limit)";
            type string {
              tailf:info
                "<string>;;Character string up to 255 characters";
            }
          }
          container rate-limit {
            tailf:info
              "Rate limiting";
            container flood {
              tailf:info
                "Flood rate limiting";
              leaf broadcast {
                extreme-xos:replace-delete-output "unconfigure (.*broadcast) \\d+ :: configure $1 no-limit";
                tailf:info
                  "Broadcast traffic";
                type union {
                  type enumeration {
                    enum "no-limit" {
                      tailf:info
                        "Unlimited rate";
                    }
                  }
                  type uint32 {
                    tailf:info
                      "<pps>;;Packets per second allowed (0-262144)";
                  }
                }
                default "no-limit";
              }
            }
          }
        }
      }
      container dns-client {
        tailf:info
          "DNS Client";
        container add {
          tailf:info
            "Add";
          list name-server {
            ordered-by user;
            tailf:cli-show-long-obu-diffs;
            tailf:cli-diff-create-after "/extreme-xos:create/vr" {
              tailf:xpath-root 3;
              tailf:cli-when-target-create;
            }
            tailf:cli-diff-delete-before "/extreme-xos:create/vr" {
              tailf:xpath-root 3;
              tailf:cli-when-target-delete;
