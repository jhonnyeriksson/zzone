  grouping ncs_rpc_notif_vlanList-grouping {
    leaf-list vlan {
      tailf:cli-list-syntax;
      // NCS drop tailf-common:non-strict-leafref statement
      tailf:cli-diff-set-after "/extreme-xos:create/vlan" {
        tailf:xpath-root 3;
        tailf:cli-when-target-create;
      }
      tailf:cli-diff-delete-before "/extreme-xos:create/vlan" {
