                tailf:xpath-root 3;
                tailf:cli-when-target-create;
              }
              tailf:cli-diff-delete-before "/extreme-xos:create/vr" {
                tailf:xpath-root 3;
                tailf:cli-when-target-delete;
              }
              tailf:info
                "Virtual router ID";
              type string {
                tailf:info
                  "<vr_name>;;Virtual router ID";
              }
              tailf:cli-no-value-on-delete;
              tailf:cli-no-name-on-delete;
            }
            // NCS expand uses statement
            container shared-secret {
              tailf:info
                "shared secret";
              tailf:cli-flatten-container;
              leaf encrypted {
                cli:secret "encrypted <SECRET>" {
                  cli:arguments "always-encrypted";
                }
                extreme-xos:send-secret;
                extreme-xos:quoted-string;
                tailf:info
                  "Password is Encrypted";
                type string {
                  tailf:info
                    "<encrypted_secret>;;encrypted secret string";
                }
                tailf:cli-no-value-on-delete;
                tailf:cli-no-name-on-delete;
              }
              tailf:cli-no-name-on-delete;
            }
