          }
          extreme-xos:replace-delete-output "un(.*) :: $1 hierarchical";
          tailf:cli-no-value-on-delete;
          tailf:info
            "Select a rule model for configuring and ordering policy based rules";
          type enumeration {
            enum "access-list" {
              tailf:info
                "Access-list rule model allows multiple match criteria
