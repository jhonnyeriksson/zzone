          type string;
        }
        container auto-bind {
          // NCS expand uses statement
          leaf-list vlan {
            // NCS patched for predictable order
            ordered-by user;
            // NCS drop tailf-common:cli-diff-set-after statement
            // NCS drop tailf-common:cli-diff-delete-before statement
            type string;
            // NCS drop tailf-common:cli-diff-delete-after statement
          }
        }
      }
      container netlogin {
        list ports {
          // NCS patched for predictable order
          ordered-by user;
          // NCS drop tailf-common:cli-diff-set-after statement
          // NCS drop tailf-common:cli-diff-delete-before statement
          tailf:cli-suppress-mode;
          tailf:cli-range-list-syntax;
          key "id";
          leaf id {
            type string;
          }
          uses ncs_compliance_template_netlogin-authprotocol-grouping;
        }
        container dot1x-max {
          tailf:cli-drop-node-name;
          // NCS expand uses statement
          leaf dot1x {
            type empty;
            // NCS drop tailf-common:cli-diff-set-after statement
            // NCS drop tailf-common:cli-diff-delete-before statement
          }
          leaf mac {
            type empty;
            // NCS drop tailf-common:cli-diff-set-after statement
            // NCS drop tailf-common:cli-diff-delete-before statement
          }
          leaf web-based {
            type empty;
            // NCS drop tailf-common:cli-diff-set-after statement
            // NCS drop tailf-common:cli-diff-delete-before statement
          }
        }
      }
      leaf policy {
        type empty;
      }
      container cdp {
        uses ncs_compliance_template_port-list-grouping;
      }
      container ip-security {
        container dhcp-snooping {
          list vlan {
            // NCS patched for predictable order
            ordered-by user;
            // NCS drop tailf-common:cli-diff-set-after statement
            // NCS drop tailf-common:cli-diff-delete-before statement
            // NCS drop tailf-common:cli-diff-set-after statement
            // NCS drop tailf-common:cli-diff-delete-before statement
            tailf:cli-suppress-mode;
            key "id";
            leaf id {
              type string;
            }
            list ports {
              // NCS patched for predictable order
              ordered-by user;
              // NCS drop tailf-common:cli-diff-set-after statement
              // NCS drop tailf-common:cli-diff-delete-before statement
              // NCS drop tailf-common:cli-diff-set-after statement
              // NCS drop tailf-common:cli-diff-delete-before statement
              // NCS drop tailf-common:cli-diff-delete-before statement
              tailf:cli-suppress-mode;
              tailf:cli-range-list-syntax;
              key "id";
              leaf id {
                type string;
              }
              leaf violation-action {
                type string;
              }
            }
          }
        }
      }
    }
    container disable {
      extreme-xos:no-to-disable;
      leaf telnet {
        type empty;
      }
      list stpd {
        // NCS patched for predictable order
        ordered-by user;
        tailf:cli-suppress-mode;
        key "stpd_name";
        leaf stpd_name {
          type string;
        }
      }
      container snmp {
        container traps {
          container port-up-down {
            leaf-list port {
              // NCS patched for predictable order
              ordered-by user;
              tailf:cli-range-list-syntax;
              type string;
            }
          }
        }
      }
      container dot1p {
        uses ncs_compliance_template_exam-grouping;
      }
      container edp {
        uses ncs_compliance_template_port-list-grouping;
      }
    }
  }

  extension remove-before-change {
    cli:direction "to-device";
    cli:state "post-match";
    cli:java-callback-method "com.tailf.packages.ned.extremexos.ExtremeXosCliExtensions.removeBeforeChange";
  }

  extension redeploy-access-profile-at-acl-modify {
    cli:direction "to-device";
    cli:state "post-match";
    cli:java-callback-method "com.tailf.packages.ned.extremexos.ExtremeXosCliExtensions.redeployAccesProfileAtAclModify";
  }

  extension quoted-string {
    cli:direction "to-device";
    cli:state "post-match";
    cli:java-callback-method "com.tailf.packages.ned.extremexos.ExtremeXosCliExtensions.quotedString";
  }

  extension no-to-disable {
    cli:direction "both";
    cli:state "pre-match|post-match";
    cli:java-callback-method "com.tailf.packages.ned.extremexos.ExtremeXosCliExtensions.noToDisable";
  }

  extension delete-with {
    cli:direction "to-device";
    cli:state "post-match";
    cli:java-callback-method "com.tailf.packages.ned.extremexos.ExtremeXosCliExtensions.deleteWith";
    argument value;
  }

  extension trim-delete-if-match {
    cli:direction "to-device";
    cli:state "post-match";
    cli:java-callback-method "com.tailf.packages.ned.extremexos.ExtremeXosCliExtensions.deleteWith";
    argument value;
  }

  extension replace-delete-output {
    cli:direction "to-device";
    cli:state "post-match";
    cli:java-callback-method "com.tailf.packages.ned.extremexos.ExtremeXosCliExtensions.deleteWith";
    argument value;
  }

  extension send-secret {
    cli:direction "to-device";
    cli:state "post-match";
    cli:java-callback-method "com.tailf.packages.ned.extremexos.ExtremeXosCliExtensions.sendSecret";
  }

  extension multi-line-banner {
    cli:direction "to-device";
    cli:state "post-match";
    cli:java-callback-method "com.tailf.packages.ned.extremexos.ExtremeXosCliExtensions.multiLineBanner";
  }

  extension replace-input {
    cli:direction "from-device";
    cli:state "pre-match";
    cli:java-callback-method "com.tailf.packages.ned.extremexos.ExtremeXosCliExtensions.replaceInput";
  }

  extension accounts-password {
    cli:direction "to-device";
    cli:state "post-match";
    cli:java-callback-method "com.tailf.packages.ned.extremexos.ExtremeXosCliExtensions.accountsPwd";
  }

  extension upm-list-out {
    cli:direction "both";
    cli:state "multi-line";
    cli:java-callback-method "com.tailf.packages.ned.extremexos.ExtremeXosCliExtensions.upmListOut";
  }
}
