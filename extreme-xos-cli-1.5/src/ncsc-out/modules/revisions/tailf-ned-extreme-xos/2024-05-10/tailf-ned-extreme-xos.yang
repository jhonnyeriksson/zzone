  grouping ncs_rpc_notif_netlogin-authprotocol-grouping {
    leaf dot1x {
      tailf:info
        "Configure the 802.1x authentication protocol";
      type empty;
    }
    leaf mac {
      tailf:info
        "Configure the MAC-based authentication protocol";
      type empty;
    }
    leaf web-based {
      tailf:info
        "Configure the web-based authentication protocol";
      type empty;
    }
  }

  grouping ncs_rpc_notif_radius-timeout-grouping {
    leaf timeout {
      extreme-xos:replace-delete-output "unconfigure(.*) :: configure$1 3";
      tailf:cli-no-value-on-delete;
      tailf:info
        "RADIUS server timeout";
      type uint16 {
        tailf:info
          "<seconds>;;RADIUS server timeout seconds. Range is 1 to 240.";
      }
      default "3";
    }
  }

  grouping ncs_rpc_notif_shared-secret-grouping {
    container shared-secret {
      tailf:info
        "shared secret";
      tailf:cli-flatten-container;
      leaf encrypted {
        cli:secret "encrypted <SECRET>" {
          cli:arguments "always-encrypted";
        }
        extreme-xos:send-secret;
        extreme-xos:quoted-string;
        tailf:info
          "Password is Encrypted";
        type string {
          tailf:info
            "<encrypted_secret>;;encrypted secret string";
        }
      }
    }
  }

  grouping ncs_rpc_notif_exam-grouping {
    container examination {
      tailf:info
        "examination";
      container ports {
        tailf:info
          "ports";
        choice ports {
          leaf all {
            tailf:info
              "all";
            type empty;
          }
          leaf-list ports-list {
            tailf:cli-list-syntax;
            tailf:cli-range-list-syntax;
            tailf:cli-drop-node-name;
            type uint32 {
              tailf:info
                "<port_list>;;Port list";
            }
          }
        }
      }
    }
  }

  grouping ncs_rpc_notif_user-grouping {
    leaf user {
      tailf:cli-suppress-no;
      tailf:cli-no-value-on-delete;
      tailf:cli-no-name-on-delete;
      tailf:info
        "User";
      type string {
        tailf:info
          "hex|<user_name>;;Following value is to be specified in hexadecimal
                  User Name (in ASCII)";
      }
    }
  }

  grouping ncs_rpc_notif_sec-level-grouping {
    leaf sec-level {
      tailf:info
        "Security Level";
      type enumeration {
        enum "authnopriv";
        enum "noauth";
        enum "priv";
      }
    }
  }

  grouping ncs_rpc_notif_sec-model-grouping {
    leaf sec-model {
      tailf:info
        "Security Model";
      type enumeration {
        enum "snmpv1";
        enum "snmpv2c";
        enum "usm";
      }
    }
  }

  grouping ncs_rpc_notif_sntpc-grouping {
    leaf host {
      tailf:cli-no-value-on-delete;
      tailf:cli-drop-node-name;
