        tailf:xpath-root 3;
        tailf:cli-when-target-delete;
      }
      tailf:cli-diff-create-after "/extreme-xos:enable/stpd/auto-bind/vlan" {
        tailf:xpath-root 3;
        tailf:cli-when-target-set;
      }
      tailf:cli-diff-create-after "/extreme-xos:enable/stpd/auto-bind/vlan" {
        tailf:xpath-root 3;
        tailf:cli-when-target-modify;
      }
      tailf:cli-diff-delete-before "/extreme-xos:enable/stpd/auto-bind/vlan" {
        tailf:xpath-root 3;
        tailf:cli-when-target-delete;
      }
      tailf:cli-diff-delete-before "/extreme-xos:enable/stpd/auto-bind/vlan" {
        tailf:xpath-root 3;
        tailf:cli-when-target-modify;
      }
      tailf:cli-suppress-mode;
      tailf:cli-delete-when-empty;
      tailf:cli-range-list-syntax;
      key "id";
      leaf id {
        type union {
          type uint32 {
            tailf:info
              "<port_list>;;Port list";
          }
          type enumeration {
            enum "all" {
              tailf:info
                "all";
            }
          }
        }
      }
      leaf enable {
        tailf:cli-prefix-key;
        tailf:info
          "Enable option";
        type empty;
      }
    }
