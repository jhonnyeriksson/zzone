  grouping ncs_rpc_notif_port-list-grouping {
    list ports {
      tailf:cli-diff-set-after "/extreme-xos:create/vlan" {
        tailf:xpath-root 3;
        tailf:cli-when-target-create;
      }
      tailf:cli-diff-delete-before "/extreme-xos:create/vlan" {
        tailf:xpath-root 3;
        tailf:cli-when-target-delete;
      }
      tailf:info
        "Ports";
      tailf:cli-suppress-mode;
      tailf:cli-compact-syntax;
      tailf:cli-range-list-syntax;
      key "id";
      leaf id {
        type union {
          type uint32 {
            tailf:info
              "<port_list>;;Port list";
          }
          type enumeration {
            enum "all" {
              tailf:info
                "all";
            }
          }
        }
      }
    }
  }

  grouping ncs_rpc_notif_ports-enable-grouping {
    list ports {
      extreme-xos:replace-delete-output "un(configure.*)ena(ble.*) :: $1disa$2";
      tailf:cli-drop-node-name;
      tailf:cli-diff-set-after "/extreme-xos:create/vlan" {
        tailf:xpath-root 3;
