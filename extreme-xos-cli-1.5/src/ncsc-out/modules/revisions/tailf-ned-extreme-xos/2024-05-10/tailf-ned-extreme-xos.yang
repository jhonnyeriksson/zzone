              type string {
                tailf:info
                  "<mac>;;MAC address to as to the MAC-list";
              }
            }
            leaf mask {
              type uint8 {
                tailf:info
                  "<mask>;;Number of bits used for the mask";
              }
            }
            leaf ports {
              tailf:info
                "Physical ports";
              tailf:cli-no-value-on-delete;
              tailf:cli-no-name-on-delete;
              type string {
                tailf:info
                  "<portlist>;;List of ports separated by comma";
              }
            }
          }
        }
        container mac {
          tailf:info
            "Configure Network Login settings specific to MAC";
          container authentication {
            tailf:info
              "Configure order of authentication methods to use";
            container database-order {
              tailf:info
                "Configure order of authentication database methods to use";
              tailf:cli-compact-syntax;
              leaf local {
                tailf:cli-no-name-on-delete;
                tailf:info
                  "Local user database authentication method";
                type empty;
              }
              leaf radius {
                tailf:cli-no-name-on-delete;
                tailf:info
                  "Radius Server authentication method";
                type empty;
              }
            }
          }
          list ports {
            tailf:info
              "port list";
            tailf:cli-suppress-mode;
            tailf:cli-delete-when-empty;
            tailf:cli-range-list-syntax;
            key "id";
            leaf id {
              type union {
                type uint32 {
                  tailf:info
                    "<port_list>;;Port list";
                }
                type enumeration {
                  enum "all" {
                    tailf:info
                      "all";
                  }
                }
              }
            }
            container timers {
              tailf:info
                "Configure MAC protocol timers";
              leaf delay {
                extreme-xos:replace-delete-output "un(.*) :: $1 0";
                tailf:cli-no-value-on-delete;
                tailf:info
                  "Delay MAC authentication to wait for 802.1x or web-based authentication to take place";
                type uint8 {
                  tailf:info
                    "<delay>;;MAC authentication delay in seconds (0..120 sec) (default 0 second)";
                }
                default "0";
              }
              container reauth-wrap {
                tailf:cli-drop-node-name;
                tailf:cli-compact-syntax;
                extreme-xos:replace-delete-output "un(.* reauth-period).*(reauthentication).* :: $1 3600 $2 off";
                leaf reauth-period {
                  tailf:info
                    "Configure MAC reauthentication period";
                  type uint32 {
                    tailf:info
                      "<reauth_period>;;Reauth period (30..86400 sec) (Default 3600 sec)";
                  }
                  default "3600";
                }
                leaf reauthentication {
                  tailf:info
                    "Configure MAC reauthentication";
                  type enumeration {
                    enum "off" {
                      tailf:info
                        "MAC reauthentication is disabled (default)";
                    }
                    enum "on" {
                      tailf:info
                        "MAC reauthentication is enabled";
                    }
                  }
                  default "off";
                }
              }
            }
          }
        }
        container dot1x {
          tailf:info
            "Configure Network Login settings specific to 802.1X";
          list ports {
            tailf:info
