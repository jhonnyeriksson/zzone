    "actions" : {
        "ENTER-CONFIG" : {
            "states" : [
               ["PAT-CONFIG-PMT", null, null, "DONE"],

               ["PAT-OPER-PMT", "sendCommand", "CMD-CONFIG", "ENTER-CONFIG"]
            ]
        },
        "EXIT-CONFIG" : {
            "states" : [
