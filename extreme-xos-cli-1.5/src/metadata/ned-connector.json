                ["PAT-ERROR-MSG",       "reportError", null,                    "CONNECT-GATEWAY"],
                ["PAT-PROXY-ERROR-MSG", "reportError", null,                    "CONNECT-GATEWAY"],
                ["PAT-DEVICE-PMT",         null,         null,                    "DONE"]
            ]
        },
        "PROBE" : {
            "init": "CMD-PAGINATE",
            "states" : [
                ["PAT-ERROR-MSG",  "reportError", null, "PROBE"],
                ["PAT-DEVICE-PMT",   null,          null, "PROBE-PLATFORM"]
            ]
        },
        "KEEP-ALIVE" : {
          "init" : "CMD-NEW-LINE",
          "states" : [
                ["PAT-DEVICE-PMT",   null, null, "DONE"]            ]
        },
        "PROBE-PLATFORM" : {
            "init" : "CMD-VERSION",
            "states" : [
                ["PAT-ERROR-MSG",  "reportError", null, "DONE"],
                ["PAT-SERIAL",    "setData", "SERIAL",   "PROBE-PLATFORM"],
                ["PAT-VERSION",  "setData", "VERSION", "PROBE-PLATFORM"],
                ["PAT-DEVICE-PMT", null,      null,      "PROBE-MODEL"]
            ]
        },
        "PROBE-MODEL" : {
            "init" : "CMD-MODEL",
            "states" : [
                ["PAT-ERROR-MSG",  "reportError", null, "DONE"],
                ["PAT-MODEL",    "setData", "MODEL",   "PROBE-MODEL"],
                ["PAT-DEVICE-PMT", null,      null,      "DONE"]
