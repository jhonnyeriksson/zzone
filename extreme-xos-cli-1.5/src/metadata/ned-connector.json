   "actions" : {
        "CONNECT" : {
            "states" : [
                ["PAT-GATEWAY",        null,          null,    "CONNECT-GATEWAY"],
            
                ["PAT-IGNORE-MSG",      null,          null,              "CONNECT"],
                ["PAT-PASSWORD-PMT",    "sendSecret",  "CMD-REMOTE-PASS", "CONNECT"],
                ["PAT-LOGIN-PMT",       "sendCommand", "CMD-REMOTE-NAME", "CONNECT"],
                ["PAT-ERROR-MSG",       "reportError", null,              "CONNECT"],
                ["PAT-PROXY-PMT",       "sendCommand", "CMD-INIT-PROXY",  "CONNECT-PROXY"],
                ["PAT-DEVICE-PMT",        null,          null,              "DONE"]
            ]
        },
        "CONNECT-PROXY" : {
            "states" : [
                ["PAT-IGNORE-MSG",      null,          null,                    "CONNECT-PROXY"],
                ["PAT-PROXY-ACCEPT",    "sendCommand", "CMD-ACCEPT",            "CONNECT-PROXY"],
                ["PAT-PASSWORD-CHANGE", "sendCommand", "CMD-REJECT",            "CONNECT-PROXY"],
                ["PAT-PASSWORD-PMT",    "sendSecret",  "CMD-PROXY-REMOTE-PASS", "CONNECT-PROXY"],
                ["PAT-LOGIN-PMT",       "sendCommand", "CMD-PROXY-REMOTE-NAME", "CONNECT-PROXY"],
