module CFS {

  namespace "http://example.com/CFS";
  prefix CFS;

  import tailf-common {
    prefix tailf;
  }
  import tailf-ncs {
    prefix ncs;
  }

  description
    "Customer-facing service: request loopbacks for a device.";

  revision 2016-01-01 {
    description
      "Initial revision.";
  }

  list CFS {
    description "CFS that triggers an RFS to create loopbacks";

    key name;
    leaf name {
      tailf:info "Unique service id";
      tailf:cli-allow-range;
      type string;
    }

    uses ncs:service-data;
    ncs:servicepoint CFS-servicepoint;

    leaf hostname {
      tailf:info "Device hostname to create loopbacks on";
      mandatory true;
      type leafref {
        path "/ncs:devices/ncs:device/ncs:name";
      }
    }
  }
}
